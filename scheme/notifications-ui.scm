(define-module (notifications-ui)
  #:use-module (ui)
  #:use-module (json)
  #:use-module (services)
  #:use-module (ice-9 match)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-13)
  #:export (make-notifications-ui notifications-message! notifications-nodes notifications-data
            notifications-activate! notifications-input! notifications-disconnected!
            notifications-observation notifications-publish! notification-reader run-notifications-ui))

(define (field value key) (and (list? value) (ui-field value key)))
(define (require value message) (unless value (error message)))
(define (bounded-text? value limit)
  (and (string? value) (<= (bytevector-length (string->utf8 value)) limit)))
(define (uint? value maximum) (and (integer? value) (exact? value) (<= 0 value maximum)))
(define (u64? value) (uint? value 18446744073709551615))
(define (optional? predicate value) (or (eq? value 'null) (predicate value)))
(define (short value length)
  (let ((text (if (string? value) (string-join (string-tokenize value) " ") "Unknown")))
    (if (> (string-length text) length) (string-append (substring text 0 (- length 1)) "…") text)))
(define (now-ms) (let ((now (gettimeofday))) (+ (* 1000 (car now)) (quotient (cdr now) 1000))))
(define (validate-snapshot snapshot)
  (require (and (bounded-text? (field snapshot "epoch") 256) (not (string-null? (field snapshot "epoch")))
                (u64? (field snapshot "revision")) (boolean? (field snapshot "dnd"))
                (boolean? (field snapshot "fullscreen"))) "Invalid notification snapshot identity")
  (let ((manual (field snapshot "fullscreen_manual")) (automatic (field snapshot "fullscreen_automatic"))
        (source (field snapshot "fullscreen_source")) (failure (field snapshot "fullscreen_error")))
    (require (and (boolean? manual) (boolean? automatic)
                  (eq? (field snapshot "fullscreen") (or manual automatic))
                  (member source '("disabled" "available" "unavailable"))
                  (if (equal? source "unavailable")
                      (and automatic (bounded-text? failure 512) (not (string-null? failure)))
                      (eq? failure 'null))
                  (or (not (equal? source "disabled")) (not automatic)))
             "Invalid notification fullscreen state"))
  (for-each
    (lambda (key)
      (let ((records (field snapshot key)))
        (require (and (vector? records) (<= (vector-length records) 100)) "Notification collection exceeds limit")
        (for-each
          (lambda (record)
            (require (and (uint? (field record "id") 4294967295) (> (field record "id") 0)
                          (u64? (field record "revision")) (u64? (field record "created_at_ms"))
                          (uint? (field record "urgency") 2)
                          (optional? (lambda (value) (uint? value 4)) (field record "closed_reason"))) "Invalid notification identity")
            (for-each (lambda (name) (require (bounded-text? (field record name) 4096) "Notification text exceeds limit"))
                      '("app_name" "summary" "app_icon"))
            (require (bounded-text? (field record "body") 16384) "Notification body exceeds limit")
            (for-each (lambda (name) (require (boolean? (field record name)) "Invalid notification flag"))
                      '("resident" "transient" "popup" "actionable"))
            (for-each (lambda (name) (require (optional? (lambda (value) (bounded-text? value 4096)) (field record name))
                                             "Invalid notification optional text")) '("image_path" "desktop_entry" "category"))
            (let ((actions (field record "actions")) (image (field record "image")))
              (require (and (vector? actions) (<= (vector-length actions) 32)) "Notification actions exceed limit")
              (for-each (lambda (action)
                          (require (and (bounded-text? (field action "key") 4096) (bounded-text? (field action "label") 4096))
                                   "Invalid notification action")) (vector->list actions))
              (unless (eq? image 'null)
                (let ((w (field image "width")) (h (field image "height")) (pixels (field image "rgba")))
                  (require (and (uint? w 512) (> w 0) (uint? h 512) (> h 0)
                                (vector? pixels) (<= (vector-length pixels) 1048576)
                                (= (vector-length pixels) (* w h 4))
                                (every (lambda (value) (uint? value 255)) (vector->list pixels))) "Invalid notification image")))))
          (vector->list records)))) '("active" "history"))
  snapshot)

(define-record-type <notifications-ui>
  (%make-model snapshot connected pending serial tab page action-pages status buttons view-version)
  notifications-ui?
  (snapshot snapshot set-snapshot!) (connected connected? set-connected!)
  (pending pending set-pending!) (serial serial set-serial!) (tab tab set-tab!)
  (page page set-page!) (action-pages action-pages set-action-pages!)
  (status status set-status!) (buttons buttons set-buttons!)
  (view-version view-version set-view-version!))
(define (make-notifications-ui) (%make-model #f #f #f 0 "active" 0 '() "Waiting for notification server" '() 0))
(define (notifications-data model) `((sensitive . #t) (service . "notifications") (connected . ,(connected? model))))
(define (notifications-disconnected! model)
  (set-connected! model #f) (set-pending! model #f)
  (set-status! model "Server disconnected; pending action outcome unknown"))
(define (notifications-message! model message)
  (let ((next (field message "snapshot")))
    (when next
      (validate-snapshot next)
      (when (or (not (connected? model))
                (not (equal? (field next "epoch") (field (snapshot model) "epoch")))
                (not (equal? (field next "revision") (field (snapshot model) "revision"))))
        (set-view-version! model (+ 1 (view-version model)))
        (set-buttons! model '()))
      (when (or (not (connected? model))
                (not (equal? (field next "epoch") (field (snapshot model) "epoch"))))
        (set-pending! model #f) (set-status! model "Notification server connected"))
      (when (and (snapshot model) (equal? (field next "epoch") (field (snapshot model) "epoch")))
        (require (>= (field next "revision") (field (snapshot model) "revision")) "Stale notification snapshot"))
      (set-snapshot! model next) (set-connected! model #t))
    (when (and (pending model) (equal? (field message "request_id") (pending model)))
      (set-pending! model #f)
      (set-status! model (if (equal? (field message "status") "ok") "Action completed" "Action rejected; refresh and try again")))))
(define (records model section)
  (let ((value (field (snapshot model) (if (equal? section "history") "history" "active"))))
    (if (vector? value)
        (let ((items (vector->list value))) (if (equal? section "popups") (filter (lambda (item) (field item "popup")) items) items))
        '())))
(define (label key x y w h text size)
  `((key . ,key) (kind . "text") (order . 2) (bounds . ,(vector x y w h))
    (text . ,text) (font_size . ,size) (color . #(0.92 0.94 0.98 1))))
(define (preview-image image)
  (let* ((width (field image "width")) (height (field image "height"))
         (scale (min 1 (/ 64 (max width height))))
         (w (max 1 (inexact->exact (floor (* width scale)))))
         (h (max 1 (inexact->exact (floor (* height scale)))))
         (source (field image "rgba")) (pixels (make-vector (* w h 4))))
    (do ((y 0 (+ y 1))) ((= y h))
      (do ((x 0 (+ x 1))) ((= x w))
        (let ((from (* 4 (+ (* (quotient (* y height) h) width) (quotient (* x width) w))))
              (to (* 4 (+ (* y w) x))))
          (do ((channel 0 (+ channel 1))) ((= channel 4))
            (vector-set! pixels (+ to channel) (vector-ref source (+ from channel)))))))
    `((width . ,w) (height . ,h) (rgba . ,pixels))))

(define (notifications-nodes model)
  (let ((nodes (list '((key . "background") (kind . "rect") (bounds . #(0 0 720 760)) (color . #(0.025 0.035 0.055 1)))))
        (actions '()))
    (define (add node) (set! nodes (append nodes (list node))))
    (define (text key x y w h value size) (add (label key x y w h value size)))
    (define (button logical-key caption x y w action)
      ;; A backend or local view change must cancel any capture of an old command.
      (let ((key (if (eq? (car action) 'command)
                     (format #f "view-~a-~a" (view-version model) logical-key) logical-key)))
      (set! actions (acons key action actions))
      (add `((key . ,key) (kind . "group") (order . 3) (bounds . ,(vector 0 0 w 34)) (offset . ,(vector x y))
             (input . #t) (transitions . ((offset . 80)))
             (states . ((hover . ((offset . ,(vector x (- y 1))))) (pressed . ((offset . ,(vector x (+ y 1)))))))))
      (add `((key . ,(string-append key "-bg")) (parent . ,key) (kind . "rect")
             (bounds . ,(vector 0 0 w 34)) (color . #(0.13 0.23 0.32 1))))
      (add `((key . ,(string-append key "-text")) (parent . ,key) (kind . "text") (order . 1)
             (bounds . ,(vector 7 7 (- w 14) 22)) (text . ,caption) (font_size . 14) (color . #(0.94 0.96 1 1))))))
    (text "title" 24 16 672 34 "Notifications" 27)
    (text "status" 24 52 672 24 (short (status model) 78) 15)
    (when (and (connected? model) (not (pending model)))
      (button "dnd" (if (field (snapshot model) "dnd") "DND on" "DND off") 24 84 150
              (list 'command `((type . "set_dnd") (value . ,(not (field (snapshot model) "dnd"))))))
      (button "fullscreen" (if (field (snapshot model) "fullscreen_manual") "Manual pause on" "Manual pause off") 190 84 180
              (list 'command `((type . "set_fullscreen") (value . ,(not (field (snapshot model) "fullscreen_manual"))))))
      (button "clear-all" "Clear all" 386 84 140 '(command ((type . "clear_all")))))
    (when (snapshot model)
      (let* ((state (snapshot model)) (source (field state "fullscreen_source")))
        (text "fullscreen-state" 24 124 672 22
              (format #f "Fullscreen suppression: ~a · Automatic: ~a~a"
                (if (field state "fullscreen") "On" "Off")
                (if (field state "fullscreen_automatic") "On" "Off")
                (if (equal? source "unavailable") " (safe fallback)" "")) 14)
        (text "fullscreen-source" 24 148 672 22
              (cond ((equal? source "available") "Hyprland connected · manual pause cannot disable automatic suppression")
                    ((equal? source "disabled") "Automatic fullscreen detection disabled · manual pause remains available")
                    (else "Hyprland unavailable · safe suppression enabled until recovery")) 14)))
    (for-each (lambda (section index)
                (button section (format #f "~a (~a)" (string-titlecase section) (length (records model section)))
                        (+ 24 (* 224 index)) 180 208 (list 'tab section))) '("popups" "active" "history") (iota 3))
    (let* ((items (records model (tab model))) (pages (max 1 (ceiling (/ (length items) 3))))
           (page (min (page model) (- pages 1))) (start (* page 3))
           (visible (take (drop items start) (min 3 (- (length items) start)))))
      (when (null? items) (text "empty" 24 240 672 40 (string-append "No " (if (equal? (tab model) "popups") "popup" (tab model)) " notifications") 21))
      (for-each
        (lambda (item index)
          (let* ((y (+ 226 (* 148 index))) (id (field item "id")) (prefix (number->string id))
                 (available-actions (if (and (connected? model) (field item "actionable") (not (equal? (tab model) "history")))
                                        (vector->list (field item "actions")) '()))
                 (action-start (if (null? available-actions) 0 (* 2 (modulo (or (assv-ref (action-pages model) id) 0) (ceiling (/ (length available-actions) 2)))))))
            (text (string-append prefix "-title") 24 y 672 25
                  (short (string-append (field item "app_name") ": " (field item "summary")) 73) 18)
            (text (string-append prefix "-body") 24 (+ y 30) (if (list? (field item "image")) 590 672) 48 (short (field item "body") 150) 16)
            (when (list? (field item "image"))
              (let ((image (preview-image (field item "image"))))
                (add `((key . ,(string-append prefix "-image")) (kind . "image") (order . 2)
                       (bounds . ,(vector 632 (+ y 28) (field image "width") (field image "height"))) (image . ,image)))))
            (text (string-append prefix "-meta") 24 (+ y 82) 672 22
                  (string-append (if (equal? (tab model) "history") "History; actions disabled"
                                     (if (field item "popup") "Popup visible" "Active; popup hidden"))
                                 (if (field item "transient") "; transient (not mirrored)" "")
                                 (let ((image (field item "image")))
                                   (if (list? image) (format #f "; image ~a×~a" (field image "width") (field image "height")) ""))) 13)
            (unless (or (pending model) (not (connected? model)))
              (for-each
                (lambda (action number)
                  (button (format #f "~a-action-~a" prefix number) (short (field action "label") 17)
                          (+ 24 (* 156 number)) (+ y 110) 144
                          (list 'command `((type . "invoke") (id . ,id) (key . ,(field action "key"))))))
                (take (drop available-actions action-start) (min 2 (- (length available-actions) action-start))) '(0 1))
              (when (> (length available-actions) 2)
                (button (string-append prefix "-more") "Actions >" 336 (+ y 110) 104 (list 'actions id)))
              (unless (equal? (tab model) "history")
                (button (string-append prefix "-dismiss") "Dismiss" 452 (+ y 110) 104 (list 'command `((type . "dismiss") (id . ,id)))))
              (button (string-append prefix "-group") "Clear group" 568 (+ y 110) 128
                      (list 'command `((type . "clear_group") (app_name . ,(field item "app_name")))))))) visible (iota (length visible)))
      (text "page" 24 686 672 24
            (format #f "~a · ~a–~a of ~a; ~a more" (string-titlecase (tab model)) (if (null? items) 0 (+ start 1))
                    (+ start (length visible)) (length items) (- (length items) (length visible))) 15)
      (when (> pages 1)
        (button "previous" "Previous" 24 718 140 '(previous))
        (button "next" "Next" 180 718 140 '(next))))
    (set-buttons! model actions) (list->vector nodes)))
(define (notifications-activate! model key send)
  (when (memq (car (or (assoc-ref (buttons model) key) '(unknown))) '(tab previous next actions))
    (set-view-version! model (+ 1 (view-version model))))
  (match (assoc-ref (buttons model) key)
    (('command command)
     (when (and (connected? model) (not (pending model)))
       (set-serial! model (+ 1 (serial model))) (set-pending! model (serial model))
       (send `((request_id . ,(serial model)) (epoch . ,(field (snapshot model) "epoch"))
               (revision . ,(field (snapshot model) "revision")) (command . ,command)))
       (set-status! model "Action pending")))
    (('tab name) (set-tab! model name) (set-page! model 0))
    (('previous) (set-page! model (max 0 (- (page model) 1))))
    (('next) (set-page! model (+ 1 (page model))))
    (('actions id) (set-action-pages! model (acons id (+ 1 (or (assv-ref (action-pages model) id) 0)) (alist-delete id (action-pages model)))))
    (_ #f)))
(define (notifications-input! model message epoch applied sequence send)
  (when (and (equal? (field message "type") "input") (equal? (field message "channel") "notifications")
             (equal? (field message "event") "activate") (equal? (field message "epoch") epoch)
             (equal? (field message "seq") applied) (= applied sequence))
    (notifications-activate! model (field message "key") send)))

(define (image-description record)
  (let ((image (field record "image")))
    `((kind . ,(cond ((list? image) "rgba") ((string? (field record "image_path")) "path")
                     ((not (string-null? (field record "app_icon"))) "icon") (else "none")))
      (width . ,(if (list? image) (field image "width") 'null))
      (height . ,(if (list? image) (field image "height") 'null)))))
(define (notification-preview record)
  `((id . ,(field record "id")) (revision . ,(field record "revision"))
    (app_name . ,(short (field record "app_name") 64))
    (summary . ,(short (field record "summary") 128)) (body . ,(short (field record "body") 256))
    (text_truncated . ,(or (> (string-length (field record "app_name")) 64)
                           (> (string-length (field record "summary")) 128) (> (string-length (field record "body")) 256)))
    (urgency . ,(field record "urgency")) (resident . ,(field record "resident"))
    (popup . ,(field record "popup")) (actionable . ,(field record "actionable"))
    (created_at_ms . ,(field record "created_at_ms")) (closed_reason . ,(field record "closed_reason"))
    (action_count . ,(vector-length (field record "actions"))) (image . ,(image-description record))))
(define (notifications-observation snapshot timestamp)
  (validate-snapshot snapshot)
  (let* ((active (vector->list (field snapshot "active"))) (history (vector->list (field snapshot "history")))
         (keep (lambda (record) (not (field record "transient"))))
         (durable-active (filter keep active)) (durable-history (filter keep history))
         (shown-active (take durable-active (min 32 (length durable-active))))
         (shown-history (take durable-history (min (- 32 (length shown-active)) (length durable-history)))))
    `((version . 1) (service . "notifications") (status . "available") (observed_at_ms . ,timestamp) (error . null)
      (state . ((epoch . ,(field snapshot "epoch")) (revision . ,(field snapshot "revision"))
                (dnd . ,(field snapshot "dnd")) (fullscreen . ,(field snapshot "fullscreen"))
                (fullscreen_manual . ,(field snapshot "fullscreen_manual"))
                (fullscreen_automatic . ,(field snapshot "fullscreen_automatic"))
                (fullscreen_source . ,(field snapshot "fullscreen_source"))
                (fullscreen_error . ,(if (equal? (field snapshot "fullscreen_source") "unavailable")
                                         "Fullscreen source unavailable; safe suppression enabled" 'null))
                (active . ,(list->vector (map notification-preview shown-active)))
                (history . ,(list->vector (map notification-preview shown-history)))
                (withheld_transient_count . ,(- (+ (length active) (length history)) (+ (length durable-active) (length durable-history))))
                (dropped_count . ,(- (+ (length durable-active) (length durable-history)) (+ (length shown-active) (length shown-history)))))))))
(define* (notifications-publish! observation #:key command)
  (let ((envelope (json-string->scm (scm->json-string observation))))
    (if command (hearth-service-publish! envelope #:command command)
        (hearth-service-publish! envelope))))

(define (notification-reader socket)
  (let ((pending (make-bytevector 0)) (limit (+ (* 4 1024 1024) 1024)))
    (lambda ()
      (let read-next ()
        (let ((newline (let loop ((i 0))
                         (and (< i (bytevector-length pending))
                              (if (= (bytevector-u8-ref pending i) 10) i (loop (+ i 1)))))))
          (cond
            (newline
             (require (<= newline limit) "Notification frame exceeds 4 MiB")
             (let ((line (make-bytevector newline)) (rest (make-bytevector (- (bytevector-length pending) newline 1))))
               (bytevector-copy! pending 0 line 0 newline)
               (bytevector-copy! pending (+ newline 1) rest 0 (bytevector-length rest)) (set! pending rest)
               (let ((text (utf8->string line)))
                 (require (equal? line (string->utf8 text)) "Invalid notification UTF-8")
                 (call-with-input-string text
                   (lambda (port)
                     (let ((value (json->scm port)))
                       (require (eof-object? (read-char port)) "Trailing notification JSON") value))))))
            ((null? (car (select (list socket) '() '() 0))) #f)
            (else
             (let* ((bytes (make-bytevector 8192)) (count (recv! socket bytes)))
               (require (> count 0) "Notification server disconnected")
               (require (<= (+ count (bytevector-length pending)) (+ limit 8192)) "Notification frame exceeds 4 MiB")
               (let ((next (make-bytevector (+ count (bytevector-length pending)))))
                 (bytevector-copy! pending 0 next 0 (bytevector-length pending))
                 (bytevector-copy! bytes 0 next (bytevector-length pending) count) (set! pending next)))
             (read-next))))))))
(define (open-control path)
  (let ((socket (socket AF_UNIX SOCK_STREAM 0)))
    (catch #t
      (lambda ()
        (fcntl socket F_SETFL (logior O_NONBLOCK (fcntl socket F_GETFL)))
        (connect socket AF_UNIX path)
        (ui-write-json! socket '((request_id . 0) (command . ((type . "subscribe"))))) socket)
      (lambda (key . arguments) (close-port socket) (apply throw key arguments)))))

(define (run-publisher path)
  (let ((socket #f) (read-message #f) (last-observed 'null))
    (define (unavailable reason)
      (catch #t
        (lambda () (notifications-publish!
                     `((version . 1) (service . "notifications") (status . "unavailable")
                       (observed_at_ms . ,(now-ms)) (state . null) (error . ,reason))))
        (lambda _ (display "Notification observation publication failed\n" (current-error-port)))))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (catch #t
            (lambda ()
              (unless socket (set! socket (open-control path)) (set! read-message (notification-reader socket)))
              (let drain ()
                (let ((message (read-message)))
                  (when message
                    (when (field message "snapshot")
                      (let ((observation (notifications-observation (field message "snapshot") (now-ms))))
                        (set! last-observed observation)
                        (notifications-publish! observation)))
                    (drain))))
              (when (and (null? (car (select (list socket) '() '() 5))) (list? last-observed))
                (notifications-publish! last-observed)))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (when socket (close-port socket)) (set! socket #f) (set! last-observed 'null)
              (unavailable "Notification server unavailable") (select '() '() '() 1)))
          (loop)))
      (lambda () (when socket (close-port socket)) (unavailable "Notification publisher stopped")))))

(define (run-notifications-ui renderer path)
  (let ((model (make-notifications-ui)) (control #f) (read-message #f) (connection #f) (keys '()) (dirty? #t))
    (define (send value) (require control "Notification server disconnected") (ui-write-json! control value))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (catch #t
            (lambda ()
              (unless control (set! control (open-control path)) (set! read-message (notification-reader control)))
              (let drain ()
                (let ((message (read-message)))
                  (when message (notifications-message! model message) (set! dirty? #t) (drain)))))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (when control (close-port control)) (set! control #f)
              (notifications-disconnected! model) (set! dirty? #t)))
          (catch #t
            (lambda ()
              (unless connection
                (let ((nodes (notifications-nodes model)))
                  (set! keys (map (lambda (node) (field node "key")) (vector->list nodes)))
                  (set! connection (make-ui-client renderer "notifications" nodes (notifications-data model)))
                  (ui-connect! connection) (set! dirty? #f)))
              (let drain ()
                (let ((message (ui-receive connection #:timeout 0)))
                  (when message
                    (when (and (equal? (field message "type") "ack") (equal? (field message "status") "rejected"))
                      (error "Renderer rejected notification scene"))
                    (when (and (not dirty?) (equal? (field message "type") "input") (equal? (field message "event") "activate"))
                      (notifications-input! model message (ui-epoch connection) (ui-applied-seq connection) (ui-seq connection) send)
                      (set! dirty? #t))
                    (drain))))
              (when (and dirty? (= (ui-applied-seq connection) (ui-seq connection)))
                (let* ((nodes (notifications-nodes model)) (next (map (lambda (node) (field node "key")) (vector->list nodes))))
                  (ui-patch! connection nodes (list->vector (lset-difference equal? keys next)) #:data (notifications-data model))
                  (set! keys next) (set! dirty? #f))))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (when connection (ui-close! connection)) (set! connection #f)
              (when control (close-port control)) (set! control #f)
              (notifications-disconnected! model) (set! dirty? #t)))
          (select (append (if control (list control) '()) (if (and connection (ui-port connection)) (list (ui-port connection)) '()))
                  '() '() (if (and control connection) 30 1))
          (loop)))
      (lambda () (when control (close-port control)) (when connection (ui-close! connection))))))

(when (string-suffix? "scheme/notifications-ui.scm" (car (command-line)))
  (sigaction SIGPIPE SIG_IGN)
  (sigaction SIGTERM (lambda (_) (throw 'quit 0)))
  (sigaction SIGINT (lambda (_) (throw 'quit 0)))
  (match (cdr (command-line))
    (("--publish" control) (run-publisher control))
    ((renderer control) (run-notifications-ui renderer control))
    (_ (display "Usage: guile -L scheme scheme/notifications-ui.scm RENDERER CONTROL | --publish CONTROL\n" (current-error-port)) (exit 2))))
