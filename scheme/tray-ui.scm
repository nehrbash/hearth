(define-module (tray-ui)
  #:use-module (ui)
  #:use-module (services)
  #:use-module (bluetooth-ui)
  #:use-module (json)
  #:use-module (rnrs bytevectors)
  #:use-module (ice-9 match)
  #:use-module (ice-9 popen)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-13)
  #:export (make-tray-ui tray-message! tray-nodes tray-data tray-activate! tray-input!
            tray-disconnected! tray-observation tray-publish! run-tray-ui))

(define (field value key) (and (list? value) (ui-field value key)))
(define (require value message) (unless value (error message)))
(define (short value count)
  (let ((text (if (string? value) (string-join (string-tokenize value) " ") "Unknown")))
    (if (> (string-length text) count) (string-append (substring text 0 (- count 1)) "…") text)))
(define (uint? value maximum) (and (integer? value) (exact? value) (<= 0 value maximum)))
(define (signed? value) (and (integer? value) (exact? value) (<= -2147483648 value 2147483647)))
(define (text? value) (and (string? value) (<= (bytevector-length (string->utf8 value)) 4096)))
(define (optional? predicate value) (or (eq? value 'null) (predicate value)))
(define (identity item) (map (lambda (key) (field item key)) '("service" "owner" "path")))
(define (validate-menu menu)
  (require (and (text? (field menu "path")) (uint? (field menu "revision") 4294967295)
                (uint? (field menu "epoch") 18446744073709551615) (vector? (field menu "nodes"))
                (<= (vector-length (field menu "nodes")) 256)) "Invalid tray menu")
  (let* ((nodes (vector->list (field menu "nodes"))) (ids (map (lambda (node) (field node "id")) nodes)))
    (require (= (length ids) (length (delete-duplicates ids))) "Duplicate tray menu IDs")
    (for-each
      (lambda (node)
        (require (and (signed? (field node "id")) (optional? signed? (field node "parent"))
                      (text? (field node "label")) (signed? (field node "toggle_state"))
                      (optional? (lambda (value) (member value '("checkmark" "radio"))) (field node "toggle_type"))
                      (optional? (lambda (value) (equal? value "submenu")) (field node "children_display"))
                      (optional? text? (field node "icon_name"))) "Invalid tray menu node")
        (let ((icon (or (field node "icon") 'null))) (unless (eq? icon 'null) (validate-icon icon)))
        (for-each (lambda (key) (require (boolean? (field node key)) "Invalid menu flag")) '("enabled" "visible" "separator"))
        (let walk ((parent (field node "parent")) (depth 0))
          (unless (eq? parent 'null)
            (require (< depth 8) "Tray menu cycle or depth exceeds limit")
            (let ((ancestor (find (lambda (entry) (equal? (field entry "id") parent)) nodes)))
              (require ancestor "Missing tray menu parent")
              (walk (field ancestor "parent") (+ depth 1)))))) nodes)))
(define (validate-icon image)
  (require (and (uint? (field image "width") 64) (> (field image "width") 0)
                (uint? (field image "height") 64) (> (field image "height") 0)
                (vector? (field image "rgba"))
                (= (vector-length (field image "rgba")) (* 4 (field image "width") (field image "height")))
                (every (lambda (value) (uint? value 255)) (vector->list (field image "rgba")))) "Invalid tray RGBA icon"))
(define (validate-state state)
  (require (and (text? (field state "session")) (text? (field state "watcher_owner"))
                (boolean? (field state "owns_watcher")) (vector? (field state "items"))
                (<= (vector-length (field state "items")) 64)) "Invalid tray state")
  (for-each
    (lambda (item)
      (for-each (lambda (key) (require (text? (field item key)) "Invalid tray item text"))
                '("service" "owner" "path" "id" "title" "category"))
      (require (and (member (field item "status") '("Passive" "Active" "NeedsAttention"))
                    (boolean? (field item "item_is_menu")) (optional? text? (field item "icon_name"))
                    (optional? text? (field item "error")) (optional? text? (field item "menu_error")) (optional? text? (or (field item "icon_error") 'null))
                    (optional? text? (field item "attention_icon_name")) (optional? text? (field item "overlay_icon_name"))) "Invalid tray item status")
      (for-each (lambda (key) (let ((icon (field item key))) (unless (eq? icon 'null) (validate-icon icon))))
                '("icon" "attention_icon" "overlay_icon"))
      (let ((tooltip (field item "tooltip")))
        (unless (eq? tooltip 'null)
          (require (and (text? (field tooltip "title")) (text? (field tooltip "description"))) "Invalid tray tooltip")))
      (unless (eq? (field item "menu") 'null) (validate-menu (field item "menu"))))
    (vector->list (field state "items")))
  state)

(define-record-type <tray-ui>
  (%make-ui envelope pending serial view page selected parent menu-page status buttons menu-wait)
  tray-ui?
  (envelope envelope set-envelope!) (pending pending set-pending!) (serial serial set-serial!)
  (view view set-view!) (page page set-page!) (selected selected set-selected!)
  (parent parent set-parent!) (menu-page menu-page set-menu-page!)
  (status status set-status!) (buttons buttons set-buttons!) (menu-wait menu-wait? set-menu-wait!))
(define (make-tray-ui) (%make-ui #f #f 0 0 0 #f #f 0 "Waiting for status notifier host" '() #f))
(define (items model)
  (let ((items (field (field (envelope model) "state") "items"))) (if (vector? items) (vector->list items) '())))
(define (selected-item model) (find (lambda (item) (equal? (identity item) (selected model))) (items model)))
(define (tray-data model) `((sensitive . #t) (service . "tray") (status . ,(or (field (envelope model) "status") "unavailable"))))
(define (tray-disconnected! model)
  (set-envelope! model #f) (set-pending! model #f) (set-buttons! model '()) (set-selected! model #f)
  (set-view! model (+ 1 (view model))) (set-status! model "Disconnected; action outcome may be unknown"))
(define (tray-message! model message)
  (cond
    ((equal? (field message "service") "tray")
     (require (and (equal? (field message "version") 1) (uint? (field message "observed_at_ms") 18446744073709551615)) "Invalid tray envelope")
     (if (equal? (field message "status") "available") (validate-state (field message "state"))
         (require (and (equal? (field message "status") "unavailable") (eq? (field message "state") 'null)
                       (text? (field message "error"))) "Invalid tray failure"))
     (unless (equal? (field (envelope model) "state") (field message "state"))
       (set-view! model (+ 1 (view model))) (set-buttons! model '()))
     (unless (equal? (field (field (envelope model) "state") "session") (field (field message "state") "session"))
       (set-pending! model #f) (set-selected! model #f))
     (when (or (not (envelope model)) (equal? (field message "status") "unavailable")
               (equal? (field (envelope model) "status") "unavailable"))
       (set-status! model (if (equal? (field message "status") "available") "Status notifier host connected"
                              (string-append "Tray unavailable: " (short (field message "error") 50)))))
     (when (eq? (pending model) 'snapshot) (set-pending! model #f) (set-menu-wait! model #f))
     (set-envelope! model message)
     (when (and (selected model) (not (selected-item model))) (set-selected! model #f)))
    ((equal? (field message "type") "result")
     (when (equal? (field message "request_id") (pending model))
       (set-pending! model (and (menu-wait? model) (equal? (field message "status") "applied") 'snapshot))
       (unless (pending model) (set-menu-wait! model #f))
       (set-status! model (cond ((equal? (field message "status") "applied") "Action completed")
                                ((equal? (field message "status") "unknown") "Outcome unknown; inspect the application")
                                (else "Action rejected; refresh before retrying")))))
    (else (error "Unexpected tray worker message"))))
(define (menu-root menu)
  (find (lambda (node) (eq? (field node "parent") 'null)) (vector->list (field menu "nodes"))))
(define (menu-prefix node)
  (let ((type (field node "toggle_type")) (state (field node "toggle_state")))
    (cond ((equal? type "radio") (if (= state 1) "● " "○ "))
          ((equal? type "checkmark") (cond ((= state 1) "[x] ") ((= state -1) "[-] ") (else "[ ] ")))
          (else ""))))
(define (tray-status item)
  (if (equal? (field item "status") "NeedsAttention") "Needs attention" (field item "status")))
(define (tray-category item)
  (let ((value (field item "category")))
    (cond ((equal? value "ApplicationStatus") "Application") ((equal? value "Communications") "Communications")
          ((equal? value "SystemServices") "System service") ((equal? value "Hardware") "Hardware") (else (short value 32)))))

(define (tray-nodes model)
  (let ((nodes (list '((key . "background") (kind . "rect") (bounds . #(0 0 720 760)) (color . #(0.025 0.035 0.055 1))))) (actions '()))
    (define (add node) (set! nodes (append nodes (list node))))
    (define (text key x y w h value size)
      (add `((key . ,key) (kind . "text") (order . 2) (bounds . ,(vector x y w h)) (text . ,value)
             (font_size . ,size) (color . #(0.92 0.94 0.98 1)))))
    (define* (button name caption x y w action #:optional (icon #f))
      (let ((key (if (memq (car action) '(action open submenu close)) (format #f "view-~a-~a" (view model) name) name)))
        (set! actions (acons key action actions))
        (add `((key . ,key) (kind . "group") (order . 3) (bounds . ,(vector 0 0 w 36)) (offset . ,(vector x y))
               (input . #t) (transitions . ((offset . 80)))
               (states . ((hover . ((offset . ,(vector x (- y 1))))) (pressed . ((offset . ,(vector x (+ y 1)))))))))
        (add `((key . ,(string-append key "-bg")) (parent . ,key) (kind . "rect")
               (bounds . ,(vector 0 0 w 36)) (color . #(0.13 0.23 0.32 1))))
        (add `((key . ,(string-append key "-text")) (parent . ,key) (kind . "text") (order . 1)
               (bounds . ,(vector (if icon 40 8) 7 (- w (if icon 48 16)) 24)) (text . ,caption) (font_size . 14) (color . #(0.94 0.96 1 1))))
        (when icon
          (add `((key . ,(string-append key "-icon")) (parent . ,key) (kind . "image") (order . 2)
                 (bounds . #(6 6 24 24)) (image . ,icon))))))
    (text "title" 24 20 672 36 "System tray" 28)
    (text "status" 24 64 672 28 (short (status model) 78) 16)
    (if (selected-item model)
        (let* ((item (selected-item model)) (menu (field item "menu"))
               (all (if (list? menu) (vector->list (field menu "nodes")) '()))
               (parent (and menu (or (find (lambda (node) (equal? (field node "id") (parent model))) all) (and (pair? all) (menu-root menu)))))
               (children (if parent (filter (lambda (node) (and (field node "visible") (equal? (field node "parent") (field parent "id")))) all) '()))
               (page (min (menu-page model) (- (max 1 (ceiling (/ (length children) 8))) 1)))
               (start (* page 8)) (visible (take (drop children start) (min 8 (- (length children) start)))))
          (text "menu-title" 24 108 672 34 (short (field item "title") 65) 22)
          (button "close-menu" "Close menu" 24 152 160 '(close))
          (when (and parent (not (eq? (field parent "parent") 'null)))
            (button "menu-back" "Parent menu" 200 152 170 (list 'submenu item (field parent "parent"))))
          (when (null? children) (text "menu-empty" 24 220 672 30 "No visible menu entries" 19))
          (for-each
            (lambda (node index)
              (let ((y (+ 212 (* index 54))) (name (format #f "menu-~a" (field node "id")))
                    (icon (and (list? (field node "icon")) (field node "icon"))))
                (cond ((field node "separator") (add `((key . ,name) (kind . "rect") (bounds . ,(vector 24 (+ y 16) 672 1)) (color . #(0.25 0.3 0.4 1)))))
                      ((not (field node "enabled"))
                       (text name (if icon 64 32) y (if icon 618 650) 36 (string-append (menu-prefix node) (short (field node "label") 65) " (disabled)") 17)
                       (when icon (add `((key . ,(string-append name "-icon")) (kind . "image") (bounds . ,(vector 30 (+ y 6) 24 24)) (image . ,icon)))))
                      ((and (not (pending model)) (not (string? (field item "error"))))
                       (button name (string-append (menu-prefix node) (short (field node "label") 65)
                                                  (if (equal? (field node "children_display") "submenu") " >" ""))
                               24 y 672 (if (equal? (field node "children_display") "submenu")
                                           (list 'submenu item (field node "id"))
                                           (list 'action item `((action . "menu_event") (epoch . ,(field menu "epoch"))
                                                               (revision . ,(field menu "revision")) (id . ,(field node "id"))
                                                               (event . "clicked") (timestamp . 0)))) icon))
                      (else (text name 32 y 650 36 (short (field node "label") 65) 17))))) visible (iota (length visible)))
          (text "menu-page" 24 660 672 24 (format #f "~a–~a of ~a; ~a more" (if (null? children) 0 (+ start 1)) (+ start (length visible))
                                                (length children) (- (length children) (length visible))) 15)
          (when (> (length children) 8)
            (button "menu-previous" "Previous" 24 706 140 '(menu-previous))
            (button "menu-next" "Next" 180 706 140 '(menu-next))))
        (let* ((all (items model)) (page (min (page model) (- (max 1 (ceiling (/ (length all) 3))) 1)))
               (start (* page 3)) (visible (take (drop all start) (min 3 (- (length all) start)))))
          (when (null? all) (text "empty" 24 150 672 45 "No tray items observed" 22))
          (for-each
            (lambda (item index)
              (let* ((y (+ 128 (* index 174))) (prefix (number->string (+ start index)))
                     (icon (if (and (equal? (field item "status") "NeedsAttention") (list? (field item "attention_icon")))
                               (field item "attention_icon") (field item "icon"))))
                (when (list? icon) (add `((key . ,(string-append prefix "-icon")) (kind . "image") (order . 1)
                                         (bounds . ,(vector 24 y (field icon "width") (field icon "height"))) (image . ,icon))))
                (when (list? (field item "overlay_icon"))
                  (add `((key . ,(string-append prefix "-overlay")) (kind . "image") (order . 2)
                         (bounds . ,(vector 56 (+ y 32) 32 32)) (image . ,(field item "overlay_icon")))))
                (text (string-append prefix "-title") 108 y 588 28 (short (field item "title") 60) 21)
                (text (string-append prefix "-status") 108 (+ y 32) 588 24
                      (string-append (tray-status item) " · " (tray-category item)
                                     (if (list? icon) "" " · icon unavailable")) 15)
                (text (string-append prefix "-details") 24 (+ y 76) 672 27
                      (cond ((string? (field item "error")) (short (field item "error") 75))
                            ((string? (field item "icon_error")) (string-append (if (list? icon) "Icon note: " "Icon unavailable: ") (short (field item "icon_error") 50)))
                            ((list? (field item "tooltip"))
                             (short (string-append (field (field item "tooltip") "title") ": " (field (field item "tooltip") "description")) 75))
                            ((string? (field item "menu_error")) (string-append "Menu unavailable: " (short (field item "menu_error") 50)))
                            (else (short (field item "id") 75))) 15)
                (unless (or (pending model) (string? (field item "error")))
                  (for-each
                    (lambda (spec number)
                      (button (string-append prefix "-" (car spec)) (cadr spec) (+ 24 (* 112 number)) (+ y 112) 104
                              (if (and (equal? (car spec) "primary") (field item "item_is_menu"))
                                  (if (list? (field item "menu")) (list 'open item)
                                      (list 'action item '((action . "context_menu") (x . 0) (y . 0))))
                                  (list 'action item `((action . ,(caddr spec)) (x . 0) (y . 0))))))
                    '(("primary" "Primary" "activate") ("secondary" "Secondary" "secondary_activate") ("context" "Context" "context_menu")) '(0 1 2))
                  (when (list? (field item "menu")) (button (string-append prefix "-menu") "Menu" 360 (+ y 112) 104 (list 'open item)))
                  (button (string-append prefix "-up") "Scroll +" 472 (+ y 112) 104 (list 'action item '((action . "scroll") (delta . 120) (orientation . "vertical"))))
                  (button (string-append prefix "-down") "Scroll −" 584 (+ y 112) 112 (list 'action item '((action . "scroll") (delta . -120) (orientation . "vertical"))))))) visible (iota (length visible)))
          (text "page" 24 674 672 26 (format #f "~a–~a of ~a; ~a more" (if (null? all) 0 (+ start 1)) (+ start (length visible)) (length all) (- (length all) (length visible))) 16)
          (when (> (length all) 3)
            (button "previous" "Previous" 24 710 140 '(previous))
            (button "next" "Next" 180 710 140 '(next)))))
    (set-buttons! model actions) (list->vector nodes)))

(define (dispatch! model item action send)
  (unless (or (pending model) (string? (field item "error")))
    (set-menu-wait! model (equal? (field action "action") "menu_about_to_show"))
    (set-serial! model (+ 1 (serial model))) (set-pending! model (number->string (serial model)))
    (send `((type . "action") (request_id . ,(pending model))
            (request . ((session . ,(field (field (envelope model) "state") "session"))
                        (service . ,(field item "service")) (owner . ,(field item "owner")) (path . ,(field item "path"))
                        (action . ,action)))))
    (set-status! model "Waiting for application")))
(define (show-menu! model item id send)
  (let ((menu (field item "menu")))
    (when (and (list? menu) (not (pending model)))
      (set-selected! model (identity item)) (set-parent! model id) (set-menu-page! model 0)
      (set-view! model (+ 1 (view model)))
      (dispatch! model item `((action . "menu_about_to_show") (epoch . ,(field menu "epoch"))
                             (revision . ,(field menu "revision")) (id . ,id)) send))))
(define (tray-activate! model key send)
  (match (assoc-ref (buttons model) key)
    (('action item action) (dispatch! model item action send))
    (('open item) (let ((root (menu-root (field item "menu"))))
                   (when root (show-menu! model item (field root "id") send))))
    (('submenu item id) (show-menu! model item id send))
    (('close)
     (let* ((item (selected-item model)) (menu (field item "menu")))
       (when (and item (list? menu) (integer? (parent model)) (not (pending model)))
         (dispatch! model item `((action . "menu_event") (epoch . ,(field menu "epoch")) (revision . ,(field menu "revision"))
                                (id . ,(parent model)) (event . "closed") (timestamp . 0)) send)))
     (set-selected! model #f) (set-view! model (+ 1 (view model))))
    (('previous) (set-page! model (max 0 (- (page model) 1))) (set-view! model (+ 1 (view model))))
    (('next) (set-page! model (+ 1 (page model))) (set-view! model (+ 1 (view model))))
    (('menu-previous) (set-menu-page! model (max 0 (- (menu-page model) 1))) (set-view! model (+ 1 (view model))))
    (('menu-next) (set-menu-page! model (+ 1 (menu-page model))) (set-view! model (+ 1 (view model))))
    (_ #f)))
(define (tray-input! model message epoch applied sequence send)
  (when (and (equal? (field message "type") "input") (equal? (field message "channel") "tray")
             (equal? (field message "event") "activate") (equal? (field message "epoch") epoch)
             (equal? (field message "seq") applied) (= applied sequence))
    (tray-activate! model (field message "key") send)))
(define (icon-metadata image)
  (if (list? image) `((kind . "rgba") (width . ,(field image "width")) (height . ,(field image "height")))
      '((kind . "none") (width . null) (height . null))))
(define (item-preview item)
  `((service . ,(field item "service")) (owner . ,(field item "owner")) (path . ,(field item "path"))
    (id . ,(short (field item "id") 64)) (title . ,(short (field item "title") 128))
    (status . ,(field item "status")) (category . ,(short (field item "category") 64))
    (item_is_menu . ,(field item "item_is_menu"))
    (tooltip . ,(if (list? (field item "tooltip"))
                    `((title . ,(short (field (field item "tooltip") "title") 64))
                      (description . ,(short (field (field item "tooltip") "description") 256))) 'null))
    (icon . ,(icon-metadata (field item "icon"))) (attention_icon . ,(icon-metadata (field item "attention_icon")))
    (overlay_icon . ,(icon-metadata (field item "overlay_icon")))
    (menu . ,(if (list? (field item "menu"))
                 `((path . ,(field (field item "menu") "path")) (revision . ,(field (field item "menu") "revision"))
                   (epoch . ,(field (field item "menu") "epoch")) (node_count . ,(vector-length (field (field item "menu") "nodes")))
                   (icon_count . ,(count (lambda (node) (list? (field node "icon"))) (vector->list (field (field item "menu") "nodes"))))) 'null))
    (error . ,(if (string? (field item "error")) (short (field item "error") 128) 'null))
    (menu_error . ,(if (string? (field item "menu_error")) (short (field item "menu_error") 128) 'null))
    (icon_error . ,(if (string? (field item "icon_error")) (short (field item "icon_error") 128) 'null))))
(define (tray-observation message)
  (if (equal? (field message "status") "unavailable") message
      (let* ((state (validate-state (field message "state"))) (all (vector->list (field state "items"))))
        (let loop ((remaining (take all (min 32 (length all)))) (kept '()))
          (let* ((next (and (pair? remaining) (append kept (list (item-preview (car remaining))))))
                 (fits? (and next (<= (bytevector-length (string->utf8 (object->string next))) 90000))))
            (if fits? (loop (cdr remaining) next)
                `((version . 1) (service . "tray") (status . "available")
                  (observed_at_ms . ,(field message "observed_at_ms")) (error . null)
                  (state . ((session . ,(field state "session")) (watcher_owner . ,(field state "watcher_owner"))
                            (owns_watcher . ,(field state "owns_watcher")) (items . ,(list->vector kept))
                            (dropped_count . ,(- (length all) (length kept))))))))))))
(define* (tray-publish! observation #:key command)
  (let ((value (json-string->scm (scm->json-string observation))))
    (if command (hearth-service-publish! value #:command command) (hearth-service-publish! value))))

(define* (run-tray-ui renderer #:optional (worker "hearth-tray") (arguments '()))
  (let* ((model (make-tray-ui))
         (process (call-with-values (lambda () (apply (@@ (ice-9 popen) open-process) OPEN_BOTH worker arguments)) list))
         (input (car process)) (output (cadr process)) (pid (caddr process))
         (read-worker ((@@ (bluetooth-ui) pipe-reader) input))
         (connection #f) (keys '()) (dirty? #t))
    (define (send request) ((@@ (bluetooth-ui) pipe-write!) output request))
    (for-each (lambda (port) (setvbuf port 'none) (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL)))) (list input output))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (let drain () (let ((message (read-worker)))
                         (when message (tray-message! model message) (set! dirty? #t) (drain))))
          (catch #t
            (lambda ()
              (unless connection
                (let ((nodes (tray-nodes model)))
                  (set! keys (map (lambda (node) (field node "key")) (vector->list nodes)))
                  (set! connection (make-ui-client renderer "tray" nodes (tray-data model)))
                  (ui-connect! connection) (set! dirty? #f)))
              (let drain ()
                (let ((message (ui-receive connection #:timeout 0)))
                  (when message
                    (when (and (equal? (field message "type") "ack") (equal? (field message "status") "rejected"))
                      (error "Renderer rejected tray scene"))
                    (when (and (not dirty?) (equal? (field message "type") "input") (equal? (field message "event") "activate"))
                      (tray-input! model message (ui-epoch connection) (ui-applied-seq connection) (ui-seq connection) send)
                      (set! dirty? #t)) (drain))))
              (when (and dirty? (= (ui-applied-seq connection) (ui-seq connection)))
                (let* ((nodes (tray-nodes model)) (next (map (lambda (node) (field node "key")) (vector->list nodes))))
                  (ui-patch! connection nodes (list->vector (lset-difference equal? keys next)) #:data (tray-data model))
                  (set! keys next) (set! dirty? #f))))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (when connection (ui-close! connection)) (set! connection #f)
              (tray-disconnected! model) (set! dirty? #t)))
          (select (append (list input) (if (and connection (ui-port connection)) (list (ui-port connection)) '()))
                  '() '() (if connection 30 1)) (loop)))
      (lambda ()
        (when connection (ui-close! connection)) (close-port output) (close-port input)
        (let wait ((remaining 300))
          (when (zero? (car (waitpid pid WNOHANG)))
            (if (zero? remaining) (begin (kill pid SIGKILL) (waitpid pid))
                (begin (usleep 10000) (wait (- remaining 1))))))))))
(define (publish-stream input)
  (let ((seen? #f))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (let ((line ((@@ (services) read-bounded-line) input)))
            (unless (eof-object? line)
              (let ((message (call-with-input-string line
                               (lambda (port)
                                 (let ((value (json->scm port)))
                                   (let trailing ()
                                     (let ((char (read-char port)))
                                       (unless (eof-object? char)
                                         (require (char-whitespace? char) "Trailing tray observation JSON") (trailing))))
                                   value)))))
                (require (equal? (field message "service") "tray") "Tray publisher accepts observation envelopes only")
                (set! seen? #t)
                (catch #t (lambda () (tray-publish! (tray-observation message)))
                  (lambda _ (display "Tray observation publication failed\n" (current-error-port)))))
              (loop)))))
      (lambda ()
        (when seen?
          (let ((now (gettimeofday)))
            (catch #t
              (lambda () (tray-publish! `((version . 1) (service . "tray") (status . "unavailable")
                                         (observed_at_ms . ,(+ (* 1000 (car now)) (quotient (cdr now) 1000)))
                                         (state . null) (error . "Tray observation stream stopped"))))
              (lambda _ #f))))))))
(when (string-suffix? "scheme/tray-ui.scm" (car (command-line)))
  (sigaction SIGPIPE SIG_IGN) (sigaction SIGTERM (lambda (_) (throw 'quit 0))) (sigaction SIGINT (lambda (_) (throw 'quit 0)))
  (match (cdr (command-line))
    (("--publish") (publish-stream (current-input-port)))
    ((renderer) (run-tray-ui renderer))
    ((renderer worker arguments ...) (run-tray-ui renderer worker arguments))
    (_ (display "Usage: guile -L scheme scheme/tray-ui.scm SOCKET [WORKER [ARG...]] | --publish\n" (current-error-port)) (exit 2))))
