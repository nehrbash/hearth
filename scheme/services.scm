(define-module (services)
  #:use-module (ice-9 match)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 textual-ports)
  #:use-module (json)
  #:use-module (rnrs bytevectors)
  #:use-module ((rnrs io ports) #:select (get-u8))
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (hearth-service-decode hearth-service-publish! hearth-service-stream))

(define max-message-bytes 1048576)
(define (require condition message)
  (unless condition (error message)))
(define (bounded-text? value limit)
  (and (string? value) (<= (bytevector-length (string->utf8 value)) limit)))
(define (identifier? value limit)
  (and (bounded-text? value limit) (not (string-null? value))))
(define (integer-range? value minimum maximum)
  (and (integer? value) (exact? value) (<= minimum value maximum)))
(define (i64? value) (integer-range? value -9223372036854775808 9223372036854775807))
(define (object-keys? object keys)
  (and (list? object) (= (length object) (length keys))
       (every (lambda (entry) (and (pair? entry) (member (car entry) keys))) object)
       (= (length (delete-duplicates (map car object))) (length keys))))
(define (unique? values) (= (length values) (length (delete-duplicates values))))

(define (validate-state state)
  (require (object-keys? state '("instance" "monitors" "workspaces")) "Unexpected Hyprland state fields")
  (let ((instance (assoc-ref state "instance"))
        (monitors (assoc-ref state "monitors"))
        (workspaces (assoc-ref state "workspaces")))
    (require (and (identifier? instance 256)
                  (string-every (lambda (char) (<= (char->integer char) 127)) instance)
                  (string-every (lambda (char)
                                  (or (char-alphabetic? char) (char-numeric? char)
                                      (memv char '(#\_ #\-)))) instance))
             "Invalid compositor instance")
    (require (and (vector? monitors) (<= (vector-length monitors) 32)
                  (vector? workspaces) (<= (vector-length workspaces) 512))
             "Hyprland collections exceed limits")
    (for-each
      (lambda (monitor)
        (require (object-keys? monitor '("name" "focused" "active_workspace" "special_workspace"))
                 "Unexpected monitor fields")
        (require (and (identifier? (assoc-ref monitor "name") 256)
                      (boolean? (assoc-ref monitor "focused"))
                      (i64? (assoc-ref monitor "active_workspace"))
                      (let ((special (assoc-ref monitor "special_workspace")))
                        (or (eq? special 'null) (i64? special)))) "Invalid monitor"))
      (vector->list monitors))
    (require (and (unique? (map (lambda (monitor) (assoc-ref monitor "name")) (vector->list monitors)))
                  (<= (count (lambda (monitor) (assoc-ref monitor "focused")) (vector->list monitors)) 1))
             "Duplicate or conflicting monitors")
    (for-each
      (lambda (workspace)
        (require (object-keys? workspace '("id" "name" "monitor" "windows")) "Unexpected workspace fields")
        (require (and (i64? (assoc-ref workspace "id"))
                      (bounded-text? (assoc-ref workspace "name") 1024)
                      (bounded-text? (assoc-ref workspace "monitor") 256)
                      (integer-range? (assoc-ref workspace "windows") 0 4294967295)) "Invalid workspace"))
      (vector->list workspaces))
    (require (unique? (map (lambda (workspace) (assoc-ref workspace "id")) (vector->list workspaces)))
             "Duplicate workspace IDs")))

(define (validate-envelope value)
  (require (object-keys? value '("version" "service" "status" "observed_at_ms" "state" "error"))
           "Unexpected service envelope fields")
  (require (and (equal? (assoc-ref value "version") 1)
                (equal? (assoc-ref value "service") "hyprland")) "Unsupported service or version")
  (require (integer-range? (assoc-ref value "observed_at_ms") 0 18446744073709551615)
           "Invalid observation timestamp")
  (let ((status (assoc-ref value "status")) (state (assoc-ref value "state")) (failure (assoc-ref value "error")))
    (cond
      ((equal? status "available")
       (require (eq? failure 'null) "Available service cannot contain an error")
       (validate-state state))
      ((equal? status "unavailable")
       (require (and (eq? state 'null) (identifier? failure 4096)) "Unavailable service needs an error and null state"))
      (else (error "Unsupported service status"))))
  value)

(define (hearth-service-decode line)
  (require (bounded-text? line max-message-bytes) "Service message exceeds 1 MiB")
  (call-with-input-string line
    (lambda (port)
      (let ((value (json->scm port)))
        (let trailing ()
          (let ((char (read-char port)))
            (unless (eof-object? char)
              (require (char-whitespace? char) "Trailing service data")
              (trailing))))
        (validate-envelope value)))))

(define (scheme-data value)
  (cond ((eq? value 'null) #f)
        ((vector? value) (map scheme-data (vector->list value)))
        ((list? value) (map (lambda (entry) (cons (string->symbol (car entry)) (scheme-data (cdr entry)))) value))
        (else value)))

(define (readable text)
  (string-join (string-tokenize text) " "))

(define (table-rows envelope)
  (let ((status (assoc-ref envelope "status"))
        (observed (number->string (assoc-ref envelope "observed_at_ms")))
        (state (assoc-ref envelope "state")))
    (append
      `(("Name" "State") ("Hyprland" ,status) ("Observed UTC ms" ,observed))
      (if (equal? status "unavailable")
          `(("Diagnostic" ,(readable (assoc-ref envelope "error"))))
          (append
            (map (lambda (monitor)
                   (list (string-append "Monitor " (assoc-ref monitor "name"))
                         (string-append (number->string (assoc-ref monitor "active_workspace")) " active"
                                        (if (assoc-ref monitor "focused") "; focused" "")
                                        (let ((special (assoc-ref monitor "special_workspace")))
                                          (if (eq? special 'null) "" (format #f "; special ~a" special))))))
                 (vector->list (assoc-ref state "monitors")))
            (map (lambda (workspace)
                   (list (format #f "~a: ~a" (assoc-ref workspace "id") (assoc-ref workspace "name"))
                         (let ((windows (assoc-ref workspace "windows")))
                           (format #f "~a; ~a ~a" (assoc-ref workspace "monitor") windows
                                   (if (= windows 1) "window" "windows")))))
                 (vector->list (assoc-ref state "workspaces"))))))))

(define (weft-command expression)
  (let ((port (open-pipe* OPEN_READ "timeout" "--kill-after=1" "10" "weft" "workspace-eval" expression))
        (status #f) (reply #f))
    (dynamic-wind
      (lambda () #t)
      (lambda () (set! reply (get-string-n port 65537)))
      (lambda () (set! status (close-pipe port))))
    (require (zero? status) "Weft publication command failed")
    (require (bounded-text? reply 65536) "Weft publication reply exceeds limit")
    reply))

(define* (hearth-service-publish! envelope #:key (command weft-command))
  (validate-envelope envelope)
  (let* ((expression `(begin
                       (saved-set! 'hearth-hyprland ',(scheme-data envelope))
                       (zone-set! 'hearth-hyprland 'table ',(table-rows envelope))
                       #t))
         (encoded (object->string expression)))
    (require (bounded-text? encoded 122880) "Service publication exceeds the 120 KiB workspace-eval argument limit")
    (let ((reply (command encoded)))
      (require (bounded-text? reply 65536) "Weft publication reply exceeds limit")
      (call-with-input-string reply
        (lambda (port)
          (let ((result (read port)))
            (require (and (eof-object? (read port)) (list? result)
                          (eq? (assq-ref result 'status) 'ok)
                          (not (assq-ref result 'truncated)))
                     "Weft rejected service publication"))))
      #t)))

(define (read-bounded-line port)
  (let ((buffer (make-bytevector max-message-bytes)))
    (let loop ((offset 0))
      (let ((byte (get-u8 port)))
        (cond
          ((or (eof-object? byte) (= byte 10))
           (if (and (zero? offset) (eof-object? byte)) byte
               (let ((line (make-bytevector offset)))
                 (bytevector-copy! buffer 0 line 0 offset)
                 (let ((text (utf8->string line)))
                   (require (equal? line (string->utf8 text)) "Service line is not valid UTF-8")
                   text))))
          ((= offset max-message-bytes)
           (let discard ()
             (let ((byte (get-u8 port)))
               (unless (or (eof-object? byte) (= byte 10)) (discard))))
           (error "Service line exceeds 1 MiB"))
          (else (bytevector-u8-set! buffer offset byte) (loop (+ offset 1))))))))

(define (now-ms)
  (let ((time (gettimeofday))) (+ (* 1000 (car time)) (quotient (cdr time) 1000))))

(define (error-description arguments)
  (if (and (>= (length arguments) 2) (string? (cadr arguments)))
      (if (and (string=? (cadr arguments) "~A") (>= (length arguments) 3)
               (list? (caddr arguments)) (= (length (caddr arguments)) 1)
               (string? (car (caddr arguments))))
          (car (caddr arguments)) (cadr arguments))
      "Invalid input or publication failure"))

(define* (hearth-service-stream port #:key (once? #f) (command weft-command) (now now-ms))
  (define (report key arguments)
    (when (memq key '(quit interrupt)) (apply throw key arguments))
    (format (current-error-port) "Hearth services: ~a~%"
            (error-description arguments)))
  (let loop ((seen? #f))
    (let ((result (catch #t
                    (lambda ()
                      (let ((line (read-bounded-line port)))
                        (if (eof-object? line) 'eof (hearth-service-decode line))))
                    (lambda (key . arguments) (report key arguments) #f))))
      (cond
        ((eq? result 'eof)
         (if (or once? (not seen?)) #f
             (catch #t
               (lambda ()
                 (hearth-service-publish!
                   `(("version" . 1) ("service" . "hyprland") ("status" . "unavailable")
                     ("observed_at_ms" . ,(now)) ("state" . null)
                     ("error" . "Service stream stopped; start the producer to resume observations."))
                   #:command command))
               (lambda (key . arguments) (report key arguments) #f))))
        ((not result) (if once? #f (loop seen?)))
        (else
         (let ((published? (catch #t
                             (lambda () (hearth-service-publish! result #:command command))
                             (lambda (key . arguments) (report key arguments) #f))))
           (if once? published? (loop #t))))))))

(when (string-suffix? "/services.scm" (car (command-line)))
  (match (cdr (command-line))
    (() (exit (if (hearth-service-stream (current-input-port)) 0 1)))
    (("--once") (exit (if (hearth-service-stream (current-input-port) #:once? #t) 0 1)))
    (_ (display "Usage: hearth-service hyprland | guile -L scheme scheme/services.scm [--once]\n" (current-error-port))
       (exit 2))))
