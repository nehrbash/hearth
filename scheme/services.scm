(define-module (services)
  #:use-module (ice-9 match)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 textual-ports)
  #:use-module (json)
  #:use-module (rnrs bytevectors)
  #:use-module ((rnrs io ports) #:select (get-u8))
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (hearth-service-decode hearth-service-publish! hearth-service-stream))

(define max-message-bytes 1048576)
(define (require condition message)
  (unless condition (error message)))
(define (bounded-text? value limit)
  (and (string? value) (<= (bytevector-length (string->utf8 value)) limit)))
(define (identifier? value limit)
  (and (bounded-text? value limit) (not (string-null? value))))
(define (integer-range? value minimum maximum)
  (and (integer? value) (exact? value) (<= minimum value maximum)))
(define (i64? value) (integer-range? value -9223372036854775808 9223372036854775807))
(define (object-keys? object keys)
  (and (list? object) (= (length object) (length keys))
       (every (lambda (entry) (and (pair? entry) (member (car entry) keys))) object)
       (= (length (delete-duplicates (map car object))) (length keys))))
(define (unique? values) (= (length values) (length (delete-duplicates values))))

(define (validate-hyprland state)
  (require (object-keys? state '("instance" "monitors" "workspaces")) "Unexpected Hyprland state fields")
  (let ((instance (assoc-ref state "instance"))
        (monitors (assoc-ref state "monitors"))
        (workspaces (assoc-ref state "workspaces")))
    (require (and (identifier? instance 256)
                  (string-every (lambda (char) (<= (char->integer char) 127)) instance)
                  (string-every (lambda (char)
                                  (or (char-alphabetic? char) (char-numeric? char)
                                      (memv char '(#\_ #\-)))) instance))
             "Invalid compositor instance")
    (require (and (vector? monitors) (<= (vector-length monitors) 32)
                  (vector? workspaces) (<= (vector-length workspaces) 512))
             "Hyprland collections exceed limits")
    (for-each
      (lambda (monitor)
        (require (object-keys? monitor '("name" "focused" "active_workspace" "special_workspace"))
                 "Unexpected monitor fields")
        (require (and (identifier? (assoc-ref monitor "name") 256)
                      (boolean? (assoc-ref monitor "focused"))
                      (i64? (assoc-ref monitor "active_workspace"))
                      (let ((special (assoc-ref monitor "special_workspace")))
                        (or (eq? special 'null) (i64? special)))) "Invalid monitor"))
      (vector->list monitors))
    (require (and (unique? (map (lambda (monitor) (assoc-ref monitor "name")) (vector->list monitors)))
                  (<= (count (lambda (monitor) (assoc-ref monitor "focused")) (vector->list monitors)) 1))
             "Duplicate or conflicting monitors")
    (for-each
      (lambda (workspace)
        (require (object-keys? workspace '("id" "name" "monitor" "windows")) "Unexpected workspace fields")
        (require (and (i64? (assoc-ref workspace "id"))
                      (bounded-text? (assoc-ref workspace "name") 1024)
                      (bounded-text? (assoc-ref workspace "monitor") 256)
                      (integer-range? (assoc-ref workspace "windows") 0 4294967295)) "Invalid workspace"))
      (vector->list workspaces))
    (require (unique? (map (lambda (workspace) (assoc-ref workspace "id")) (vector->list workspaces)))
             "Duplicate workspace IDs")))

(define (u32? value) (integer-range? value 0 4294967295))
(define (known-state raw)
  (case raw ((1) "charging") ((2) "discharging") ((3) "empty")
        ((4) "fully_charged") ((5) "pending_charge") ((6) "pending_discharge")
        (else "unknown")))

(define (validate-charge charge)
  (require (list? charge) "Invalid UPower charge")
  (let ((kind (assoc-ref charge "kind")))
    (cond
      ((equal? kind "percentage")
       (require (and (object-keys? charge '("kind" "value"))
                     (let ((value (assoc-ref charge "value")))
                       (and (real? value) (<= 0 value 100)))) "Invalid battery percentage"))
      ((equal? kind "coarse")
       (require (and (object-keys? charge '("kind" "level"))
                     (member (assoc-ref charge "level") '("low" "critical" "normal" "high" "full")))
                "Invalid coarse battery level"))
      ((equal? kind "unknown")
       (require (and (object-keys? charge '("kind" "raw_level"))
                     (u32? (assoc-ref charge "raw_level"))
                     (not (memv (assoc-ref charge "raw_level") '(1 3 4 6 7 8))))
                "Invalid unknown battery level"))
      (else (error "Unsupported battery charge kind")))))

(define (validate-upower state)
  (require (object-keys? state '("on_battery" "display")) "Unexpected UPower state fields")
  (require (boolean? (assoc-ref state "on_battery")) "Invalid on-battery observation")
  (let* ((device (assoc-ref state "display"))
         (presence (and (list? device) (assoc-ref device "presence"))))
    (cond
      ((equal? presence "absent")
       (require (object-keys? device '("presence")) "Absent battery cannot contain measurements"))
      ((equal? presence "present")
       (require (object-keys? device '("presence" "kind" "raw_kind" "state" "raw_state" "charge"
                                      "time_to_empty_seconds" "time_to_full_seconds")) "Unexpected UPower device fields")
       (let ((kind (assoc-ref device "raw_kind")) (status (assoc-ref device "raw_state")))
         (require (and (u32? kind) (u32? status)
                       (equal? (assoc-ref device "kind") (case kind ((2) "battery") ((3) "ups") (else "unknown")))
                       (equal? (assoc-ref device "state") (known-state status))) "Inconsistent UPower device kind or state"))
       (validate-charge (assoc-ref device "charge"))
       (for-each
         (lambda (name)
           (let ((value (assoc-ref device name)))
             (require (or (eq? value 'null) (integer-range? value 1 9223372036854775807))
                      "Battery time must be positive or unknown")))
         '("time_to_empty_seconds" "time_to_full_seconds")))
      (else (error "Unsupported battery presence")))))

(define (optional? predicate value)
  (or (eq? value 'null) (predicate value)))
(define (media-time? value) (integer-range? value 0 9223372036854775807))
(define (finite-real? value) (and (real? value) (finite? value)))

(define (bus-component-char? char)
  (or (char<=? #\a char #\z) (char<=? #\A char #\Z)
      (char<=? #\0 char #\9) (memv char '(#\_ #\-))))
(define (bus-name? value unique?)
  (and (identifier? value 255)
       (if unique? (string-prefix? ":" value) (not (string-prefix? ":" value)))
       (let ((parts (string-split (if unique? (substring value 1) value) #\.)))
         (and (>= (length parts) 2)
              (every (lambda (part)
                       (and (not (string-null? part)) (string-every bus-component-char? part)
                            (or unique? (not (char-numeric? (string-ref part 0)))))) parts)))))
(define (object-path? value)
  (and (identifier? value 4096) (string-prefix? "/" value)
       (or (string=? value "/")
           (every (lambda (part)
                    (and (not (string-null? part))
                         (string-every (lambda (char)
                                         (and (bus-component-char? char) (not (char=? char #\-)))) part)))
                  (string-split (substring value 1) #\/)))))

(define (validate-mpris state)
  (require (object-keys? state '("players")) "Unexpected MPRIS state fields")
  (require (bounded-text? (scm->json-string state) 122880) "MPRIS snapshot exceeds 120 KiB")
  (let ((players (assoc-ref state "players")))
    (require (and (vector? players) (<= (vector-length players) 32)) "Too many MPRIS players")
    (for-each
      (lambda (player)
        (require (object-keys? player '("name" "owner" "identity" "playback_status" "metadata"
                                       "position_us" "volume" "rate" "shuffle" "loop_status" "capabilities"))
                 "Unexpected MPRIS player fields")
        (require (and (bus-name? (assoc-ref player "name") #f)
                      (string-prefix? "org.mpris.MediaPlayer2." (assoc-ref player "name"))
                      (bus-name? (assoc-ref player "owner") #t)
                      (string-prefix? ":" (assoc-ref player "owner"))
                      (bounded-text? (assoc-ref player "identity") 4096)
                      (member (assoc-ref player "playback_status") '("playing" "paused" "stopped"))
                      (media-time? (assoc-ref player "position_us"))
                      (let ((volume (assoc-ref player "volume"))) (and (finite-real? volume) (>= volume 0)))
                      (let ((rate (assoc-ref player "rate"))) (and (finite-real? rate) (not (zero? rate))))
                      (optional? boolean? (assoc-ref player "shuffle"))
                      (optional? (lambda (value) (member value '("none" "track" "playlist")))
                                 (assoc-ref player "loop_status"))) "Invalid MPRIS player")
        (let ((metadata (assoc-ref player "metadata")) (capabilities (assoc-ref player "capabilities")))
          (require (object-keys? metadata '("track_id" "title" "artist" "album" "length_us" "art_url" "url"))
                   "Unexpected MPRIS metadata fields")
          (for-each (lambda (key)
                      (require (optional? (lambda (value) (bounded-text? value 4096)) (assoc-ref metadata key))
                               "Invalid MPRIS metadata text"))
                    '("track_id" "title" "album" "art_url" "url"))
          (require (optional? object-path? (assoc-ref metadata "track_id")) "Invalid MPRIS track object path")
          (require (optional? media-time? (assoc-ref metadata "length_us")) "Invalid MPRIS track length")
          (let ((artists (assoc-ref metadata "artist")))
            (require (and (vector? artists) (<= (vector-length artists) 32)
                          (every (lambda (artist) (bounded-text? artist 4096)) (vector->list artists)))
                     "Invalid MPRIS artists"))
          (require (and (object-keys? capabilities '("control" "play" "pause" "next" "previous" "seek"))
                        (every (lambda (entry) (boolean? (cdr entry))) capabilities)) "Invalid MPRIS capabilities")))
      (vector->list players))
    (require (unique? (map (lambda (player) (assoc-ref player "name")) (vector->list players)))
             "Duplicate MPRIS player names")))

(define (bluez-path? value)
  (and (object-path? value) (string-prefix? "/org/bluez/" value)))

(define (validate-bluetooth state)
  (require (object-keys? state '("owner" "adapters" "devices")) "Unexpected Bluetooth snapshot fields; challenges are not snapshots")
  (require (bounded-text? (scm->json-string state) 122880) "Bluetooth snapshot exceeds 120 KiB")
  (require (bus-name? (assoc-ref state "owner") #t) "Invalid BlueZ owner")
  (let ((adapters (assoc-ref state "adapters")) (devices (assoc-ref state "devices")))
    (require (and (vector? adapters) (<= (vector-length adapters) 16)
                  (vector? devices) (<= (vector-length devices) 256)) "Bluetooth inventory exceeds limits")
    (define (texts! object keys)
      (for-each (lambda (key) (require (bounded-text? (assoc-ref object key) 4096) "Invalid Bluetooth text")) keys))
    (define (booleans! object keys)
      (for-each (lambda (key) (require (boolean? (assoc-ref object key)) "Invalid Bluetooth flag")) keys))
    (for-each
      (lambda (adapter)
        (require (object-keys? adapter '("path" "address" "name" "alias" "powered" "discovering" "pairable"))
                 "Unexpected Bluetooth adapter fields")
        (require (bluez-path? (assoc-ref adapter "path")) "Invalid Bluetooth adapter path")
        (texts! adapter '("address" "alias"))
        (require (optional? (lambda (value) (bounded-text? value 4096)) (assoc-ref adapter "name")) "Invalid adapter name")
        (booleans! adapter '("powered" "discovering" "pairable")))
      (vector->list adapters))
    (let ((paths (map (lambda (adapter) (assoc-ref adapter "path")) (vector->list adapters))))
      (require (unique? paths) "Duplicate Bluetooth adapter paths")
      (for-each
        (lambda (device)
          (require (object-keys? device '("path" "adapter" "address" "name" "alias" "icon" "connected"
                                         "paired" "trusted" "blocked" "rssi" "battery_percentage"))
                   "Unexpected Bluetooth device fields; pairing secrets must not be persisted")
          (require (and (bluez-path? (assoc-ref device "path"))
                        (bluez-path? (assoc-ref device "adapter"))
                        (member (assoc-ref device "adapter") paths)) "Invalid Bluetooth device or missing adapter")
          (texts! device '("address" "alias"))
          (for-each (lambda (key)
                      (require (optional? (lambda (value) (bounded-text? value 4096)) (assoc-ref device key))
                               "Invalid optional Bluetooth text")) '("name" "icon"))
          (booleans! device '("connected" "paired" "trusted" "blocked"))
          (require (optional? (lambda (value) (integer-range? value -32768 32767)) (assoc-ref device "rssi"))
                   "Invalid Bluetooth RSSI")
          (require (optional? (lambda (value) (integer-range? value 0 100)) (assoc-ref device "battery_percentage"))
                   "Invalid Bluetooth battery percentage"))
        (vector->list devices)))
    (require (unique? (map (lambda (device) (assoc-ref device "path")) (vector->list devices)))
             "Duplicate Bluetooth device paths")))

(define (validate-envelope value)
  (require (object-keys? value '("version" "service" "status" "observed_at_ms" "state" "error"))
           "Unexpected service envelope fields")
  (require (and (equal? (assoc-ref value "version") 1)
                (member (assoc-ref value "service") '("hyprland" "upower" "mpris" "bluetooth"))) "Unsupported service or version")
  (require (integer-range? (assoc-ref value "observed_at_ms") 0 18446744073709551615)
           "Invalid observation timestamp")
  (let ((status (assoc-ref value "status")) (state (assoc-ref value "state")) (failure (assoc-ref value "error")))
    (cond
      ((equal? status "available")
       (require (eq? failure 'null) "Available service cannot contain an error")
       (cond ((equal? (assoc-ref value "service") "hyprland") (validate-hyprland state))
             ((equal? (assoc-ref value "service") "upower") (validate-upower state))
             ((equal? (assoc-ref value "service") "mpris") (validate-mpris state))
             (else (validate-bluetooth state))))
      ((equal? status "unavailable")
       (require (and (eq? state 'null) (identifier? failure 4096)) "Unavailable service needs an error and null state"))
      (else (error "Unsupported service status"))))
  value)

(define (hearth-service-decode line)
  (require (bounded-text? line max-message-bytes) "Service message exceeds 1 MiB")
  (call-with-input-string line
    (lambda (port)
      (let ((value (json->scm port)))
        (let trailing ()
          (let ((char (read-char port)))
            (unless (eof-object? char)
              (require (char-whitespace? char) "Trailing service data")
              (trailing))))
        (validate-envelope value)))))

(define (scheme-data value)
  (cond ((eq? value 'null) #f)
        ((vector? value) (map scheme-data (vector->list value)))
        ((list? value) (map (lambda (entry) (cons (string->symbol (car entry)) (scheme-data (cdr entry)))) value))
        (else value)))

(define (readable text)
  (string-join (string-tokenize text) " "))

(define (hyprland-rows state)
  (append
    (map (lambda (monitor)
           (list (string-append "Monitor " (assoc-ref monitor "name"))
                 (string-append (number->string (assoc-ref monitor "active_workspace")) " active"
                                (if (assoc-ref monitor "focused") "; focused" "")
                                (let ((special (assoc-ref monitor "special_workspace")))
                                  (if (eq? special 'null) "" (format #f "; special ~a" special))))))
         (vector->list (assoc-ref state "monitors")))
    (map (lambda (workspace)
           (list (format #f "~a: ~a" (assoc-ref workspace "id") (assoc-ref workspace "name"))
                 (let ((windows (assoc-ref workspace "windows")))
                   (format #f "~a; ~a ~a" (assoc-ref workspace "monitor") windows
                           (if (= windows 1) "window" "windows")))))
         (vector->list (assoc-ref state "workspaces")))))

(define (remaining-time value)
  (cond ((eq? value 'null) "Unknown")
        ((< value 60) (format #f "~a s" value))
        ((< value 3600) (format #f "~a min" (quotient value 60)))
        (else (format #f "~a h ~a min" (quotient value 3600) (quotient (modulo value 3600) 60)))))

(define (upower-rows state)
  (let* ((device (assoc-ref state "display"))
         (power-row (list "On battery" (if (assoc-ref state "on_battery") "Yes" "No"))))
    (if (equal? (assoc-ref device "presence") "absent")
        (list '("Battery / UPS" "Absent") power-row)
        (let* ((charge (assoc-ref device "charge"))
               (charge-kind (assoc-ref charge "kind"))
               (value (cond ((equal? charge-kind "percentage") (format #f "~a%" (assoc-ref charge "value")))
                            ((equal? charge-kind "coarse") (string-append (string-titlecase (assoc-ref charge "level")) " (coarse)"))
                            (else "Unknown"))))
          (list (list (cond ((equal? (assoc-ref device "kind") "ups") "UPS")
                           ((equal? (assoc-ref device "kind") "battery") "Battery")
                           (else "Power device"))
                      (string-titlecase (string-map (lambda (char) (if (char=? char #\_) #\space char)) (assoc-ref device "state"))))
                (list "Charge" value) power-row
                (list "Time to empty" (remaining-time (assoc-ref device "time_to_empty_seconds")))
                (list "Time to full" (remaining-time (assoc-ref device "time_to_full_seconds"))))))))

(define (mpris-time microseconds)
  (if (eq? microseconds 'null) "Unknown"
      (let ((seconds (quotient microseconds 1000000)))
        (format #f "~a:~2,'0d" (quotient seconds 60) (modulo seconds 60)))))

(define (mpris-rows state)
  (let ((players (vector->list (assoc-ref state "players"))))
    (if (null? players) '(("Players" "None"))
        (append-map
          (lambda (player)
            (let* ((metadata (assoc-ref player "metadata"))
                   (title (assoc-ref metadata "title"))
                   (artists (vector->list (assoc-ref metadata "artist")))
                   (capabilities (assoc-ref player "capabilities")))
              (list (list (readable (assoc-ref player "identity")) (string-titlecase (assoc-ref player "playback_status")))
                    (list "Title" (if (eq? title 'null) "Unknown" (readable title)))
                    (list "Artist" (if (null? artists) "Unknown" (readable (string-join artists ", "))))
                    (list "Position" (string-append (mpris-time (assoc-ref player "position_us")) " / "
                                                   (mpris-time (assoc-ref metadata "length_us"))))
                    (list "Controls" (if (not (assoc-ref capabilities "control")) "Unavailable"
                                         (let ((enabled (filter (lambda (key) (assoc-ref capabilities key))
                                                                '("play" "pause" "next" "previous" "seek"))))
                                           (if (null? enabled) "None" (string-join enabled ", "))))))))
          players))))

(define (bluetooth-rows state)
  (let ((adapters (vector->list (assoc-ref state "adapters")))
        (devices (vector->list (assoc-ref state "devices"))))
    (append
      (if (null? adapters) '(("Adapters" "None"))
          (map (lambda (adapter)
                 (list (readable (assoc-ref adapter "alias"))
                       (string-append (if (assoc-ref adapter "powered") "On" "Off")
                                      (if (assoc-ref adapter "discovering") "; scanning" "; not scanning")
                                      (if (assoc-ref adapter "pairable") "; pairable" "; not pairable")))) adapters))
      (if (null? devices) '(("Devices" "None"))
          (append-map
            (lambda (device)
              (let ((battery (assoc-ref device "battery_percentage")) (rssi (assoc-ref device "rssi")))
                (list
                  (list (readable (assoc-ref device "alias"))
                        (string-append (if (assoc-ref device "connected") "Connected" "Disconnected")
                                       (if (assoc-ref device "paired") "; paired" "; unpaired")))
                  (list "Device policy" (string-append (if (assoc-ref device "trusted") "Trusted" "Untrusted")
                                                       (if (assoc-ref device "blocked") "; blocked" "; not blocked")))
                  (list "Battery / signal" (format #f "~a / ~a"
                                             (if (eq? battery 'null) "Unknown" (format #f "~a%" battery))
                                             (if (eq? rssi 'null) "Unknown" (format #f "~a dBm" rssi))))))) devices)))))

(define (service-label service)
  (cond ((equal? service "hyprland") "Hyprland")
        ((equal? service "upower") "UPower")
        ((equal? service "mpris") "MPRIS") (else "Bluetooth")))

(define (table-rows envelope)
  (let ((status (assoc-ref envelope "status"))
        (service (assoc-ref envelope "service"))
        (observed (number->string (assoc-ref envelope "observed_at_ms")))
        (state (assoc-ref envelope "state")))
    (append
      `(("Name" "State") (,(service-label service) ,status) ("Observed UTC ms" ,observed))
      (cond ((equal? status "unavailable") `(("Diagnostic" ,(readable (assoc-ref envelope "error")))))
            ((equal? service "hyprland") (hyprland-rows state))
            ((equal? service "upower") (upower-rows state))
            ((equal? service "mpris") (mpris-rows state))
            (else (bluetooth-rows state))))))

(define (weft-command expression)
  (let ((port (open-pipe* OPEN_READ "timeout" "--kill-after=1" "10" "weft" "workspace-eval" expression))
        (status #f) (reply #f))
    (dynamic-wind
      (lambda () #t)
      (lambda () (set! reply (get-string-n port 65537)))
      (lambda () (set! status (close-pipe port))))
    (require (zero? status) "Weft publication command failed")
    (require (bounded-text? reply 65536) "Weft publication reply exceeds limit")
    reply))

(define* (hearth-service-publish! envelope #:key (command weft-command))
  (validate-envelope envelope)
  (let* ((name (string->symbol (string-append "hearth-" (assoc-ref envelope "service"))))
         (expression `(begin
                       (saved-set! ',name ',(scheme-data envelope))
                       (zone-set! ',name 'table ',(table-rows envelope))
                       #t))
         (encoded (object->string expression)))
    (require (bounded-text? encoded 122880) "Service publication exceeds the 120 KiB workspace-eval argument limit")
    (let ((reply (command encoded)))
      (require (bounded-text? reply 65536) "Weft publication reply exceeds limit")
      (call-with-input-string reply
        (lambda (port)
          (let ((result (read port)))
            (require (and (eof-object? (read port)) (list? result)
                          (eq? (assq-ref result 'status) 'ok)
                          (not (assq-ref result 'truncated)))
                     "Weft rejected service publication"))))
      #t)))

(define (read-bounded-line port)
  (let ((buffer (make-bytevector max-message-bytes)))
    (let loop ((offset 0))
      (let ((byte (get-u8 port)))
        (cond
          ((or (eof-object? byte) (= byte 10))
           (if (and (zero? offset) (eof-object? byte)) byte
               (let ((line (make-bytevector offset)))
                 (bytevector-copy! buffer 0 line 0 offset)
                 (let ((text (utf8->string line)))
                   (require (equal? line (string->utf8 text)) "Service line is not valid UTF-8")
                   text))))
          ((= offset max-message-bytes)
           (let discard ()
             (let ((byte (get-u8 port)))
               (unless (or (eof-object? byte) (= byte 10)) (discard))))
           (error "Service line exceeds 1 MiB"))
          (else (bytevector-u8-set! buffer offset byte) (loop (+ offset 1))))))))

(define (now-ms)
  (let ((time (gettimeofday))) (+ (* 1000 (car time)) (quotient (cdr time) 1000))))

(define (error-description arguments)
  (if (and (>= (length arguments) 2) (string? (cadr arguments)))
      (if (and (string=? (cadr arguments) "~A") (>= (length arguments) 3)
               (list? (caddr arguments)) (= (length (caddr arguments)) 1)
               (string? (car (caddr arguments))))
          (car (caddr arguments)) (cadr arguments))
      "Invalid input or publication failure"))

(define* (hearth-service-stream port #:key (once? #f) (command weft-command) (now now-ms))
  (define (report key arguments)
    (when (memq key '(quit interrupt)) (apply throw key arguments))
    (format (current-error-port) "Hearth services: ~a~%"
            (error-description arguments)))
  (let loop ((seen '()))
    (let ((result (catch #t
                    (lambda ()
                      (let ((line (read-bounded-line port)))
                        (if (eof-object? line) 'eof (hearth-service-decode line))))
                    (lambda (key . arguments) (report key arguments) #f))))
      (cond
        ((eq? result 'eof)
         (if (or once? (null? seen)) #f
             (fold
               (lambda (service successful?)
                 (let ((published?
                         (catch #t
                           (lambda ()
                             (hearth-service-publish!
                               `(("version" . 1) ("service" . ,service) ("status" . "unavailable")
                                 ("observed_at_ms" . ,(now)) ("state" . null)
                                 ("error" . "Service stream stopped; start the producer to resume observations."))
                               #:command command))
                           (lambda (key . arguments) (report key arguments) #f))))
                   (and published? successful?)))
               #t seen)))
        ((not result) (if once? #f (loop seen)))
        (else
         (let ((published? (catch #t
                             (lambda () (hearth-service-publish! result #:command command))
                             (lambda (key . arguments) (report key arguments) #f))))
           (if once? published?
               (let ((service (assoc-ref result "service")))
                 (loop (if (member service seen) seen (cons service seen)))))))))))

(when (string-suffix? "/services.scm" (car (command-line)))
  (match (cdr (command-line))
    (() (exit (if (hearth-service-stream (current-input-port)) 0 1)))
    (("--once") (exit (if (hearth-service-stream (current-input-port) #:once? #t) 0 1)))
    (_ (display "Usage: hearth-service hyprland|upower|mpris|bluetooth | guile -L scheme scheme/services.scm [--once]\n" (current-error-port))
       (exit 2))))
