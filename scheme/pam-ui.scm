(define-module (pam-ui)
  #:use-module (ui)
  #:use-module (services)
  #:use-module (bluetooth-ui)
  #:use-module (json)
  #:use-module (ice-9 match)
  #:use-module (ice-9 popen)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-13)
  #:export (make-pam-ui pam-message! pam-nodes pam-data pam-activate! pam-input!
            pam-disconnected! pam-expire! pam-observation pam-publish-stream run-pam-ui))

(define-record-type <pam-ui>
  (%make-ui session pending attempt prompt entry page serial view status buttons deadline seen)
  pam-ui?
  (session session set-session!) (pending pending set-pending!)
  (attempt attempt set-attempt!) (prompt prompt set-prompt!) (entry entry set-entry!)
  (page page set-page!) (serial serial set-serial!) (view view set-view!)
  (status status set-status!) (buttons buttons set-buttons!) (deadline deadline set-deadline!) (seen seen set-seen!))
(define (make-pam-ui) (%make-ui #f #f #f #f "" 0 0 0 "Waiting for authentication worker" '() #f '()))
(define (field value key) (and (list? value) (ui-field value key)))
(define (now-ms) (let ((time (gettimeofday))) (+ (* 1000 (car time)) (quotient (cdr time) 1000))))
(define (require value message) (unless value (error message)))
(define (bounded? value n) (and (string? value) (<= (bytevector-length (string->utf8 value)) n) (not (string-index value #\nul))))
(define (token? value) (and (bounded? value 128) (positive? (string-length value))))
(define (timestamp? value) (and (integer? value) (exact? value) (<= 0 value 18446744073709551615)))
(define (invalidate! model) (set-view! model (+ 1 (view model))) (set-buttons! model '()))
(define (clear-prompt! model) (set-entry! model "") (set-prompt! model #f) (set-page! model 0) (invalidate! model))
(define (pam-data model) '((sensitive . #t) (service . "pam")))
(define (pam-disconnected! model send)
  (let ((request (and (session model) (attempt model)
                 `((type . "cancel") (session . ,(session model)) (attempt . ,(attempt model))))))
    (clear-prompt! model) (set-pending! model #f) (set-attempt! model #f) (set-deadline! model #f)
    (set-status! model "Authentication cancelled; no session lock was changed")
    (when request (send request))))
(define (pam-expire! model send timestamp)
  (when (and (deadline model) (>= timestamp (deadline model)))
    (pam-disconnected! model send) (set-status! model "Authentication deadline expired")))
(define (pam-message! model message send)
  (let ((type (field message "type")))
    (cond
      ((equal? type "ready")
       (require (token? (field message "session")) "Invalid authentication worker identity")
       (unless (equal? (session model) (field message "session"))
         (clear-prompt! model) (set-pending! model #f) (set-attempt! model #f) (set-deadline! model #f))
       (set-session! model (field message "session")) (set-status! model "Ready for an explicit authentication attempt"))
      ((equal? type "started")
       (require (and (token? (field message "attempt")) (timestamp? (field message "deadline_ms"))) "Invalid authentication start")
       (when (equal? (session model) (field message "session"))
         (if (and (pending model) (not (attempt model)) (equal? (pending model) (field message "request_id")))
             (begin (set-seen! model '()) (set-attempt! model (field message "attempt")) (set-deadline! model (field message "deadline_ms"))
                    (clear-prompt! model) (set-status! model "Authentication in progress"))
             (unless (equal? (attempt model) (field message "attempt"))
               (send `((type . "cancel") (session . ,(session model)) (attempt . ,(field message "attempt"))))))))
      ((equal? type "prompt")
       (when (and (attempt model) (equal? (session model) (field message "session")) (equal? (attempt model) (field message "attempt")))
         (require (and (token? (field message "prompt_id")) (bounded? (field message "text") 4096)
                       (member (field message "style") '("echo_off" "echo_on" "info" "error"))
                       (boolean? (field message "response_required"))
                       (eq? (field message "response_required") (if (member (field message "style") '("echo_off" "echo_on")) #t #f))
                       (timestamp? (field message "deadline_ms"))) "Invalid authentication prompt")
         (unless (member (field message "prompt_id") (seen model))
           (require (< (length (seen model)) 128) "Authentication prompt limit exceeded")
           (set-seen! model (cons (field message "prompt_id") (seen model)))
           (clear-prompt! model) (set-prompt! model message)
           (set-deadline! model (min (deadline model) (field message "deadline_ms")))
           (set-status! model (if (field message "response_required") "Response required; input is masked" "Authentication message")))))
      ((equal? type "result")
       (when (and (attempt model) (equal? (session model) (field message "session"))
                  (equal? (attempt model) (field message "attempt")) (equal? (pending model) (field message "request_id")))
         (require (member (field message "status") '("authenticated" "denied" "account_denied" "cancelled" "timeout" "error")) "Invalid authentication result")
         (clear-prompt! model) (set-attempt! model #f) (set-pending! model #f) (set-deadline! model #f)
         (set-status! model (cdr (assoc (field message "status")
           '(("authenticated" . "Authentication and account checks passed") ("denied" . "Authentication denied")
             ("account_denied" . "Account policy denied access") ("cancelled" . "Authentication cancelled")
             ("timeout" . "Authentication timed out") ("error" . "Authentication service error")))))))
      ((equal? type "command_rejected")
       (pam-disconnected! model send) (set-status! model "Authentication command rejected; start a new attempt"))
      ((equal? (field message "service") "pam") (pam-observation message))
      (else (error "Unexpected authentication worker message")))))

(define (pam-nodes model)
  (let ((nodes '()) (buttons '()))
    (define (add node) (set! nodes (cons node nodes)))
    (define (label key x y w h text size)
      (add `((key . ,key) (kind . "text") (order . 2) (bounds . ,(vector x y w h))
             (text . ,text) (font_size . ,size) (color . #(0.93 0.94 0.98 1)))))
    (define (button name caption x y w action)
      (let ((key (format #f "view-~a-~a" (view model) name)))
        (set! buttons (acons key action buttons))
        (add `((key . ,key) (kind . "group") (order . 3) (bounds . ,(vector 0 0 w 36)) (offset . ,(vector x y))
               (input . #t) (transitions . ((offset . 80)))
               (states . ((hover . ((offset . ,(vector x (- y 1))))) (pressed . ((offset . ,(vector x (+ y 1)))))))))
        (add `((key . ,(string-append key "-bg")) (parent . ,key) (kind . "rect") (bounds . ,(vector 0 0 w 36)) (color . #(0.13 0.23 0.32 1))))
        (add `((key . ,(string-append key "-text")) (parent . ,key) (kind . "text") (order . 1)
               (bounds . ,(vector 8 7 (- w 16) 24)) (text . ,caption) (font_size . 14) (color . #(0.94 0.96 1 1))))))
    (add '((key . "background") (kind . "rect") (bounds . #(0 0 720 760)) (color . #(0.025 0.035 0.055 1))))
    (label "title" 24 20 672 36 "Authentication" 28)
    (label "scope" 24 66 672 28 "Service panel · does not lock or unlock your session" 17)
    (label "status" 24 106 672 54 (status model) 18)
    (cond
      ((pending model) (button "cancel" "Cancel attempt" 24 168 180 '(cancel)))
      ((session model) (button "start" "Start authentication" 24 168 220 '(start))))
    (when (prompt model)
      (label "prompt" 24 220 672 88 (field (prompt model) "text") 18)
      (when (field (prompt model) "response_required")
        (label "masked" 24 310 672 28 (format #f "Masked response: ~a characters" (string-length (entry model))) 18)
        (let* ((characters (map integer->char (iota 95 32))) (visible (take (drop characters (* (page model) 48)) (min 48 (- 95 (* (page model) 48))))))
          (for-each (lambda (character index)
            (button (format #f "key-~a" (char->integer character)) (if (char=? character #\space) "SP" (string character))
                    (+ 24 (* (modulo index 12) 56)) (+ 354 (* (quotient index 12) 44)) 48 (list 'character character))) visible (iota (length visible))))
        (button "page" (if (zero? (page model)) "Letters →" "← Symbols") 24 540 160 '(page))
        (button "backspace" "Backspace" 200 540 140 '(backspace))
        (button "clear" "Clear" 356 540 100 '(clear))
        (button "submit" "Submit response" 24 598 200 '(submit))
        (label "keyboard-limit" 24 650 672 28 "Keyboard: printable ASCII · maximum 4096 bytes" 15)))
    (label "footer" 24 714 672 28 "Responses are never included in scene or workspace data." 15)
    (set-buttons! model buttons) (list->vector (reverse nodes))))
(define (pam-activate! model key send)
  (let ((action (assoc-ref (buttons model) key)))
    (when action
      (match action
        (('start)
         (when (and (session model) (not (pending model)))
           (set-serial! model (+ 1 (serial model))) (set-pending! model (number->string (serial model)))
           (invalidate! model) (set-status! model "Starting authentication")
           (send `((type . "authenticate") (session . ,(session model)) (request_id . ,(pending model))))))
        (('cancel) (pam-disconnected! model send))
        (_ (when (and (attempt model) (prompt model) (field (prompt model) "response_required"))
             (match action
               (('character character) (when (< (string-length (entry model)) 4096) (set-entry! model (string-append (entry model) (string character)))))
               (('page) (set-page! model (- 1 (page model))))
               (('backspace) (unless (string-null? (entry model)) (set-entry! model (substring (entry model) 0 (- (string-length (entry model)) 1)))))
               (('clear) (set-entry! model ""))
               (('submit)
                (let ((request `((type . "reply") (session . ,(session model)) (attempt . ,(attempt model))
                                 (prompt_id . ,(field (prompt model) "prompt_id")) (value . ,(entry model)))))
                  (clear-prompt! model) (set-status! model "Waiting for authentication result") (send request)))
               (_ #f))
             (invalidate! model)))))))
(define (pam-input! model message epoch applied-seq current-seq send)
  (when (and (equal? (field message "type") "input") (equal? (field message "channel") "pam")
             (equal? (field message "epoch") epoch) (equal? (field message "seq") applied-seq)
             (= applied-seq current-seq) (equal? (field message "event") "activate"))
    (pam-activate! model (field message "key") send)))
(define (pam-observation message)
  (hearth-service-decode (scm->json-string message)))

(define* (run-pam-ui renderer #:optional (worker "hearth-pam") (arguments '()) #:key (publish? #f))
  (let* ((model (make-pam-ui))
         (process (call-with-values (lambda () (apply (@@ (ice-9 popen) open-process) OPEN_BOTH worker arguments)) list))
         (input (car process)) (output (cadr process)) (pid (caddr process))
         (read-worker ((@@ (bluetooth-ui) pipe-reader) input))
         (connection #f) (keys '()) (dirty? #t)
         (publisher (and publish? (call-with-values
           (lambda () ((@@ (ice-9 popen) open-process) OPEN_BOTH "guile" "-L"
             (dirname (search-path %load-path "pam-ui.scm"))
             (search-path %load-path "pam-ui.scm") "--publish")) list)))
         (publication #f))
    (define (send request) ((@@ (bluetooth-ui) pipe-write!) output request))
    (for-each (lambda (port) (setvbuf port 'none) (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL)))) (list input output))
    (when publisher
      (setvbuf (cadr publisher) 'none)
      (fcntl (cadr publisher) F_SETFL (logior O_NONBLOCK (fcntl (cadr publisher) F_GETFL))))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (when (and (deadline model) (>= (now-ms) (deadline model)))
            (pam-expire! model send (now-ms)) (set! dirty? #t))
          (when (and publisher publication (pair? (cadr (select '() (list (cadr publisher)) '() 0))))
            (catch #t
              (lambda ()
                (let ((line (string->utf8 (string-append (scm->json-string publication) "\n"))))
                  (require (<= (bytevector-length line) 4096) "Authentication observation exceeds atomic pipe budget")
                  ((@ (rnrs io ports) put-bytevector) (cadr publisher) line)
                  (set! publication #f)))
              (lambda _
                (format (current-error-port) "Authentication publication pipe unavailable\n")
                (set! publication #f))))
          (let drain () (let ((message (read-worker)))
                         (when message (pam-message! model message send)
                           (when (and publisher (equal? (field message "service") "pam"))
                             (set! publication (pam-observation message))) (set! dirty? #t) (drain))))
          (catch #t
            (lambda ()
              (unless connection
                (let ((nodes (pam-nodes model)))
                  (set! keys (map (lambda (node) (field node "key")) (vector->list nodes)))
                  (set! connection (make-ui-client renderer "pam" nodes (pam-data model)))
                  (ui-connect! connection) (set! dirty? #f)))
              (let drain ()
                (let ((message (ui-receive connection #:timeout 0)))
                  (when message
                    (when (and (equal? (field message "type") "ack") (equal? (field message "status") "rejected"))
                      (error "Renderer rejected pam scene"))
                    (when (and (not dirty?) (equal? (field message "type") "input") (equal? (field message "event") "activate"))
                      (pam-input! model message (ui-epoch connection) (ui-applied-seq connection) (ui-seq connection) send)
                      (set! dirty? #t)) (drain))))
              (when (and dirty? (= (ui-applied-seq connection) (ui-seq connection)))
                (let* ((nodes (pam-nodes model)) (next (map (lambda (node) (field node "key")) (vector->list nodes))))
                  (ui-patch! connection nodes (list->vector (lset-difference equal? keys next)) #:data (pam-data model))
                  (set! keys next) (set! dirty? #f))))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (when connection (ui-close! connection)) (set! connection #f)
              (pam-disconnected! model send) (set! dirty? #t)))
          (select (append (list input) (if (and connection (ui-port connection)) (list (ui-port connection)) '()))
                  (if (and publisher publication) (list (cadr publisher)) '()) '() (if (and connection (not (deadline model))) 30 1)) (loop)))
      (lambda ()
        (catch #t (lambda () (pam-disconnected! model send)) (lambda _ #f))
        (when connection (ui-close! connection)) (close-port output) (close-port input)
        (when publisher
          (close-port (cadr publisher)) (close-port (car publisher))
          (let wait ((remaining 1200))
            (when (zero? (car (waitpid (caddr publisher) WNOHANG)))
              (if (zero? remaining) (begin (kill (caddr publisher) SIGKILL) (waitpid (caddr publisher)))
                  (begin (usleep 10000) (wait (- remaining 1)))))))
        (let wait ((remaining 300))
          (when (zero? (car (waitpid pid WNOHANG)))
            (if (zero? remaining) (begin (kill pid SIGKILL) (waitpid pid))
                (begin (usleep 10000) (wait (- remaining 1))))))))))

(define* (pam-publish-stream input #:key (command (@@ (services) weft-command)))
  (let ((read-line (@@ (services) read-bounded-line)) (seen? #f))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (let ((line (read-line input)))
            (unless (eof-object? line)
              (catch #t
                (lambda ()
                  (let ((envelope (hearth-service-decode line)))
                    (require (equal? (field envelope "service") "pam") "Authentication publisher requires phase observations")
                    (set! seen? #t) (hearth-service-publish! envelope #:command command)))
                (lambda (key . arguments)
                  (when (memq key '(quit interrupt)) (apply throw key arguments))
                  (format (current-error-port) "Authentication observation rejected or publication unavailable\n")))
              (loop)))))
      (lambda ()
        (when seen?
          (catch #t
            (lambda () (hearth-service-publish! (pam-observation
              `((version . 1) (service . "pam") (status . "unavailable") (observed_at_ms . ,(now-ms))
                (state . null) (error . "Authentication worker unavailable"))) #:command command))
            (lambda _ #f)))))))

(when (string-suffix? "/pam-ui.scm" (car (command-line)))
  (setrlimit 'core 0 0)
  (sigaction SIGPIPE SIG_IGN)
  (sigaction SIGTERM (lambda (_) (throw 'quit 0)))
  (sigaction SIGINT (lambda (_) (throw 'quit 0)))
  (catch #t
    (lambda ()
      (match (cdr (command-line))
        (("--publish") (pam-publish-stream (current-input-port)))
        (("--publish-workspace" renderer worker arguments ...) (run-pam-ui renderer worker arguments #:publish? #t))
        ((renderer worker arguments ...) (run-pam-ui renderer worker arguments))
        (_ (display "Usage: guile -L scheme scheme/pam-ui.scm [--publish-workspace] SOCKET hearth-pam --service NAME\n" (current-error-port)) (exit 2))))
    (lambda (key . arguments)
      (if (memq key '(quit interrupt)) (exit 0)
          (begin (display "Authentication controller stopped\n" (current-error-port)) (exit 1))))))
