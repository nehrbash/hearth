(use-modules (scene) (hearth) (json))

(define ink '(226 232 240 255))
(define muted '(148 163 184 255))
(define panel '(0.025 0.045 0.07 1))
(define (label text x y width size color)
  (scene-text text (list x y width 36) size color))
(define (status-widget)
  (scene-group '(24 70)
    (list (scene-rect '(0 0 592 64) panel)
          (scene-rect '(14 23 12 12) '(0.2 0.7 0.55 1))
          (label "Weft connected" 40 14 300 20 ink)
          (label "isolated" 450 16 120 16 muted))))
(define (metric-widget count)
  (scene-group '(24 150)
    (list (scene-rect '(0 0 592 84) panel)
          (label "Active sessions" 16 12 360 18 muted)
          (label (number->string count) 500 20 70 28 ink))))
(define (sessions-widget)
  (scene-group '(24 250)
    (list (scene-rect '(0 0 592 118) panel)
          (label "SESSION" 16 8 260 14 muted)
          (label "CHANNEL" 330 8 240 14 muted)
          (label "codex" 16 42 260 18 ink)
          (label "workspace" 330 42 240 18 ink)
          (label "claude" 16 76 260 18 ink)
          (label "terminal" 330 76 240 18 ink))))
(define nodes
  (list (scene-rect '(0 0 640 400) '(0.008 0.012 0.02 1))
        (label "Hearth / Weft workspace" 24 18 592 26 ink)
        (status-widget) (metric-widget 2) (sessions-widget)))
(define payload
  (hearth-scene-snapshot nodes "scene-demo" 1
    #:zones (list (hearth-text 'status "Weft connected")
                  (hearth-metric 'sessions 2))))
(if (= (length (command-line)) 2)
    (hearth-send! (cadr (command-line)) payload)
    (begin (display (scm->json-string payload)) (newline)))
