(define-module (widget)
  #:use-module (ui)
  #:use-module (ice-9 match)
  #:use-module (rnrs bytevectors)
  #:export (widget-nodes widget-data widget-attach! widget-handle! widget-control!
            on-activate publish-widget! counter enabled? run-widget))

(define counter 0)
(define enabled? #f)
(define client #f)
(define (value-node)
  `((key . "counter-value") (kind . "text") (order . 2)
    (bounds . #(28 64 364 38)) (text . ,(format #f "Count: ~a" counter))
    (font_size . 26) (color . #(0.9 0.93 0.98 1))))
(define (toggle-background)
  `((key . "toggle-bg") (parent . "toggle") (kind . "rect") (order . 0)
    (bounds . #(0 0 170 52)) (color . #(0.12 0.17 0.25 1))
    (state . ,(if enabled? "on" "off")) (transitions . ((color . 180)))
    (states . ((on . ((color . #(0.08 0.48 0.31 1))))))))
(define (toggle-label)
  `((key . "toggle-label") (parent . "toggle") (kind . "text") (order . 1)
    (bounds . #(16 12 138 28)) (text . ,(if enabled? "On" "Off"))
    (font_size . 20) (color . #(0.95 0.96 0.99 1))))
(define (widget-data) `((counter . ,counter) (enabled . ,enabled?)))
(define (widget-nodes)
  (vector
    '((key . "background") (kind . "rect") (order . 0) (bounds . #(0 0 420 250)) (color . #(0.008 0.012 0.02 1)))
    '((key . "title") (kind . "text") (order . 1) (bounds . #(28 20 364 30))
      (text . "Scheme workspace widget") (font_size . 19) (color . #(0.9 0.93 0.98 1)))
    (value-node)
    '((key . "increment") (kind . "group") (order . 3) (bounds . #(0 0 170 52))
      (offset . #(28 122)) (input . #t) (transitions . ((offset . 90)))
      (states . ((hover . ((offset . #(28 120)))) (pressed . ((offset . #(28 124)))))))
    '((key . "increment-bg") (parent . "increment") (kind . "rect") (order . 0)
      (bounds . #(0 0 170 52)) (color . #(0.12 0.17 0.25 1)))
    '((key . "increment-label") (parent . "increment") (kind . "text") (order . 1)
      (bounds . #(16 12 138 28)) (text . "Increment") (font_size . 20) (color . #(0.95 0.96 0.99 1)))
    '((key . "toggle") (kind . "group") (order . 4) (bounds . #(0 0 170 52))
      (offset . #(220 122)) (input . #t) (transitions . ((offset . 90)))
      (states . ((hover . ((offset . #(220 120)))) (pressed . ((offset . #(220 124)))))))
    (toggle-background) (toggle-label)
    '((key . "footer") (kind . "text") (order . 5) (bounds . #(28 201 364 24))
      (text . "Scheme behavior · Rust transitions") (font_size . 13) (color . #(0.5 0.6 0.72 1)))))
(define (widget-attach! connection) (set! client connection))
(define (publish-widget!)
  (ui-patch! client (vector (value-node) (toggle-background) (toggle-label)) #() #:data (widget-data)))
(define (on-activate key)
  (cond ((equal? key "increment") (set! counter (+ counter 1)))
        ((equal? key "toggle") (set! enabled? (not enabled?))))
  (publish-widget!))
(define (widget-handle! message)
  (when (and (equal? (ui-field message "type") "input")
             (equal? (ui-field message "channel") (ui-channel client))
             (equal? (ui-field message "epoch") (ui-epoch client))
             (equal? (ui-field message "seq") (ui-applied-seq client))
             (equal? (ui-field message "event") "activate")
             (member (ui-field message "key") '("increment" "toggle")))
    ;; Module lookup keeps compiled handlers redefinable through the local UI control socket.
    ((module-ref (resolve-module '(widget)) 'on-activate) (ui-field message "key"))))

(define (widget-control! code)
  (unless (and (string? code) (<= (bytevector-length (string->utf8 code)) 65536))
    (error "Control expression exceeds 64 KiB"))
  (call-with-input-string code
    (lambda (port)
      (let ((expression (read port)))
        (unless (eof-object? (read port)) (error "Expected one control expression"))
        (eval expression (resolve-module '(widget)))))))

(define (control-socket path)
  (let* ((directory (dirname path)) (info (lstat directory)))
    (unless (and (string-prefix? "/" path) (equal? directory (canonicalize-path directory))
                 (eq? (stat:type info) 'directory) (= (stat:uid info) (getuid))
                 (= #o700 (logand (stat:perms info) #o777)))
      (error "UI control socket requires an owned private 0700 directory"))
    (when (file-exists? path) (error "UI control socket path already exists"))
    (let ((port (socket AF_UNIX SOCK_STREAM 0)))
      (catch #t
        (lambda () (bind port AF_UNIX path) (chmod path #o600) (listen port 4)
          (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL))) port)
        (lambda (key . arguments) (close-port port) (apply throw key arguments))))))
(define (serve-control! listener)
  (when (pair? (car (select (list listener) '() '() 0)))
    (let ((port (car (accept listener))))
      (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL)))
      (dynamic-wind
        (lambda () #t)
        (lambda ()
          (let ((response
                  (catch #t
                    (lambda ()
                      (let* ((request (ui-read-json (ui-reader port)))
                             (value (call-with-values (lambda () (widget-control! (ui-field request "code"))) list))
                             (text (object->string value)))
                        `((status . "ok") (value . ,(substring text 0 (min 4096 (string-length text)))))))
                    (lambda (key . arguments) `((status . "error") (value . ,(symbol->string key)))))))
            (catch #t (lambda () (ui-write-json! port response)) (lambda _ #f))))
        (lambda () (close-port port))))))

(define* (run-widget path #:key control)
  (let* ((connection (make-ui-client path "widget" (widget-nodes) (widget-data)))
         (listener (and control (control-socket control)))
         (identity (and control (lstat control))))
    (widget-attach! connection)
    (sigaction SIGPIPE SIG_IGN)
    (sigaction SIGTERM (lambda (_) (throw 'quit 0)))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (catch #t
            (lambda ()
              (unless (ui-port connection)
                (ui-connect! connection)
                (format (current-error-port) "UI connected session=~a epoch=~a~%" (ui-session-id connection) (ui-epoch connection)))
              (when listener (serve-control! listener))
              (let ((message (ui-receive connection #:timeout 1)))
                (when message
                  (widget-handle! message)
                  (when (member (ui-field message "type") '("ack" "presented"))
                    (format (current-error-port) "UI ~s~%" message)))))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (ui-close! connection)
              (format (current-error-port) "UI connection failed (~a); reconnecting~%" key)
              (when listener (serve-control! listener))
              (select '() '() '() 1)))
          (loop)))
      (lambda ()
        (ui-close! connection)
        (when listener (close-port listener))
        (when (and identity (file-exists? control))
          (let ((current (lstat control)))
            (when (and (= (stat:ino current) (stat:ino identity)) (= (stat:dev current) (stat:dev identity)))
              (delete-file control))))))))

(when (string-suffix? "/widget.scm" (car (command-line)))
  (match (cdr (command-line))
    ((path) (run-widget path))
    ((path "--control" control) (run-widget path #:control control))
    (_ (display "Usage: guile -L scheme scheme/widget.scm SOCKET [--control PRIVATE_SOCKET]\n" (current-error-port)) (exit 2))))
