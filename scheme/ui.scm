(define-module (ui)
  #:use-module (json)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:export (make-ui-client ui-connect! ui-close! ui-patch! ui-inspect! ui-subscribe!
            ui-receive ui-send! ui-session-id ui-epoch ui-seq ui-applied-seq ui-channel ui-port
            ui-field ui-reader ui-read-json ui-write-json!))

(define limit 1048576)
(define unchanged (gensym))
(define (ui-field value key) (or (assoc-ref value key) (assq-ref value (string->symbol key))))
(define (require value message) (unless value (error message)))
(define (monotonic-us) (quotient (* (get-internal-real-time) 1000000) internal-time-units-per-second))
(define (epoch-now) (let ((time (gettimeofday))) (+ (* (car time) 1000000) (cdr time))))
(define (slice bytes start end)
  (let ((result (make-bytevector (- end start)))) (bytevector-copy! bytes start result 0 (- end start)) result))
(define (join-bytes left right count)
  (let* ((length (bytevector-length left)) (result (make-bytevector (+ length count))))
    (bytevector-copy! left 0 result 0 length) (bytevector-copy! right 0 result length count) result))
(define (newline-index bytes)
  (let loop ((index 0)) (and (< index (bytevector-length bytes))
                           (if (= 10 (bytevector-u8-ref bytes index)) index (loop (+ index 1))))))

(define-record-type <wire>
  (make-wire port pending) wire?
  (port wire-port) (pending wire-pending set-wire-pending!))
(define (ui-reader port)
  (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL)))
  (make-wire port (make-bytevector 0)))

(define-record-type <ui-client>
  (%make-ui path channel nodes data committed-nodes committed-data pending applied epoch seq wire session) ui-client?
  (path ui-path) (channel ui-channel) (nodes ui-nodes set-ui-nodes!) (data ui-data set-ui-data!)
  (committed-nodes ui-committed-nodes set-ui-committed-nodes!)
  (committed-data ui-committed-data set-ui-committed-data!) (pending ui-pending set-ui-pending!)
  (applied ui-applied-seq set-ui-applied!)
  (epoch ui-epoch set-ui-epoch!) (seq ui-seq set-ui-seq!)
  (wire ui-wire set-ui-wire!) (session ui-session-id set-ui-session!))

(define (make-ui-client path channel nodes data)
  (require (and (string? path) (string? channel) (> (string-length channel) 0) (vector? nodes)) "Invalid UI client arguments")
  (%make-ui path channel nodes data nodes data '() 0 0 0 #f #f))
(define (ui-port client) (and (ui-wire client) (wire-port (ui-wire client))))
(define (ready? port write? deadline)
  (let* ((left (max 0 (- deadline (monotonic-us))))
         (ready (select (if write? '() (list port)) (if write? (list port) '()) '()
                        (quotient left 1000000) (modulo left 1000000))))
    (pair? (if write? (cadr ready) (car ready)))))
(define (would-block thunk)
  (catch 'system-error thunk
    (lambda (key . arguments)
      (if (memv (system-error-errno (cons key arguments)) (list EAGAIN EWOULDBLOCK EINTR))
          #f (apply throw key arguments)))))

(define (ui-write-json! port value)
  (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL)))
  (let* ((bytes (string->utf8 (scm->json-string value))) (size (bytevector-length bytes))
         (deadline (+ (monotonic-us) 2000000)))
    (require (<= size limit) "UI message exceeds 1 MiB")
    (let ((line (make-bytevector (+ size 1))))
      (bytevector-copy! bytes 0 line 0 size) (bytevector-u8-set! line size 10)
      (let loop ((offset 0))
        (unless (= offset (+ size 1))
          (require (< (monotonic-us) deadline) "UI write timed out")
          (require (ready? port #t deadline) "UI write timed out")
          (let ((count (would-block (lambda () (send port (slice line offset (+ size 1)) 0)))))
            (when count (require (> count 0) "UI socket closed during write"))
            (loop (+ offset (or count 0)))))))))

(define (parse-json bytes)
  (let ((text (utf8->string bytes)))
    (require (equal? bytes (string->utf8 text)) "Invalid UI UTF-8")
    (call-with-input-string text
      (lambda (port)
        (let ((value (json->scm port)))
          (let trailing ()
            (let ((char (read-char port)))
              (unless (eof-object? char) (require (char-whitespace? char) "Trailing UI JSON") (trailing))))
          (require (list? value) "UI reply must be an object") value)))))

(define* (ui-read-json wire #:optional (timeout 2))
  (let ((deadline (+ (monotonic-us) (inexact->exact (round (* timeout 1000000)))))
        (buffer (make-bytevector 8192)))
    (let loop ()
      (let* ((pending (wire-pending wire)) (end (newline-index pending)))
        (cond
          (end
           (require (<= end limit) "UI message exceeds 1 MiB")
           (set-wire-pending! wire (slice pending (+ end 1) (bytevector-length pending)))
           (parse-json (slice pending 0 end)))
          ((or (and (> timeout 0) (>= (monotonic-us) deadline))
               (not (ready? (wire-port wire) #f deadline)))
           (unless (= timeout 0)
             (require (= 0 (bytevector-length pending)) "UI partial message timed out"))
           #f)
          (else
           (let ((count (would-block (lambda () (recv! (wire-port wire) buffer 0)))))
             (when count
               (require (> count 0) "UI renderer disconnected")
               (let ((next (join-bytes pending buffer count)))
                 (require (<= (bytevector-length next) (+ limit 8192)) "UI message exceeds 1 MiB")
                 (set-wire-pending! wire next)))
             (loop))))))))

(define (rollback! client)
  (set-ui-pending! client '())
  (set-ui-nodes! client (ui-committed-nodes client))
  (set-ui-data! client (ui-committed-data client)))
(define (ui-close! client)
  (rollback! client)
  (when (ui-wire client)
    (catch #t (lambda () (close-port (ui-port client))) (lambda _ #f)))
  (set-ui-wire! client #f))
(define (ui-send! client value)
  (require (ui-port client) "UI client is disconnected")
  (catch #t
    (lambda () (ui-write-json! (ui-port client) value))
    (lambda (key . arguments) (ui-close! client) (apply throw key arguments))))
(define* (ui-receive client #:key (timeout 2))
  (require (ui-wire client) "UI client is disconnected")
  (let ((message (ui-read-json (ui-wire client) timeout)))
    (when (and message (equal? (ui-field message "type") "ack")
               (equal? (ui-field message "channel") (ui-channel client))
               (equal? (ui-field message "epoch") (ui-epoch client)))
      (let ((candidate (assv (ui-field message "seq") (ui-pending client))))
        (when candidate
          (cond
            ((equal? (ui-field message "status") "applied")
             (set-ui-committed-nodes! client (cadr candidate))
             (set-ui-committed-data! client (caddr candidate))
             (set-ui-applied! client (car candidate))
             (set-ui-pending! client (filter (lambda (entry) (> (car entry) (car candidate))) (ui-pending client))))
            ((equal? (ui-field message "status") "rejected") (rollback! client))))))
    message))

(define (ui-connect! client)
  (ui-close! client)
  (let ((port (socket AF_UNIX SOCK_STREAM 0)))
    (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL)))
    (set-ui-wire! client (make-wire port (make-bytevector 0)))
    (catch #t
      (lambda ()
        (catch 'system-error (lambda () (connect port AF_UNIX (ui-path client)))
          (lambda (key . arguments)
            (unless (= EINPROGRESS (system-error-errno (cons key arguments))) (apply throw key arguments))
            (require (ready? port #t (+ (monotonic-us) 2000000)) "UI connect timed out")
            (require (= 0 (getsockopt port SOL_SOCKET SO_ERROR)) "UI connection failed")))
        (ui-send! client '((type . "hello") (major . 2) (capabilities . #("channels" "patch" "inspect" "input"))))
        (let ((hello (ui-receive client)))
          (require (and hello (equal? (ui-field hello "type") "hello") (equal? (ui-field hello "major") 2)
                        (string? (ui-field hello "session_id")) (vector? (ui-field hello "capabilities")))
                   "Renderer does not support UI protocol v2")
          (require (every (lambda (capability) (member capability (vector->list (ui-field hello "capabilities"))))
                          '("channels" "patch" "inspect" "input")) "Renderer is missing required UI capabilities")
          (set-ui-session! client (ui-field hello "session_id")))
        (let ((epoch (max (+ 1 (ui-epoch client)) (epoch-now))))
          (require (<= epoch 18446744073709551615) "UI epoch exhausted")
          (set-ui-epoch! client epoch))
        (set-ui-seq! client 1)
        (set-ui-applied! client 0)
        (set-ui-pending! client (list (list 1 (ui-nodes client) (ui-data client))))
        (ui-send! client `((type . "baseline") (channel . ,(ui-channel client)) (epoch . ,(ui-epoch client))
                          (seq . ,(ui-seq client)) (nodes . ,(ui-nodes client)) (data . ,(ui-data client))))
        (ui-session-id client))
      (lambda (key . arguments) (ui-close! client) (apply throw key arguments)))))

(define* (ui-patch! client upsert remove #:key (data unchanged))
  (require (and (vector? upsert) (vector? remove)) "UI patch needs arrays")
  (require (< (length (ui-pending client)) 32) "UI has 32 pending transactions; await acknowledgements")
  (let* ((updates (vector->list upsert))
         (retained (filter (lambda (node) (not (member (ui-field node "key") (vector->list remove))))
                           (vector->list (ui-nodes client))))
         (existing (map (lambda (node) (ui-field node "key")) retained)))
    (set-ui-nodes! client
      (list->vector
        (append (map (lambda (node)
                       (or (find (lambda (update) (equal? (ui-field node "key") (ui-field update "key"))) updates) node))
                     retained)
                (filter (lambda (node) (not (member (ui-field node "key") existing))) updates)))))
  (unless (eq? data unchanged) (set-ui-data! client data))
  (require (< (ui-seq client) 18446744073709551615) "UI sequence exhausted; reconnect for a fresh epoch")
  (set-ui-seq! client (+ 1 (ui-seq client)))
  (set-ui-pending! client (append (ui-pending client) (list (list (ui-seq client) (ui-nodes client) (ui-data client)))))
  (ui-send! client (append `((type . "patch") (channel . ,(ui-channel client)) (epoch . ,(ui-epoch client))
                            (seq . ,(ui-seq client)) (upsert . ,upsert) (remove . ,remove))
                          (if (eq? data unchanged) '() `((data . ,data))))))
(define (ui-inspect! client request-id)
  (ui-send! client `((type . "inspect") (channel . ,(ui-channel client)) (request_id . ,request-id))))
(define (ui-subscribe! client channel)
  (ui-send! client `((type . "subscribe") (channel . ,channel))))
