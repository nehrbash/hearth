(use-modules (hearth)
             (activity)
             (ice-9 match)
             (ice-9 popen)
             (ice-9 textual-ports)
             (rnrs bytevectors))

(define (command-output . arguments)
  (let ((port (apply open-pipe* OPEN_READ "timeout" "5" "weft" arguments))
        (status #f)
        (text #f))
    (dynamic-wind
      (lambda () #t)
      (lambda () (set! text (get-string-n port 1048577)))
      (lambda () (set! status (close-pipe port))))
    (unless (zero? status) (error "Weft export failed" arguments status))
    (unless (and (string? text)
                 (<= (bytevector-length (string->utf8 text)) 1048576))
      (error "Weft export exceeds 1 MiB" arguments))
    text))

(define (read-value text)
  (call-with-input-string text
    (lambda (port)
      (let ((value (read port)))
        (unless (eof-object? (read port)) (error "Unexpected trailing Weft data"))
        value))))

(define (workspace-generation)
  (let* ((reply (read-value (command-output "workspace-eval" "(workspace-state)")))
         (value (and (list? reply) (assq-ref reply 'value))))
    (unless (and (eq? 'ok (assq-ref reply 'status)) (string? value))
      (error "Cannot inspect the isolated workspace" reply))
    (let ((generation (assq-ref (read-value value) 'generation)))
      (unless (string? generation) (error "Workspace has no generation"))
      generation)))

(define (clock-revision)
  (let ((now (gettimeofday))) (+ (* 1000000 (car now)) (cdr now))))

(define (socket-identity path)
  (let ((info (stat path)))
    (unless (eq? 'socket (stat:type info)) (error "Hearth path is not a socket" path))
    (cons (stat:dev info) (stat:ino info))))

(define (run path once? initial-revision include-activity?)
  (let ((previous #f)
        (revision initial-revision)
        (sent-socket #f)
        (pending? #t))
    (define (update!)
      (let* ((generation (workspace-generation))
             (owner-json (command-output "owner" "view"))
             (confirmed-generation (workspace-generation))
             (zones (hearth-owner-snapshot owner-json generation 0))
             (content (if include-activity?
                          (acons 'activity (hearth-activity) zones)
                          zones))
             (identity (socket-identity path)))
        (unless (equal? generation confirmed-generation)
          (error "Workspace restarted during export; retry the snapshot"))
        (unless (equal? content previous)
          (set! revision (max (+ revision 1) (clock-revision)))
          (set! previous content)
          (set! pending? #t))
        (when (or pending? (not (equal? identity sent-socket)))
          (let ((bytes (hearth-send! path
                         (map (lambda (entry)
                                (if (eq? 'revision (car entry))
                                    (cons 'revision revision)
                                    entry)) content))))
            (set! sent-socket identity)
            (set! pending? #f)
            (format #t "sent revision ~a (~a bytes) from ~a~%" revision bytes generation)
            (force-output)))))
    (let loop ()
      (let ((ok? (catch #t
                   (lambda () (update!) #t)
                   (lambda (key . arguments)
                     (set! pending? #t)
                     (format (current-error-port) "Hearth producer: ~s ~s~%" key arguments)
                     #f))))
        (if once?
            (exit (if ok? 0 1))
            (begin (sleep 1) (loop)))))))

(define include-activity? (member "--activity" (cdr (command-line))))
(match (filter (lambda (arg) (not (string=? arg "--activity"))) (cdr (command-line)))
  ((path) (run path #f (clock-revision) include-activity?))
  ((path "--once") (run path #t (clock-revision) include-activity?))
  ((path "--revision" base)
   (let ((revision (string->number base)))
     (unless (and (integer? revision) (exact? revision) (<= 0 revision 18446744073709551614))
       (error "Revision base must fit below the unsigned 64-bit maximum"))
     (run path #f revision include-activity?)))
  (_ (display "Usage: guile -L scheme scheme/live.scm SOCKET [--once | --revision BASE] [--activity]\n"
              (current-error-port))
     (exit 2)))
