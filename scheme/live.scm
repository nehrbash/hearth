(use-modules (hearth) (activity) (ui) (weft-watch)
             (ice-9 match) (ice-9 popen) (ice-9 textual-ports)
             (srfi srfi-1) (rnrs bytevectors))

(define (owner-zones)
  (let ((port (open-pipe* OPEN_READ "timeout" "--kill-after=1" "10" "weft" "owner" "view"))
        (status #f) (text #f))
    (dynamic-wind (lambda () #t)
      (lambda () (set! text (get-string-n port 1048577)))
      (lambda () (set! status (close-pipe port))))
    (unless (and (zero? status) (string? text) (<= (bytevector-length (string->utf8 text)) 1048576))
      (error "Weft view unavailable"))
    text))

(define (snapshot activity?)
  (let* ((before (watch-command "workspace-eval" '(workspace-state)))
         (generation (assq-ref before 'generation))
         (zones (hearth-owner-snapshot (owner-zones) generation 0))
         (content (if activity? (acons 'activity (hearth-activity) zones) zones))
         (after (watch-command "workspace-eval" '(workspace-state))))
    (unless (equal? generation (assq-ref after 'generation)) (error "Workspace restarted during export"))
    content))

(define (run path once? activity?)
  (let* ((subscriber (string->symbol (format #f "hearth-ui-~a" (getpid))))
         (endpoints '("eval"))
         (files (watch-state-paths activity?))
         (watcher (watch-open (cons (dirname path) (map dirname files))))
         (client (make-ui-client path "weft" #() 'null))
         (fingerprints '()) (content #f) (identities '()) (stopping? #f) (pending? #f))
    (define (register!)
      (set! identities
        (map (lambda (endpoint)
               (let ((reply (watch-register! endpoint subscriber)))
                 (list endpoint (assq-ref reply 'generation) 0))) endpoints)))
    (define (refresh! isolated-changed?)
      (when isolated-changed?
        (watch-command "eval" '(event-emit! 'hearth-workspace-changed 'isolated #:source 'hearth)))
      (for-each
        (lambda (identity)
          (let ((reply (watch-notices (car identity) subscriber (caddr identity))))
            (if (equal? (assq-ref reply 'generation) (cadr identity))
                (let ((notices (assq-ref reply 'notices)))
                  (unless (null? notices)
                    (set-car! (cddr identity) (apply max (map (lambda (notice) (assq-ref notice 'id)) notices)))))
                (begin (watch-register! (car identity) subscriber)
                       (set-car! (cdr identity) (assq-ref reply 'generation))
                       (set-car! (cddr identity) 0))))) identities)
      ;; The baseline also covers a bounded notice history gap.
      (let ((next (snapshot activity?)))
        (unless (equal? next content)
          (set! content next)
          (when (ui-port client) (ui-patch! client #() #() #:data content)))))
    (sigaction SIGTERM (lambda (_) (set! stopping? #t)))
    (sigaction SIGINT (lambda (_) (set! stopping? #t)))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (register!)
        (set! fingerprints (map watch-fingerprint files))
        (set! content (snapshot activity?))
        (set! client (make-ui-client path "weft" #() content))
        (ui-connect! client)
        (if once?
            (let ((ack (ui-receive client)))
              (unless (equal? (ui-field ack "status") "applied") (error "Weft baseline rejected" ack)))
            (let loop ()
              (unless stopping?
                (catch #t
                  (lambda ()
                    (when pending?
                      (let ((next (map watch-fingerprint files)))
                        (refresh! (not (equal? (car next) (car fingerprints))))
                        (set! fingerprints next)
                        (set! pending? #f)))
                    (unless (ui-port client)
                      (set! client (make-ui-client path "weft" #() content))
                      (ui-connect! client))
                    (let drain ()
                      (let ((reply (ui-receive client #:timeout 0)))
                        (when reply
                          (when (equal? (ui-field reply "status") "rejected")
                            (error "Renderer rejected Weft update" reply))
                          (drain))))
                    (let ((ready (select (list watcher (ui-port client)) '() '() 30)))
                      (when (memq watcher (car ready))
                        (watch-drain! watcher)
                        (let ((next (map watch-fingerprint files)))
                          (unless (equal? next fingerprints)
                            (set! pending? #t))))))
                  (lambda (key . arguments)
                    (unless stopping?
                      (format (current-error-port) "Hearth Weft adapter: ~a; reconnecting~%" key)
                      (set! pending? #t)
                      (ui-close! client)
                      (select (list watcher) '() '() 0 250000))))
                (loop)))))
      (lambda ()
        (for-each (lambda (endpoint)
                    (catch #t (lambda () (watch-remove! endpoint subscriber)) (lambda _ #f))) endpoints)
        (ui-close! client) (close-port watcher)))))

(let* ((args (cdr (command-line))) (activity? (member "--activity" args))
       (once? (member "--once" args))
       (paths (filter (lambda (arg) (not (member arg '("--activity" "--once")))) args)))
  (match paths
    ((path) (run path once? activity?))
    (_ (display "Usage: guile -L scheme scheme/live.scm SOCKET [--once] [--activity]\n" (current-error-port)) (exit 2))))
