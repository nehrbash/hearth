(define-module (bluetooth-ui)
  #:use-module (ui)
  #:use-module (services)
  #:use-module (json)
  #:use-module (ice-9 match)
  #:use-module (ice-9 popen)
  #:use-module (rnrs bytevectors)
  #:use-module ((rnrs io ports) #:select (get-bytevector-some put-bytevector))
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-13)
  #:export (make-bluetooth-ui bluetooth-nodes bluetooth-data bluetooth-message!
            bluetooth-activate! bluetooth-input! bluetooth-disconnected! bluetooth-expire!
            bluetooth-challenge bluetooth-entry run-bluetooth-ui))

(define-record-type <bluetooth-ui>
  (%make-ui envelope challenge entry keyboard adapter-page device-page pending serial status buttons watermark)
  bluetooth-ui?
  (envelope envelope set-envelope!) (challenge bluetooth-challenge set-challenge!)
  (entry bluetooth-entry set-entry!) (keyboard keyboard set-keyboard!)
  (adapter-page adapter-page set-adapter-page!) (device-page device-page set-device-page!)
  (pending pending set-pending!) (serial serial set-serial!) (status status set-status!)
  (buttons buttons set-buttons!) (watermark watermark set-watermark!))
(define (make-bluetooth-ui)
  (%make-ui #f #f "" 0 0 0 #f 0 "Waiting for Bluetooth worker" '() -1))
(define (field value key) (and (list? value) (ui-field value key)))
(define (now-ms) (let ((now (gettimeofday))) (+ (* 1000 (car now)) (quotient (cdr now) 1000))))
(define (inventory model key)
  (let ((value (field (field (envelope model) "state") key)))
    (if (vector? value) (vector->list value) '())))
(define (owner model) (field (field (envelope model) "state") "owner"))
(define (short text n)
  (let ((value (if (string? text) (string-join (string-tokenize text) " ") "Unknown")))
    (if (> (string-length value) n) (string-append (substring value 0 (- n 1)) "…") value)))
(define (bluetooth-data model)
  `((sensitive . #t) (service . "bluetooth") (status . ,(or (field (envelope model) "status") "unavailable"))))
(define (clear-challenge! model)
  (set-challenge! model #f) (set-entry! model "") (set-keyboard! model 0))
(define (bluetooth-disconnected! model send)
  (when (or (pending model) (bluetooth-challenge model)) (send '((type . "cancel"))))
  (clear-challenge! model) (set-pending! model #f)
  (set-status! model "Cancellation requested; inspect current device state"))
(define (bluetooth-expire! model send timestamp)
  (when (and (bluetooth-challenge model)
             (>= timestamp (field (bluetooth-challenge model) "deadline_ms")))
    (bluetooth-disconnected! model send)
    (set-status! model "Pairing prompt expired")))
(define (bluetooth-message! model message send)
  (cond
    ((equal? (field message "service") "bluetooth")
     (hearth-service-decode (scm->json-string message))
     (when (and (or (pending model) (bluetooth-challenge model))
                (not (equal? (owner model) (field (field message "state") "owner"))))
       (bluetooth-disconnected! model send))
     (when (or (not (envelope model))
               (equal? (field message "status") "unavailable")
               (equal? (field (envelope model) "status") "unavailable"))
       (unless (pending model)
         (set-status! model (if (equal? (field message "status") "available") "Bluetooth available"
                                (string-append "Bluetooth unavailable: " (short (field message "error") 52))))))
     (set-envelope! model message))
    ((equal? (field message "type") "challenge")
     (let ((kind (field message "kind")) (deadline (field message "deadline_ms"))
           (id (field message "challenge_id")))
       (if (or (not (pending model))
               (not (equal? (field message "request_id") (assoc-ref (pending model) 'id)))
               (and (integer? id) (<= id (watermark model))
                    (not (and (bluetooth-challenge model) (= id (field (bluetooth-challenge model) "challenge_id"))))))
           #f
       (if (not (and (pending model) (equal? (assoc-ref (pending model) 'kind) "pair") (equal? (field message "owner") (owner model))
                    (equal? (field message "device") (assoc-ref (pending model) 'path))
                    (member kind '("pin" "passkey" "confirmation" "authorization" "display_pin" "display_passkey" "authorize_service"))
                    (integer? id) (exact? id) (<= 0 id 18446744073709551615)
                    (integer? deadline) (exact? deadline) (> deadline (now-ms))
                    (<= deadline (+ (now-ms) 31000))
                    (or (> id (watermark model))
                        (and (bluetooth-challenge model) (= id (field (bluetooth-challenge model) "challenge_id"))))))
         (bluetooth-disconnected! model send)
         (begin
       (for-each (lambda (key)
                   (let ((value (field message key)))
                     (unless (or (eq? value 'null) (and (string? value) (<= (string-length value) 256)))
                       (error "Invalid Bluetooth challenge text")))) '("pin" "uuid"))
       (let ((passkey (field message "passkey")))
         (unless (or (eq? passkey 'null) (and (integer? passkey) (exact? passkey) (<= 0 passkey 999999)))
           (error "Invalid Bluetooth challenge passkey")))
       (when (member kind '("confirmation" "display_passkey"))
         (unless (integer? (field message "passkey")) (error "Missing confirmation passkey")))
       (when (equal? kind "display_pin")
         (let ((pin (field message "pin")))
           (unless (and (string? pin) (<= 1 (string-length pin) 16)
                        (string-every (lambda (char) (<= 32 (char->integer char) 126)) pin))
             (error "Invalid displayed PIN"))))
       (when (equal? kind "authorize_service")
         (let ((uuid (field message "uuid")))
           (unless (and (string? uuid) (= (string-length uuid) 36)
                        (every (lambda (i)
                                 (if (memv i '(8 13 18 23)) (char=? (string-ref uuid i) #\-)
                                     (string-index "0123456789abcdefABCDEF" (string-ref uuid i)))) (iota 36)))
             (error "Invalid service UUID"))))
       (let ((entered (field message "entered")))
         (unless (or (eq? entered 'null) (and (integer? entered) (exact? entered) (<= 0 entered 6)))
           (error "Invalid passkey entry progress")))
       (unless (bluetooth-challenge model) (set-entry! model "") (set-keyboard! model 0))
       (set-watermark! model id)
       (set-challenge! model message))))))
    ((equal? (field message "type") "result")
     (when (equal? (field message "request_id") (and (pending model) (assoc-ref (pending model) 'id)))
       (set-status! model (if (equal? (field message "status") "executed") "Action completed" "Action rejected"))
       (set-pending! model #f) (clear-challenge! model)))
    ((equal? (field message "type") "reply_rejected")
     (set-status! model "Pairing reply rejected; cancel or try again"))
    (else (error "Unexpected Bluetooth worker message"))))

(define (label key x y w h text size)
  `((key . ,key) (kind . "text") (order . 2) (bounds . ,(vector x y w h))
    (text . ,text) (font_size . ,size) (color . #(0.92 0.94 0.98 1))))
(define (bluetooth-nodes model)
  (let ((nodes (list '((key . "background") (kind . "rect") (bounds . #(0 0 720 760)) (color . #(0.025 0.035 0.055 1)))))
        (actions '()))
    (define (add node) (set! nodes (append nodes (list node))))
    (define (text key x y w h value size) (add (label key x y w h value size)))
    (define (button key caption x y w action)
      (set! actions (acons key action actions))
      (add `((key . ,key) (kind . "group") (order . 3) (bounds . ,(vector 0 0 w 36))
             (offset . ,(vector x y)) (input . #t) (transitions . ((offset . 80)))
             (states . ((hover . ((offset . ,(vector x (- y 1))))) (pressed . ((offset . ,(vector x (+ y 1)))))))))
      (add `((key . ,(string-append key "-bg")) (parent . ,key) (kind . "rect")
             (bounds . ,(vector 0 0 w 36)) (color . #(0.13 0.23 0.32 1))))
      (add `((key . ,(string-append key "-text")) (parent . ,key) (kind . "text") (order . 1)
             (bounds . ,(vector 8 7 (- w 16) 24)) (text . ,caption) (font_size . 15) (color . #(0.94 0.96 1 1)))))
    (text "title" 24 20 672 36 "Bluetooth" 28)
    (text "status" 24 64 672 30 (short (status model) 80) 16)
    (if (bluetooth-challenge model)
        (let* ((challenge (bluetooth-challenge model)) (kind (field challenge "kind"))
               (entry? (member kind '("pin" "passkey")))
               (characters (if (equal? kind "passkey") "0123456789"
                               (list-ref '("abcdefghijklmnopqrstuvwxyz0123456789"
                                           "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
                                           " !\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~") (keyboard model)))))
          (text "prompt-kind" 24 108 672 30 (string-append "Pairing: " kind) 22)
          (let ((device (find (lambda (device) (equal? (field device "path") (field challenge "device")))
                              (inventory model "devices"))))
            (text "prompt-device" 24 148 672 50
                  (if device (string-append (short (field device "alias") 55) "\n" (short (field device "address") 55))
                      "Device no longer observed") 16))
          (text "prompt-detail" 24 205 672 55
                (cond ((member kind '("confirmation" "display_passkey"))
                       (string-append (format #f "Passkey: ~6,'0d" (field challenge "passkey"))
                                      (let ((entered (field challenge "entered")))
                                        (if (integer? entered) (format #f " (~a/6 entered)" entered) ""))))
                      ((equal? kind "display_pin") (string-append "PIN: " (object->string (field challenge "pin"))))
                      ((equal? kind "authorize_service") (string-append "Service: " (short (field challenge "uuid") 60)))
                      (entry? "Enter the code shown or required by your device.")
                      (else "Allow this device to pair?")) 19)
          (when entry?
            (text "entry" 24 270 672 35 (string-append "Entered: " (make-string (string-length (bluetooth-entry model)) #\*)) 24)
            (for-each (lambda (index)
                        (let ((char (string-ref characters index)))
                          (button (format #f "char-~a" index) (if (char=? char #\space) "Space" (string char))
                                  (+ 24 (* 67 (modulo index 10))) (+ 325 (* 46 (quotient index 10))) 61
                                  (list 'char char)))) (iota (string-length characters)))
            (unless (equal? kind "passkey")
              (button "keyboard" "abc / ABC / symbols" 24 520 225 '(keyboard)))
            (button "clear" "Clear" 265 520 100 '(clear))
            (button "backspace" "Backspace" 381 520 135 '(backspace)))
          (button "reject" "Reject" 24 590 180 '(reject))
          (button "submit" (if entry? "Submit code" "Accept") 228 590 220 '(reply))
          (text "prompt-warning" 24 650 672 70 "Pair only with a device you recognize. Prompts expire." 16))
        (begin
          (let ((adapters (inventory model "adapters")))
            (if (null? adapters) (text "adapters-empty" 24 108 672 30 "No Bluetooth adapters" 20)
                (let* ((index (min (adapter-page model) (- (length adapters) 1))) (adapter (list-ref adapters index)))
                  (text "adapter" 24 108 672 30
                        (format #f "~a — ~a (~a/~a)" (short (field adapter "alias") 30)
                                (if (field adapter "powered") "On" "Off") (+ index 1) (length adapters)) 20)
                  (unless (pending model)
                    (button "power" (if (field adapter "powered") "Power off" "Power on") 24 150 140
                            (list 'action (field adapter "path") `((action . "power") (value . ,(not (field adapter "powered"))))))
                    (button "scan" (if (field adapter "discovering") "Stop scan" "Scan") 180 150 140
                            (list 'action (field adapter "path") `((action . "discovery") (value . ,(not (field adapter "discovering")))))))
                  (when (> (length adapters) 1) (button "adapter-next" "Next adapter" 336 150 160 '(adapter-next))))))
          (let* ((devices (inventory model "devices")) (pages (max 1 (ceiling (/ (length devices) 3))))
                 (page (min (device-page model) (- pages 1))) (start (* page 3))
                 (visible (take (drop devices start) (min 3 (- (length devices) start)))))
            (when (null? devices) (text "devices-empty" 24 225 672 35 "No devices observed. Scan to discover devices." 20))
            (for-each
              (lambda (device index)
                (let ((y (+ 220 (* 120 index))) (path (field device "path")))
                  (text (format #f "device-~a" index) 24 y 672 30
                        (format #f "~a — ~a; ~a" (short (field device "alias") 32)
                                (if (field device "connected") "Connected" "Disconnected")
                                (if (field device "paired") "Paired" "Unpaired")) 18)
                  (text (format #f "address-~a" index) 24 (+ y 30) 672 24 (short (field device "address") 50) 14)
                  (unless (pending model)
                    (for-each
                      (lambda (action number)
                        (button (format #f "device-~a-~a" index number) (car action)
                                (+ 24 (* 168 number)) (+ y 60) 156 (list 'action path (cdr action))))
                      (list (cons (if (field device "connected") "Disconnect" "Connect")
                                  `((action . ,(if (field device "connected") "disconnect" "connect"))))
                            '("Pair" (action . "pair"))
                            (cons (if (field device "trusted") "Untrust" "Trust")
                                  `((action . "trust") (value . ,(not (field device "trusted")))))
                            '("Remove" (action . "remove"))) (iota 4))))) visible (iota (length visible)))
            (text "page" 24 610 672 26 (format #f "Devices ~a–~a of ~a; ~a more" (if (null? devices) 0 (+ start 1))
                                                               (+ start (length visible)) (length devices)
                                                               (- (length devices) (length visible))) 16)
            (when (> pages 1)
              (button "previous" "Previous" 24 648 140 '(previous))
              (button "next" "Next" 180 648 140 '(next))))
          (when (pending model) (button "cancel" "Cancel action" 400 648 210 '(cancel)))
          (text "footer" 24 710 672 28 "Actions require your click. Pairing asks for confirmation." 14)))
    (set-buttons! model actions)
    (list->vector nodes)))

(define (bluetooth-activate! model key send)
  (let ((action (assoc-ref (buttons model) key)))
    (match action
      (('action path payload)
       (unless (or (pending model) (bluetooth-challenge model))
         (set-serial! model (+ 1 (serial model)))
         (let ((id (number->string (serial model))))
           (set-pending! model `((id . ,id) (path . ,path) (kind . ,(field payload "action"))))
           (send `((type . "action") (request_id . ,id)
                   (request . ((owner . ,(owner model)) (path . ,path) (action . ,payload)))))
           (set-status! model "Action pending"))))
      (('char char)
       (when (bluetooth-challenge model)
         (let ((limit (if (equal? (field (bluetooth-challenge model) "kind") "passkey") 6 16)))
           (when (< (string-length (bluetooth-entry model)) limit)
             (set-entry! model (string-append (bluetooth-entry model) (string char)))))))
      (('keyboard) (set-keyboard! model (modulo (+ 1 (keyboard model)) 3)))
      (('clear) (set-entry! model ""))
      (('backspace) (set-entry! model (substring (bluetooth-entry model) 0 (max 0 (- (string-length (bluetooth-entry model)) 1)))))
      (('reject)
       (when (bluetooth-challenge model)
         (send `((type . "reply") (challenge_id . ,(field (bluetooth-challenge model) "challenge_id")) (reply . ((kind . "reject")))))
         (clear-challenge! model)))
      (('reply)
       (when (bluetooth-challenge model)
         (let* ((kind (field (bluetooth-challenge model) "kind")) (entry (bluetooth-entry model))
                (reply (cond ((equal? kind "pin") (and (> (string-length entry) 0) `((kind . "pin") (value . ,entry))))
                             ((equal? kind "passkey") (and (> (string-length entry) 0) `((kind . "passkey") (value . ,(string->number entry)))))
                             (else '((kind . "accept"))))))
           (if reply
               (begin (send `((type . "reply") (challenge_id . ,(field (bluetooth-challenge model) "challenge_id")) (reply . ,reply)))
                      (clear-challenge! model) (set-status! model "Pairing reply sent; waiting for result"))
               (set-status! model "Enter a code before submitting")))))
      (('cancel) (bluetooth-disconnected! model send))
      (('adapter-next) (set-adapter-page! model (modulo (+ 1 (adapter-page model)) (max 1 (length (inventory model "adapters"))))))
      (('previous) (set-device-page! model (max 0 (- (device-page model) 1))))
      (('next) (set-device-page! model (+ 1 (device-page model))))
      (_ #f))))

(define (bluetooth-input! model message channel epoch applied sequence send)
  (when (and (equal? (field message "type") "input") (equal? (field message "channel") channel)
             (equal? (field message "epoch") epoch) (equal? (field message "seq") applied)
             (= applied sequence) (equal? (field message "event") "activate"))
    (bluetooth-activate! model (field message "key") send)))

(define (pipe-write! port value)
  (let ((bytes (string->utf8 (string-append (scm->json-string value) "\n")))
        (deadline (+ (now-ms) 2000)))
    (unless (<= (bytevector-length bytes) 16384) (error "Bluetooth worker request exceeds 16 KiB"))
    (let loop ((offset 0))
      (when (< offset (bytevector-length bytes))
        (unless (< (now-ms) deadline) (error "Bluetooth worker write timed out"))
        (let ((written? (catch 'system-error
                          (lambda () ((@ (rnrs io ports) put-u8) port (bytevector-u8-ref bytes offset)) #t)
                          (lambda (key . arguments)
                            (if (memv (system-error-errno (cons key arguments)) (list EAGAIN EWOULDBLOCK EINTR)) #f
                                (apply throw key arguments))))))
          (unless written? (select '() (list port) '() 0 10000))
          (loop (if written? (+ offset 1) offset)))))))

(define (pipe-reader port)
  (let ((pending (make-bytevector 0)))
    (lambda ()
     (let read-next ()
      (let ((newline (let loop ((i 0))
                       (and (< i (bytevector-length pending))
                            (if (= (bytevector-u8-ref pending i) 10) i (loop (+ i 1)))))))
        (if newline
            (let ((line (make-bytevector newline)) (rest (make-bytevector (- (bytevector-length pending) newline 1))))
              (bytevector-copy! pending 0 line 0 newline)
              (bytevector-copy! pending (+ newline 1) rest 0 (bytevector-length rest))
              (set! pending rest)
              (let ((text (utf8->string line)))
                (unless (equal? line (string->utf8 text)) (error "Invalid worker UTF-8"))
                (call-with-input-string text
                  (lambda (input)
                    (let ((value (json->scm input)))
                      (unless (eof-object? (read-char input)) (error "Trailing worker JSON")) value)))))
            (if (null? (car (select (list port) '() '() 0))) #f
                (let ((bytes (get-bytevector-some port)))
                  (when (eof-object? bytes) (error "Bluetooth worker stopped"))
                  (let ((length (+ (bytevector-length pending) (bytevector-length bytes))))
                    (unless (<= length 1048576) (error "Bluetooth worker message exceeds 1 MiB"))
                    (let ((joined (make-bytevector length)))
                      (bytevector-copy! pending 0 joined 0 (bytevector-length pending))
                      (bytevector-copy! bytes 0 joined (bytevector-length pending) (bytevector-length bytes))
                      (set! pending joined)))
                  (read-next)))))))))

(define* (run-bluetooth-ui path #:optional (worker "hearth-bluetooth"))
  (let* ((model (make-bluetooth-ui))
         ;; Guile's bidirectional popen wrapper has no selectable file descriptor.
         (process (call-with-values (lambda () ((@@ (ice-9 popen) open-process) OPEN_BOTH worker)) list))
         (port (car process)) (output (cadr process)) (pid (caddr process))
         (read-worker (pipe-reader port)) (connection #f) (keys '()) (dirty? #t))
    (define (send value) (pipe-write! output value))
    (for-each (lambda (stream)
                (setvbuf stream 'none)
                (fcntl stream F_SETFL (logior O_NONBLOCK (fcntl stream F_GETFL)))) (list port output))
    (sigaction SIGPIPE SIG_IGN)
    (sigaction SIGTERM (lambda (_) (throw 'quit 0)))
    (sigaction SIGINT (lambda (_) (throw 'quit 0)))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (let drain ()
            (let ((message (read-worker)))
              (when message (bluetooth-message! model message send) (set! dirty? #t) (drain))))
          (let ((before (bluetooth-challenge model)))
            (bluetooth-expire! model send (now-ms))
            (unless (eq? before (bluetooth-challenge model)) (set! dirty? #t)))
          (catch #t
            (lambda ()
              (unless connection
                (let ((nodes (bluetooth-nodes model)))
                  (set! keys (map (lambda (node) (field node "key")) (vector->list nodes)))
                  (set! connection (make-ui-client path "bluetooth" nodes (bluetooth-data model)))
                  (ui-connect! connection) (set! dirty? #f)))
              (let drain ()
                (let ((message (ui-receive connection #:timeout 0)))
                  (when message
                    (when (and (equal? (field message "type") "ack") (equal? (field message "status") "rejected"))
                      (error "Renderer rejected Bluetooth scene"))
                    (when (and (not dirty?) (equal? (field message "type") "input")
                               (equal? (field message "event") "activate"))
                      (bluetooth-input! model message "bluetooth" (ui-epoch connection)
                                        (ui-applied-seq connection) (ui-seq connection) send)
                      (set! dirty? #t))
                    (drain))))
              (when (and dirty? (= (ui-applied-seq connection) (ui-seq connection)))
                (let* ((nodes (bluetooth-nodes model)) (new-keys (map (lambda (node) (field node "key")) (vector->list nodes))))
                  (ui-patch! connection nodes (list->vector (lset-difference equal? keys new-keys)) #:data (bluetooth-data model))
                  (set! keys new-keys) (set! dirty? #f))))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (bluetooth-disconnected! model send)
              (when connection (ui-close! connection)) (set! connection #f) (set! dirty? #t)))
          (select (if (and connection (ui-port connection)) (list port (ui-port connection)) (list port)) '() '()
                  (if connection
                      (if (bluetooth-challenge model)
                          (max 0 (inexact->exact (ceiling (/ (- (field (bluetooth-challenge model) "deadline_ms") (now-ms)) 1000))))
                          30)
                      1))
          (loop)))
      (lambda ()
        (catch #t (lambda () (bluetooth-disconnected! model send)) (lambda _ #f))
        (when connection (ui-close! connection))
        (close-port output) (close-port port)
        (let wait ((remaining 300))
          (when (zero? (car (waitpid pid WNOHANG)))
            (if (zero? remaining)
                (begin (kill pid SIGKILL) (waitpid pid))
                (begin (usleep 10000) (wait (- remaining 1))))))))))

(when (string-suffix? "scheme/bluetooth-ui.scm" (car (command-line)))
  (match (cdr (command-line))
    ((path) (run-bluetooth-ui path))
    ((path worker) (run-bluetooth-ui path worker))
    (_ (display "Usage: guile -L scheme scheme/bluetooth-ui.scm SOCKET [WORKER]\n" (current-error-port)) (exit 2))))
