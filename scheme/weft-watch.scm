(define-module (weft-watch)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 textual-ports)
  #:use-module (rnrs bytevectors)
  #:use-module ((ice-9 binary-ports) #:select (get-bytevector-some!))
  #:use-module (srfi srfi-1)
  #:use-module (system foreign)
  #:export (watch-open watch-drain! watch-command watch-register! watch-remove!
            watch-notices watch-fingerprint watch-state-paths))

(define libc (dynamic-link))
(define init (pointer->procedure int (dynamic-func "inotify_init1" libc) (list int)))
(define add (pointer->procedure int (dynamic-func "inotify_add_watch" libc) (list int '* unsigned-int)))

(define (watch-open directories)
  (let ((fd (init O_NONBLOCK)))
    (when (< fd 0) (error "Cannot create workspace notification descriptor"))
    (let ((port (fdopen fd "r")))
      (catch #t
        (lambda ()
          (fcntl port F_SETFD FD_CLOEXEC)
          (for-each
            (lambda (directory)
              (when (< (add fd (string->pointer directory) #x388) 0)
                (error "Cannot watch workspace directory" directory)))
            (delete-duplicates directories))
          port)
        (lambda (key . args) (close-port port) (apply throw key args))))))

(define (watch-drain! port)
  (let ((bytes (make-bytevector 65536)))
    (let loop ()
      (catch 'system-error
        (lambda ()
          (when (pair? (car (select (list port) '() '() 0)))
            (let ((count (get-bytevector-some! port bytes 0 65536)))
              (unless (eof-object? count) (loop)))))
        (lambda (key . arguments)
          (unless (memv (system-error-errno (cons key arguments)) (list EAGAIN EWOULDBLOCK EINTR))
            (apply throw key arguments)))))))

(define (watch-command endpoint expression)
  (when (> (bytevector-length (string->utf8 (object->string expression))) 122880)
    (error "Weft publication exceeds the 120 KiB CLI argument budget"))
  (let ((port (open-pipe* OPEN_READ "timeout" "--kill-after=1" "10" "weft" endpoint (object->string expression)))
        (status #f) (text #f))
    (dynamic-wind
      (lambda () #t)
      (lambda () (set! text (get-string-n port 1048577)))
      (lambda () (set! status (close-pipe port))))
    (unless (and (zero? status) (string? text) (<= (bytevector-length (string->utf8 text)) 1048576))
      (error "Weft request failed or exceeded its limit"))
    (call-with-input-string text
      (lambda (port)
        (let ((reply (read port)))
          (unless (and (eof-object? (read port)) (eq? (assq-ref reply 'status) 'ok)
                       (not (assq-ref reply 'truncated))) (error "Weft rejected request"))
          (call-with-input-string (assq-ref reply 'value)
            (lambda (value-port)
              (let ((value (read value-port)))
                (unless (eof-object? (read value-port)) (error "Trailing Weft response"))
                value))))))))

(define (names subscriber)
  (map (lambda (suffix) (string->symbol (string-append (symbol->string subscriber) suffix)))
       '("-zones" "-changed" "-advice")))

(define* (watch-register! endpoint subscriber #:key (command watch-command))
  (let* ((ids (names subscriber)) (previous (car ids)) (handler (cadr ids)) (advice (caddr ids)))
    (command endpoint
      `(begin
         (saved-set! ',previous (zone-list))
         (saved-define! ',handler
           '(lambda (code)
              (let ((zones (zone-list)))
                (unless (equal? zones ,previous)
                  (set! ,previous zones)
                  (event-emit! 'hearth-workspace-changed 'zones)))))
         (advice-add! ',advice 'workspace-evaluate 'after ',handler)
         (watch! ',subscriber '(topic hearth-workspace-changed))
         ,@(if (string=? endpoint "eval")
               `((watch! ',subscriber '(provider codex)) (watch! ',subscriber '(provider claude))
                 (watch! ',subscriber '(topic terminal-released))) '())
         (list (cons 'generation (assq-ref (workspace-state) 'generation))
               (cons 'notices (notice-inbox ',subscriber 0)))))))

(define* (watch-remove! endpoint subscriber #:key (command watch-command))
  (let* ((ids (names subscriber)) (previous (car ids)) (handler (cadr ids)) (advice (caddr ids)))
    (command endpoint `(begin (advice-remove! ',advice) (unwatch! ',subscriber)
                              (saved-remove! ',handler) (saved-remove! ',previous) #t))
    (command endpoint `(begin (module-remove! (current-module) ',handler)
                              (module-remove! (current-module) ',previous) #t))))

(define* (watch-notices endpoint subscriber cursor #:key (command watch-command))
  (command endpoint `(list (cons 'generation (assq-ref (workspace-state) 'generation))
                           (cons 'notices (notice-inbox ',subscriber ,cursor)))))

(define (watch-fingerprint path)
  (catch 'system-error
    (lambda ()
      (if (eq? (stat:type (stat path)) 'socket)
          (list (stat:dev (stat path)) (stat:ino (stat path)))
          (call-with-input-file path
        (lambda (port)
          (let ((text (get-string-n port 16777217)))
            (when (> (string-length text) 16777216) (error "Workspace persistence exceeds 16 MiB"))
            text)))))
    (lambda (key . arguments)
      (if (= ENOENT (system-error-errno (cons key arguments))) #f (apply throw key arguments)))))

(define (watch-state-paths activity?)
  (let ((directory (string-append (or (getenv "XDG_STATE_HOME") (string-append (getenv "HOME") "/.local/state")) "/weft")))
    (append (list (or (getenv "HEARTH_WEFT_STATE") (string-append directory "/room.scm")))
            (if activity? (list (or (getenv "HEARTH_WEFT_TRUSTED_STATE") (string-append directory "/trusted.scm"))) '())
            (let ((runtime (if (getenv "XDG_RUNTIME_DIR") (string-append (getenv "XDG_RUNTIME_DIR") "/weft")
                               (string-append "/tmp/weft-" (number->string (getuid))))))
              (list (string-append runtime "/room.sock") (string-append runtime "/workspace.sock"))))))
