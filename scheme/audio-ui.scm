(define-module (audio-ui)
  #:use-module (ui)
  #:use-module (services)
  #:use-module (bluetooth-ui)
  #:use-module (bluetooth-audio)
  #:use-module (json)
  #:use-module (ice-9 match)
  #:use-module (ice-9 popen)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-13)
  #:export (make-audio-ui audio-message! audio-nodes audio-data audio-activate! audio-input!
            audio-disconnected! audio-volume audio-bluetooth-message! audio-tick! run-audio-ui))

(define (field value key) (and (list? value) (ui-field value key)))
(define (short text count)
  (let ((text (if (string? text) (string-join (string-tokenize text) " ") "Unknown")))
    (if (> (string-length text) count) (string-append (substring text 0 (- count 1)) "…") text)))
(define (audio-volume node)
  (let ((volumes (field node "channel_volumes_linear")))
    (and (vector? volumes) (> (vector-length volumes) 0)
         (/ (apply + (map (lambda (value) (expt value (/ 1 3))) (vector->list volumes))) (vector-length volumes)))))
(define-record-type <audio-ui>
  (%make-ui envelope pending serial view tab page status buttons bluetooth)
  audio-ui?
  (envelope envelope set-envelope!) (pending pending set-pending!) (serial serial set-serial!)
  (view view set-view!) (tab tab set-tab!) (page page set-page!)
  (status status set-status!) (buttons buttons set-buttons!) (bluetooth bluetooth set-bluetooth!))
(define (make-audio-ui) (%make-ui #f #f 0 0 "outputs" 0 "Waiting for PipeWire" '() (make-bluetooth-audio)))
(define (audio-data model) `((sensitive . #t) (service . "pipewire") (status . ,(or (field (envelope model) "status") "unavailable"))))
(define (audio-disconnected! model)
  (bluetooth-audio-cancel! (bluetooth model))
  (set-envelope! model #f) (set-buttons! model '())
  (set-pending! model #f) (set-view! model (+ 1 (view model)))
  (set-status! model "Disconnected; inspect state before another action"))
(define (now-ms) (quotient (* 1000 (get-internal-real-time)) internal-time-units-per-second))
(define (busy? model) (or (pending model) (bluetooth-audio-pending? (bluetooth model))))
(define (sync-bluetooth-status! model previous)
  (unless (equal? previous (bluetooth-audio-status (bluetooth model)))
    (set-status! model (bluetooth-audio-status (bluetooth model)))
    (set-view! model (+ 1 (view model))) (set-buttons! model '())))
(define (audio-tick! model now)
  (let ((previous (bluetooth-audio-status (bluetooth model))))
    (bluetooth-audio-tick! (bluetooth model) now) (sync-bluetooth-status! model previous)))
(define* (audio-bluetooth-message! model message #:optional (send-bluez (lambda _ #f)) (send-audio (lambda _ #f)) (now (now-ms)))
  (let ((previous (bluetooth-audio-status (bluetooth model))))
    (bluetooth-audio-update! (bluetooth model) "bluetooth" message send-bluez send-audio now)
    (set-view! model (+ 1 (view model))) (set-buttons! model '())
    (sync-bluetooth-status! model previous)))
(define* (audio-message! model message #:optional (send-audio (lambda _ #f)) (send-bluez (lambda _ #f)) (now (now-ms)))
  (let ((previous (bluetooth-audio-status (bluetooth model))))
    (bluetooth-audio-update! (bluetooth model) "pipewire" message send-bluez send-audio now)
    (sync-bluetooth-status! model previous))
  (cond
    ((equal? (field message "service") "pipewire")
     (hearth-service-decode (scm->json-string message))
     (let ((old-state (field (envelope model) "state")) (next (field message "state")))
       (unless (equal? old-state next) (set-view! model (+ 1 (view model))) (set-buttons! model '()))
       (unless (equal? (field old-state "session") (field next "session")) (set-pending! model #f)))
     (when (or (not (envelope model)) (equal? (field message "status") "unavailable")
               (equal? (field (envelope model) "status") "unavailable"))
       (set-status! model (if (equal? (field message "status") "available") "PipeWire connected"
                              (string-append "PipeWire unavailable: " (short (field message "error") 50)))))
     (set-envelope! model message))
    ((equal? (field message "type") "result")
     (when (equal? (field message "request_id") (pending model))
       (set-pending! model #f)
       (set-status! model (cond ((equal? (field message "status") "applied") "Change confirmed by PipeWire")
                                ((equal? (field message "status") "unknown") "Outcome unknown; inspect current state")
                                (else "Change rejected; refresh and try again")))))
    (else (error "Unexpected audio worker message"))))
(define (inventory model section)
  (let* ((value (field (field (envelope model) "state") "nodes"))
         (nodes (if (vector? value) (vector->list value) '()))
         (regular (filter (lambda (node) (member (field node "kind")
                           (cond ((equal? section "outputs") '("sink"))
                                 ((equal? section "inputs") '("source")) (else '("playback" "capture"))))) nodes)))
    (append (if (equal? section "outputs")
                (map (lambda (device) `((bluetooth_device . ,device))) (bluetooth-audio-devices (bluetooth model))) '()) regular)))
(define (node-title node)
  (or (find (lambda (value) (and (string? value) (not (string-null? value))))
            (map (lambda (key) (field node key)) '("application_name" "description" "name"))) "Unknown node"))
(define (audio-nodes model)
  (let ((nodes (list '((key . "background") (kind . "rect") (bounds . #(0 0 720 760)) (color . #(0.025 0.035 0.055 1)))))
        (actions '()))
    (define (add node) (set! nodes (append nodes (list node))))
    (define (text key x y w h value size)
      (add `((key . ,key) (kind . "text") (order . 2) (bounds . ,(vector x y w h))
             (text . ,value) (font_size . ,size) (color . #(0.92 0.94 0.98 1)))))
    (define (button name caption x y w action)
      (let ((key (if (memq (car action) '(action bluetooth cancel-bluetooth)) (format #f "view-~a-~a" (view model) name) name)))
        (set! actions (acons key action actions))
        (add `((key . ,key) (kind . "group") (order . 3) (bounds . ,(vector 0 0 w 36)) (offset . ,(vector x y))
               (input . #t) (transitions . ((offset . 80)))
               (states . ((hover . ((offset . ,(vector x (- y 1))))) (pressed . ((offset . ,(vector x (+ y 1)))))))))
        (add `((key . ,(string-append key "-bg")) (parent . ,key) (kind . "rect")
               (bounds . ,(vector 0 0 w 36)) (color . #(0.13 0.23 0.32 1))))
        (add `((key . ,(string-append key "-text")) (parent . ,key) (kind . "text") (order . 1)
               (bounds . ,(vector 8 7 (- w 16) 24)) (text . ,caption) (font_size . 15) (color . #(0.94 0.96 1 1))))))
    (text "title" 24 20 672 36 "Audio" 28)
    (text "status" 24 64 672 28 (short (status model) 78) 16)
    (for-each (lambda (section index)
                (button section (format #f "~a (~a)" (string-titlecase section) (length (inventory model section)))
                        (+ 24 (* 224 index)) 108 208 (list 'tab section))) '("outputs" "inputs" "applications") (iota 3))
    (let* ((items (inventory model (tab model))) (pages (max 1 (ceiling (/ (length items) 3))))
           (page (min (page model) (- pages 1))) (start (* 3 page))
           (visible (take (drop items start) (min 3 (- (length items) start))))
           (defaults (field (field (envelope model) "state") "defaults")))
      (when (null? items) (text "empty" 24 180 672 50 (string-append "No " (tab model) " observed") 21))
      (for-each
        (lambda (node index)
          (let* ((y (+ 170 (* 160 index))) (device (field node "bluetooth_device")) (id (field node "id")) (kind (field node "kind"))
                 (prefix (if device (format #f "bluetooth-~a" index) (number->string id))) (level (audio-volume node)) (mute (field node "mute"))
                 (caps (field node "capabilities"))
                 (ready (and (field node "ready") (integer? (field node "serial"))))
                 (default? (and (member kind '("sink" "source")) (equal? (field defaults kind) (field node "name")))))
            (if device
                (begin
                  (text (string-append prefix "-title") 24 y 672 30 (short (field device "alias") 65) 21)
                  (text (string-append prefix "-state") 24 (+ y 34) 672 25 "Bluetooth · paired · offline" 15)
                  (text (string-append prefix "-address") 24 (+ y 66) 672 28 (field device "address") 18)
                  (unless (busy? model)
                    (button (string-append prefix "-connect") "Connect and use" 24 (+ y 108) 208 (list 'bluetooth device))))
                (begin
            (text (string-append prefix "-title") 24 y 672 30 (short (node-title node) 65) 21)
            (text (string-append prefix "-state") 24 (+ y 34) 672 25
                  (format #f "~a · ~a~a~a" kind (field node "state") (string-append (if default? " · default" "")
                                         (if (and (member kind '("sink" "source"))
                                                  (equal? (field defaults (string-append "configured_" kind)) (field node "name")))
                                             " · requested default" ""))
                          (if ready "" " · controls not ready")) 15)
            (text (string-append prefix "-level") 24 (+ y 66) 672 28
                  (string-append (if level (format #f "~a%" (inexact->exact (round (* level 100)))) "Volume unknown")
                                 " · " (if (eq? mute 'null) "Mute unknown" (if mute "Muted" "Unmuted"))) 20)
            (unless (busy? model)
              (if (not ready) (text (string-append prefix "-unknown") 24 (+ y 108) 672 26 "Waiting for node identity and properties" 15)
                  (begin
                    (when (and level (field caps "volume") (field caps "mute"))
                      (button (string-append prefix "-down") "Volume −" 24 (+ y 108) 144
                              (list 'action node `((action . "volume") (value . ,(max 0 (min 1 (- level 0.1)))) (unmute . #t))))
                      (button (string-append prefix "-up") "Volume +" 184 (+ y 108) 144
                              (list 'action node `((action . "volume") (value . ,(min 1 (+ level 0.1))) (unmute . #t)))))
                    (when (and (boolean? mute) (field caps "mute"))
                      (button (string-append prefix "-mute") (if mute "Unmute" "Mute") 344 (+ y 108) 144
                              (list 'action node `((action . "mute") (value . ,(not mute))))))
                    (when (and (member kind '("sink" "source")) (field caps "default") (not default?))
                      (button (string-append prefix "-default") "Use default" 504 (+ y 108) 192
                              (list 'action node '((action . "default")))))
                    (unless (or (and level (field caps "volume") (field caps "mute")) (and (boolean? mute) (field caps "mute")) (field caps "default"))
                      (text (string-append prefix "-unsupported") 24 (+ y 108) 672 26 "Controls unavailable for this node" 15))))))))) visible (iota (length visible)))
      (text "page" 24 666 672 26 (format #f "~a–~a of ~a; ~a more" (if (null? items) 0 (+ start 1))
                                                       (+ start (length visible)) (length items) (- (length items) (length visible))) 16)
      (when (> pages 1)
        (button "previous" "Previous" 24 706 140 '(previous))
        (button "next" "Next" 180 706 140 '(next)))
      (if (bluetooth-audio-pending? (bluetooth model))
          (button "cancel-bluetooth" "Cancel selection" 448 706 248 '(cancel-bluetooth))
          (text "scale" 348 710 348 40 "Perceptual volume · 10% steps" 15)))
    (set-buttons! model actions) (list->vector nodes)))
(define* (audio-activate! model key send #:optional (send-bluez (lambda _ #f)) (now (now-ms)))
  (match (assoc-ref (buttons model) key)
    (('action node action)
     (unless (busy? model)
       (set-serial! model (+ 1 (serial model))) (set-pending! model (number->string (serial model)))
       (send `((type . "action") (request_id . ,(pending model))
               (request . ((session . ,(field (field (envelope model) "state") "session"))
                           (id . ,(field node "id")) (serial . ,(field node "serial")) (action . ,action)))))
       (set-status! model "Waiting for PipeWire readback")))
    (('bluetooth device)
     (unless (busy? model)
       (let ((previous (bluetooth-audio-status (bluetooth model))))
         (bluetooth-audio-select! (bluetooth model) device send-bluez send now)
         (sync-bluetooth-status! model previous))))
    (('cancel-bluetooth)
     (let ((previous (bluetooth-audio-status (bluetooth model))))
       (bluetooth-audio-cancel! (bluetooth model)) (sync-bluetooth-status! model previous)))
    (('tab section) (set-tab! model section) (set-page! model 0) (set-view! model (+ 1 (view model))))
    (('previous) (set-page! model (max 0 (- (page model) 1))) (set-view! model (+ 1 (view model))))
    (('next) (set-page! model (+ 1 (page model))) (set-view! model (+ 1 (view model))))
    (_ #f)))
(define* (audio-input! model message epoch applied sequence send #:optional (send-bluez (lambda _ #f)) (now (now-ms)))
  (when (and (equal? (field message "type") "input") (equal? (field message "channel") "audio")
             (equal? (field message "event") "activate") (equal? (field message "epoch") epoch)
             (equal? (field message "seq") applied) (= applied sequence))
    (audio-activate! model (field message "key") send send-bluez now)))

(define* (run-audio-ui path #:optional (worker "hearth-audio") (arguments '())
                       #:key (bluetooth-worker "hearth-bluetooth") (bluetooth-arguments '()))
  (let* ((model (make-audio-ui))
         (process (call-with-values (lambda () (apply (@@ (ice-9 popen) open-process) OPEN_BOTH worker arguments)) list))
         (input (car process)) (output (cadr process)) (pid (caddr process))
         (read-worker ((@@ (bluetooth-ui) pipe-reader) input))
         (bluez-process (catch #t
           (lambda () (call-with-values (lambda () (apply (@@ (ice-9 popen) open-process) OPEN_BOTH bluetooth-worker bluetooth-arguments)) list))
           (lambda _ #f)))
         (bluez-input (and bluez-process (car bluez-process)))
         (bluez-output (and bluez-process (cadr bluez-process)))
         (read-bluez (and bluez-input ((@@ (bluetooth-ui) pipe-reader) bluez-input)))
         (bluez-alive? (and bluez-process #t))
         (bluez-reaped? (not bluez-process))
         (connection #f) (keys '()) (dirty? #t))
    (define (send request) ((@@ (bluetooth-ui) pipe-write!) output request))
    (define (send-bluez request)
      (unless bluez-alive? (error "Bluetooth worker unavailable"))
      ((@@ (bluetooth-ui) pipe-write!) bluez-output request))
    (define (bluez-unavailable!)
      (set! bluez-alive? #f)
      (audio-bluetooth-message! model '((version . 1) (service . "bluetooth") (status . "unavailable")
                                      (observed_at_ms . 0) (state . null) (error . "Bluetooth worker unavailable")) send-bluez send)
      (set! dirty? #t))
    (for-each (lambda (port) (setvbuf port 'none) (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL)))) (append (list input output) (if bluez-process (list bluez-input bluez-output) '())))
    (unless bluez-process (bluez-unavailable!))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (let loop ()
          (let ((before (view model))) (audio-tick! model (now-ms)) (unless (= before (view model)) (set! dirty? #t)))
          (unless (or bluez-alive? bluez-reaped?)
            (unless (zero? (car (waitpid (caddr bluez-process) WNOHANG))) (set! bluez-reaped? #t)))
          (when bluez-alive?
            (catch #t
              (lambda () (let drain ()
                (let ((message (read-bluez)))
                  (when message (audio-bluetooth-message! model message send-bluez send) (set! dirty? #t) (drain)))))
              (lambda (key . arguments)
                (when (memq key '(quit interrupt)) (apply throw key arguments))
                (bluez-unavailable!))))
          (let drain ()
            (let ((message (read-worker)))
              (when message
                (audio-message! model message send send-bluez) (set! dirty? #t) (drain))))
          (catch #t
            (lambda ()
              (unless connection
                (let ((nodes (audio-nodes model)))
                  (set! keys (map (lambda (node) (field node "key")) (vector->list nodes)))
                  (set! connection (make-ui-client path "audio" nodes (audio-data model)))
                  (ui-connect! connection) (set! dirty? #f)))
              (let drain ()
                (let ((message (ui-receive connection #:timeout 0)))
                  (when message
                    (when (and (equal? (field message "type") "ack") (equal? (field message "status") "rejected"))
                      (error "Renderer rejected audio scene"))
                    (when (and (not dirty?) (equal? (field message "type") "input") (equal? (field message "event") "activate"))
                      (audio-input! model message (ui-epoch connection) (ui-applied-seq connection) (ui-seq connection) send send-bluez)
                      (set! dirty? #t))
                    (drain))))
              (when (and dirty? (= (ui-applied-seq connection) (ui-seq connection)))
                (let* ((nodes (audio-nodes model)) (next (map (lambda (node) (field node "key")) (vector->list nodes))))
                  (ui-patch! connection nodes (list->vector (lset-difference equal? keys next)) #:data (audio-data model))
                  (set! keys next) (set! dirty? #f))))
            (lambda (key . arguments)
              (when (memq key '(quit interrupt)) (apply throw key arguments))
              (when connection (ui-close! connection)) (set! connection #f)
              (audio-disconnected! model) (set! dirty? #t)))
          (select (append (list input) (if bluez-alive? (list bluez-input) '()) (if (and connection (ui-port connection)) (list (ui-port connection)) '()))
                  '() '() (if (and connection (not (bluetooth-audio-pending? (bluetooth model)))) 30 1))
          (loop)))
      (lambda ()
        (bluetooth-audio-cancel! (bluetooth model))
        (when bluez-process
          (close-port bluez-output) (close-port bluez-input))
        (unless bluez-reaped?
          (let wait ((remaining 300))
            (when (zero? (car (waitpid (caddr bluez-process) WNOHANG)))
              (if (zero? remaining) (begin (kill (caddr bluez-process) SIGKILL) (waitpid (caddr bluez-process)))
                  (begin (usleep 10000) (wait (- remaining 1)))))))
        (when connection (ui-close! connection))
        (close-port output) (close-port input)
        (let wait ((remaining 300))
          (when (zero? (car (waitpid pid WNOHANG)))
            (if (zero? remaining) (begin (kill pid SIGKILL) (waitpid pid))
                (begin (usleep 10000) (wait (- remaining 1))))))))))

(when (string-suffix? "scheme/audio-ui.scm" (car (command-line)))
  (sigaction SIGPIPE SIG_IGN)
  (sigaction SIGTERM (lambda (_) (throw 'quit 0)))
  (sigaction SIGINT (lambda (_) (throw 'quit 0)))
  (match (cdr (command-line))
    ((path "--bluetooth-worker" bluez arguments ...)
     (let ((separator (list-index (lambda (argument) (equal? argument "--audio-worker")) arguments)))
       (unless (and separator (< (+ separator 1) (length arguments))) (error "Both worker commands are required"))
       (run-audio-ui path (list-ref arguments (+ separator 1)) (drop arguments (+ separator 2))
                     #:bluetooth-worker bluez #:bluetooth-arguments (take arguments separator))))
    ((path) (run-audio-ui path))
    ((path worker arguments ...) (run-audio-ui path worker arguments))
    (_ (display "Usage: guile -L scheme scheme/audio-ui.scm SOCKET [AUDIO-WORKER [ARG...]] | SOCKET --bluetooth-worker COMMAND ARGS... --audio-worker COMMAND ARGS...\n" (current-error-port)) (exit 2))))
