(define-module (bluetooth-audio)
  #:use-module (ui)
  #:use-module (services)
  #:use-module (json)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-13)
  #:export (make-bluetooth-audio bluetooth-audio-update! bluetooth-audio-select!
            bluetooth-audio-cancel! bluetooth-audio-tick! bluetooth-audio-devices
            bluetooth-audio-pending? bluetooth-audio-status))
(define (field value key) (and (list? value) (ui-field value key)))
(define (state envelope) (and (equal? (field envelope "status") "available") (field envelope "state")))
(define (items value key) (let ((values (field value key))) (if (vector? values) (vector->list values) '())))
(define-record-type <bluetooth-audio>
  (%make-model bluez audio operation serial status)
  bluetooth-audio?
  (bluez bluez set-bluez!) (audio audio set-audio!) (operation operation set-operation!)
  (serial serial set-serial!) (status bluetooth-audio-status set-status!))
(define (make-bluetooth-audio) (%make-model #f #f #f 0 "Bluetooth outputs not observed"))
(define (bluetooth-audio-pending? model) (and (operation model) #t))
(define (canonical-address device)
  (let ((value (field device "address")))
    (and (string? value) ((@@ (services) bluetooth-address?) (string-upcase value)) (string-upcase value))))
(define (device-identity device) (list (field device "path") (canonical-address device)))
(define (bluetooth-audio-devices model)
  (filter (lambda (device)
            (and (canonical-address device) (field device "paired") (not (field device "blocked")) (not (field device "connected"))
                 (string? (field device "icon")) (string-contains (field device "icon") "audio")))
          (items (state (bluez model)) "devices")))
(define (finish! model status) (set-operation! model #f) (set-status! model status))
(define (bluetooth-audio-cancel! model)
  (when (operation model)
    (finish! model (if (equal? (assoc-ref (operation model) 'stage) 'default)
                      "Default outcome unknown; inspect current audio state"
                      "Selection cancelled; any connection change may still complete"))))
(define (bluetooth-audio-tick! model now)
  (when (and (operation model) (>= now (assoc-ref (operation model) 'deadline)))
    (finish! model (if (eq? (assoc-ref (operation model) 'stage) 'default)
                      "Default outcome unknown after deadline; inspect current state"
                      "Selection timed out; no default was requested"))))
(define (current-device model)
  (and (operation model)
       (find (lambda (device) (equal? (device-identity device) (assoc-ref (operation model) 'device)))
             (items (state (bluez model)) "devices"))))
(define (matching-sinks model)
  (let ((address (and (operation model) (cadr (assoc-ref (operation model) 'device)))))
    (filter (lambda (node) (and (equal? (field node "kind") "sink")
                                (equal? (field node "bluetooth_address") address)))
            (items (state (audio model)) "nodes"))))
(define (advance! model send-audio now)
  (bluetooth-audio-tick! model now)
  (when (operation model)
    (let* ((op (operation model)) (device (current-device model))
           (audio-state (state (audio model))) (sinks (matching-sinks model)))
      (cond
        ((or (not (equal? (assoc-ref op 'owner) (field (state (bluez model)) "owner")))
             (not (equal? (assoc-ref op 'session) (field audio-state "session")))
             (not device) (not (field device "paired")) (field device "blocked"))
         (bluetooth-audio-cancel! model))
        ((eq? (assoc-ref op 'stage) 'default)
         (let ((node (and (= 1 (length sinks)) (car sinks))))
           (unless (and (field device "connected") node
                        (equal? (list (field node "id") (field node "serial")) (assoc-ref op 'node)))
             (bluetooth-audio-cancel! model))))
        ((eq? (assoc-ref op 'stage) 'waiting)
         (cond
           ((> (length sinks) 1) (finish! model "Multiple Bluetooth sinks matched; choose an output manually"))
           ((and (field device "connected") (= 1 (length sinks))
                 (field (car sinks) "ready") (integer? (field (car sinks) "serial"))
                 (field (field (car sinks) "capabilities") "default"))
            (let* ((node (car sinks)) (request-id (string-append "bluetooth-default-" (number->string (serial model)))))
              (set-operation! model (acons 'node (list (field node "id") (field node "serial"))
                (acons 'request request-id (acons 'stage 'default (alist-delete 'stage (alist-delete 'request op))))))
              (set-status! model "Waiting for Bluetooth default readback")
              (send-audio `((type . "action") (request_id . ,request-id)
                (request . ((session . ,(assoc-ref op 'session)) (id . ,(field node "id")) (serial . ,(field node "serial"))
                            (expected_bluetooth_address . ,(cadr (assoc-ref op 'device))) (action . ((action . "default")))))))))))))))
(define (bluetooth-audio-select! model device send-bluez send-audio now)
  (unless (operation model)
    (let ((current (find (lambda (value) (equal? (device-identity value) (device-identity device))) (bluetooth-audio-devices model)))
          (audio-state (state (audio model))))
      (if (and current audio-state)
          (begin
            (set-serial! model (+ 1 (serial model)))
            (let ((request-id (string-append "bluetooth-connect-" (number->string (serial model)))))
              (set-operation! model `((owner . ,(field (state (bluez model)) "owner")) (session . ,(field audio-state "session"))
                                     (device . ,(device-identity current)) (stage . connecting) (request . ,request-id) (deadline . ,(+ now 30000))))
              (set-status! model "Connecting Bluetooth output; default waits for a matching sink")
              (send-bluez `((type . "action") (request_id . ,request-id)
                (request . ((owner . ,(field (state (bluez model)) "owner")) (path . ,(field current "path")) (action . ((action . "connect")))))))))
          (set-status! model "Output unavailable or changed; refresh before selecting")))))
(define (bluetooth-audio-update! model service message send-bluez send-audio now)
  (bluetooth-audio-tick! model now)
  (cond
    ((equal? (field message "service") service)
     (hearth-service-decode (scm->json-string message))
     (cond ((equal? service "bluetooth") (set-bluez! model message))
           ((equal? service "pipewire") (set-audio! model message))
           (else (error "Unexpected Bluetooth audio service")))
     (advance! model send-audio now))
    ((equal? (field message "type") "result")
     (when (and (operation model) (equal? (field message "request_id") (assoc-ref (operation model) 'request)))
       (cond
         ((and (equal? service "bluetooth") (eq? (assoc-ref (operation model) 'stage) 'connecting))
          (if (equal? (field message "status") "executed")
              (begin (set-operation! model (acons 'stage 'waiting (alist-delete 'stage (operation model))))
                     (set-status! model "Connection completed; waiting for device and sink") (advance! model send-audio now))
              (finish! model "Bluetooth connection failed or outcome unknown; no default requested")))
         ((and (equal? service "pipewire") (eq? (assoc-ref (operation model) 'stage) 'default))
          (finish! model (cond ((equal? (field message "status") "applied") "Bluetooth output requested as default")
                              ((equal? (field message "status") "rejected") "Default request rejected; inspect audio state")
                              (else "Default outcome unknown; inspect audio state")))))))
    ((and (equal? service "bluetooth") (equal? (field message "type") "challenge"))
     (bluetooth-audio-cancel! model)
     (send-bluez '((type . "cancel")))
     (set-status! model "Pairing approval requires the Bluetooth panel"))
    (else (error "Unexpected Bluetooth audio message"))))
