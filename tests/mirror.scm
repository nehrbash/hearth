(use-modules (mirror) (ui) (rnrs bytevectors))
(define (check value message) (unless value (error message)))
(define calls '())
(define (command endpoint expression)
  (check (equal? endpoint "workspace-eval") "Wrong endpoint")
  (check (<= (bytevector-length (string->utf8 (object->string expression))) 122880) "Publication exceeds argv budget")
  (set! calls (cons expression calls)) #t)
(define message '(("type" . "channel_update") ("channel" . "test")
                  ("epoch" . 3) ("seq" . 1) ("connected" . #t)
                  ("nodes" . #()) ("data" . (("text" . "\"; (error evil)")))))
(define observed (mirror-observe message 1234))
(define stored (mirror-publish! 'hearth-mirror-test observed #:command command))
(check (equal? stored observed) "Small payload changed")
(check (equal? (ui-field stored "status") "available") "Connected status missing")
(check (= (ui-field stored "observed_at_ms") 1234) "Observation time missing")
(check (equal? (caddr (cadr (car calls))) (list 'quote stored)) "Saved value is not quoted data")
(define offline (mirror-unavailable stored "test" "Renderer connection unavailable"))
(check (not (ui-field offline "connected")) "Offline retains connected status")
(check (= (ui-field offline "observed_at_ms") 1234) "Offline restamps stale observation")
(check (equal? (ui-field offline "data") (ui-field stored "data")) "Offline loses bounded last state")
(define large (mirror-observe
  `(("channel" . "test") ("seq" . 2) ("connected" . #t)
    ("data" . ,(make-string 140000 #\x))) 2345))
(define omitted (mirror-publish! 'hearth-mirror-test large #:command command))
(check (not (ui-field omitted "connected")) "Oversize appears connected")
(check (equal? (ui-field omitted "status") "unavailable") "Oversize lacks explicit status")
(check (= (ui-field omitted "seq") 2) "Oversize loses sequence")
(check (= (ui-field omitted "observed_at_ms") 2345) "Oversize loses observation")
(check (not (ui-field omitted "data")) "Oversize retains huge data")
(check (string-contains (ui-field omitted "error") "120 KiB") "Oversize lacks reason")
(check (equal? (mirror-publish! 'hearth-mirror-test observed #:command command) observed) "Small update cannot recover")
(check (equal? (ui-field (mirror-observe '((connected . #f)) 4) "status") "unavailable") "Producer disconnect not represented")
(check (eq? (ui-field (mirror-unavailable #f "test" "Stopped") "observed_at_ms") 'null) "Unobserved state fabricates timestamp")
(display "mirror tests passed\n")
