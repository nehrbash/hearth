(use-modules (tray-ui) (ui) (json) (srfi srfi-1) (rnrs bytevectors))
(define (check value message) (unless value (error message)))
(define (fails? thunk) (catch #t (lambda () (thunk) #f) (lambda _ #t)))
(define (change object key value) (acons key value (alist-delete key object)))
(define (wire value) (json-string->scm (scm->json-string value)))
(define (entry id parent label enabled separator toggle submenu)
  `((id . ,id) (parent . ,parent) (label . ,label) (enabled . ,enabled) (visible . #t)
    (separator . ,separator) (toggle_type . ,toggle) (toggle_state . 1) (children_display . ,submenu) (icon_name . null)))
(define icon '((width . 1) (height . 1) (rgba . #(100 150 200 255))))
(define menu
  `((path . "/Menu") (revision . 7) (epoch . 1)
    (nodes . ,(vector (entry 0 'null "Root" #t #f 'null "submenu")
                      (change (entry 1 0 "Open" #t #f 'null 'null) 'icon icon) (entry 2 0 "Checked" #t #f "checkmark" 'null)
                      (entry 3 0 "Disabled" #f #f 'null 'null) (entry 4 0 "" #t #t 'null 'null)
                      (entry 5 0 "Radio" #t #f "radio" 'null) (entry 6 0 "Submenu" #t #f 'null "submenu")
                      (entry 7 6 "Nested" #t #f 'null 'null)))))
(define item
  `((service . "org.example.Tray") (owner . ":1.45") (path . "/StatusNotifierItem") (id . "demo")
    (title . "Demo application") (status . "NeedsAttention") (category . "ApplicationStatus")
    (icon_name . null) (icon . ,icon) (attention_icon_name . null) (attention_icon . ,icon)
    (overlay_icon_name . null) (overlay_icon . ,icon)
    (tooltip . ((title . "Info") (description . "Tooltip body"))) (item_is_menu . #f)
    (menu . ,menu) (error . null) (menu_error . null)))
(define state `((session . "test-session") (watcher_owner . ":1.1") (owns_watcher . #f) (items . ,(vector item))))
(define envelope `((version . 1) (service . "tray") (status . "available") (observed_at_ms . 1) (state . ,state) (error . null)))
(define model (make-tray-ui))
(define sent '())
(define (send request) (set! sent (cons request sent)))
(define (feed value) (tray-message! model (wire value)))
(define (nodes) (tray-nodes model))
(define (resolved name)
  (or (find (lambda (key) (and (string-prefix? "view-" key) (string-suffix? (string-append "-" name) key)))
            (map (lambda (node) (ui-field node "key")) (vector->list (nodes)))) name))
(define (click name) (tray-activate! model (resolved name) send))
(define (result id) (feed `((type . "result") (request_id . ,id) (status . "applied") (error . null))))
(feed envelope)
(check (ui-field (tray-data model) "sensitive") "Raw tray scene must not enter generic durable mirroring")
(check (= 2 (count (lambda (node) (equal? "image" (ui-field node "kind"))) (vector->list (nodes)))) "Attention and overlay icons missing")
(check (string-contains (scm->json-string (nodes)) "Tooltip body") "Tooltip missing")
(check (string-contains (scm->json-string (nodes)) "Needs attention") "Raw enum leaked into UI")
(define key (resolved "0-primary"))
(define (input epoch seq) `((type . "input") (channel . "tray") (epoch . ,epoch) (seq . ,seq) (event . "activate") (key . ,key)))
(tray-input! model (input 1 1) 2 1 1 send)
(tray-input! model (input 2 0) 2 1 1 send)
(tray-input! model (input 2 1) 2 1 2 send)
(check (null? sent) "Stale renderer input dispatched")
(tray-input! model (input 2 1) 2 1 1 send)
(check (equal? "test-session" (ui-field (ui-field (car sent) "request") "session")) "Worker session missing")
(check (equal? ":1.45" (ui-field (ui-field (car sent) "request") "owner")) "Pinned owner missing")
(check (equal? "activate" (ui-field (ui-field (ui-field (car sent) "request") "action") "action")) "Primary action incorrect")
(click "0-primary") (check (= 1 (length sent)) "Double click duplicated action")
(result "1") (click "0-secondary") (result "2") (click "0-context") (result "3") (click "0-up")
(check (= 120 (ui-field (ui-field (ui-field (car sent) "request") "action") "delta")) "Scroll delta missing")
(result "4") (click "0-menu")
(check (equal? "menu_about_to_show" (ui-field (ui-field (ui-field (car sent) "request") "action") "action")) "Menu opening skipped AboutToShow")
(result "5")
(define before (length sent)) (click "menu-1")
(check (= before (length sent)) "Menu actions enabled before refreshed snapshot")
(feed envelope)
(check (= 1 (count (lambda (node) (equal? "image" (ui-field node "kind"))) (vector->list (nodes)))) "Menu icon missing")
(check (string-contains (scm->json-string (nodes)) "[x] Checked") "Checkmark missing")
(check (string-contains (scm->json-string (nodes)) "● Radio") "Radio state missing")
(click "menu-3") (click "menu-4")
(check (= before (length sent)) "Disabled/separator node dispatched")
(click "menu-6") (result "6") (feed envelope)
(check (string-contains (scm->json-string (nodes)) "Nested") "Submenu inaccessible")
(click "menu-7")
(define menu-action (ui-field (ui-field (car sent) "request") "action"))
(check (= 1 (ui-field menu-action "epoch")) "Menu epoch missing")
(check (= 7 (ui-field menu-action "revision")) "Menu revision missing")
(check (= 7 (ui-field menu-action "id")) "Wrong menu ID")
(result "7")
(define old-key (resolved "menu-7"))
(feed (change envelope 'state (change state 'items (vector (change item 'menu (change menu 'epoch 2))))))
(check (not (equal? old-key (resolved "menu-7"))) "Menu replacement retained pressed key")
(define count-before (length sent)) (tray-activate! model old-key send)
(check (= count-before (length sent)) "Old pressed menu dispatched against replacement")
(tray-disconnected! model) (click "0-primary")
(check (= count-before (length sent)) "Disconnected stale item dispatched")
(feed envelope) (check (= count-before (length sent)) "Reconnect replayed mutation")
(feed (change envelope 'state (change state 'items (vector (change item 'item_is_menu #t)))))
(click "0-primary")
(check (equal? "menu_about_to_show" (ui-field (ui-field (ui-field (car sent) "request") "action") "action")) "ItemIsMenu primary invoked Activate")
(tray-disconnected! model)
(feed (change envelope 'state (change state 'items (vector (change item 'error "Item unavailable")))))
(define old-count (length sent)) (click "0-primary")
(check (= old-count (length sent)) "Failed item exposed controls")
(define many (change envelope 'state (change state 'items (list->vector (map (lambda (n) (change item 'owner (format #f ":1.~a" (+ n 10)))) (iota 4))))))
(feed many) (check (string-contains (scm->json-string (nodes)) "1 more") "Item overflow missing")
(click "next") (check (string-contains (scm->json-string (nodes)) "4–4 of 4") "Last item page inaccessible")
(define observation (tray-observation (wire envelope)))
(check (not (string-contains (scm->json-string observation) "100,150,200,255")) "Pixel bytes entered observation")
(check (= 8 (ui-field (ui-field (vector-ref (ui-field (ui-field observation "state") "items") 0) "menu") "node_count")) "Menu summary missing")
(check (= 1 (ui-field (ui-field (vector-ref (ui-field (ui-field observation "state") "items") 0) "menu") "icon_count")) "Menu icon metadata missing")
(define publication #f)
(tray-publish! observation #:command (lambda (text) (set! publication text) "((status . ok))"))
(check (not (string-contains publication "100 150 200 255")) "Pixel bytes entered Weft expression")
(check (string-contains publication "hearth-tray") "Wrong saved observation key")
(define oversized-icon (change envelope 'state (change state 'items (vector (change item 'icon (change icon 'width 65))))))
(check (fails? (lambda () (feed oversized-icon))) "Oversized icon accepted")
(feed '((version . 1) (service . "tray") (status . "unavailable") (observed_at_ms . 2) (state . null) (error . "Watcher gone")))
(check (> (vector-length (nodes)) 0) "Unavailable tray cannot render")
(display "Tray UI tests passed\n")
