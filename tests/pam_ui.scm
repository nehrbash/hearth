(use-modules (pam-ui) (ui) (services) (json) (srfi srfi-1) (srfi srfi-13) (rnrs bytevectors) ((rnrs io ports) #:select (open-bytevector-input-port)))
(define (check value message) (unless value (error message)))
(define (fails? thunk) (catch #t (lambda () (thunk) #f) (lambda _ #t)))
(define (field object key) (ui-field object key))
(define model (make-pam-ui))
(define sent '())
(define (send value) (set! sent (cons value sent)))
(define (feed value) (pam-message! model value send))
(define (key name)
  (find (lambda (key) (string-suffix? (string-append "-" name) key))
        (map (lambda (node) (field node "key")) (vector->list (pam-nodes model)))))
(define (click name) (let ((key (key name))) (when key (pam-activate! model key send))))
(define ready '((type . "ready") (session . "worker-one") (service . "private-fixture")))
(define (started request attempt)
  `((type . "started") (session . "worker-one") (request_id . ,request) (attempt . ,attempt) (deadline_ms . 18446744073709551615)))
(define (prompt id attempt style)
  `((type . "prompt") (session . "worker-one") (attempt . ,attempt) (prompt_id . ,id)
    (style . ,style) (text . "Fixture response:") (response_required . #t) (deadline_ms . 18446744073709551615)))
(define secret "SecretSentinel42")
(define (type-secret)
  (for-each (lambda (c)
              (unless (key (format #f "key-~a" (char->integer c))) (click "page"))
              (click (format #f "key-~a" (char->integer c)))) (string->list secret)))
(feed ready)
(check (null? sent) "Ready automatically started authentication")
(define start (key "start"))
(define (input epoch seq) `((type . "input") (channel . "pam") (epoch . ,epoch) (seq . ,seq) (event . "activate") (key . ,start)))
(pam-input! model (input 1 1) 2 1 1 send)
(pam-input! model (input 2 0) 2 1 1 send)
(pam-input! model (input 2 1) 2 1 2 send)
(check (null? sent) "Stale renderer input started authentication")
(pam-input! model (input 2 1) 2 1 1 send)
(pam-activate! model start send)
(check (= 1 (length sent)) "Duplicate start dispatched")
(check (equal? "authenticate" (field (car sent) "type")) "Wrong start command")
(feed (started "1" "attempt-one"))
(feed (prompt "prompt-one" "attempt-one" "echo_off"))
(type-secret)
(check (not (string-contains (scm->json-string (pam-nodes model)) secret)) "Secret leaked into scene")
(check (not (string-contains (scm->json-string (pam-data model)) secret)) "Secret leaked into metadata")
(check (field (pam-data model) "sensitive") "Generic mirror must withhold authentication scene")
(define submit (key "submit"))
(click "submit")
(check (equal? secret (field (car sent) "value")) "Private worker did not receive exact response")
(check (equal? "prompt-one" (field (car sent) "prompt_id")) "Reply missing prompt identity")
(define after-submit (length sent))
(pam-activate! model submit send)
(check (= after-submit (length sent)) "Duplicate response dispatched")
(feed (prompt "prompt-one" "attempt-one" "echo_off"))
(check (not (key "submit")) "Consumed prompt reopened")
(feed (prompt "prompt-two" "attempt-one" "echo_on"))
(check (string-contains (scm->json-string (pam-nodes model)) "0 characters") "Old prompt buffer survived")
(type-secret)
(check (not (string-contains (scm->json-string (pam-nodes model)) secret)) "Echo-on response leaked")
(define old-submit (key "submit"))
(feed (prompt "prompt-three" "attempt-one" "echo_off"))
(pam-activate! model old-submit send)
(check (= after-submit (length sent)) "Old prompt input rebound to new prompt")
(check (string-contains (scm->json-string (pam-nodes model)) "0 characters") "New prompt did not clear buffer")
(type-secret)
(pam-disconnected! model send)
(check (equal? "cancel" (field (car sent) "type")) "Renderer loss failed to cancel")
(check (not (key "submit")) "Disconnected model retained prompt")
(feed (prompt "late" "attempt-one" "echo_off"))
(check (not (key "submit")) "Late prompt accepted after cancel")
(click "start")
(feed (started "2" "attempt-two"))
(feed (prompt "fresh" "attempt-two" "echo_off"))
(check (string-contains (scm->json-string (pam-nodes model)) "0 characters") "Cancelled response survived new attempt")
(pam-expire! model send 18446744073709551615)
(check (equal? "cancel" (field (car sent) "type")) "Deadline failed to cancel")
(click "start")
(click "cancel")
(feed (started "3" "attempt-three"))
(check (and (equal? "cancel" (field (car sent) "type")) (equal? "attempt-three" (field (car sent) "attempt"))) "Late started attempt survived cancellation")
(define observation '((version . 1) (service . "pam") (status . "available") (observed_at_ms . 42)
                      (state . ((phase . "finished") (outcome . "authenticated"))) (error . null)))
(define published #f)
(hearth-service-publish! (pam-observation observation) #:command (lambda (text) (set! published text) "((status . ok))"))
(check (and (string-contains published "hearth-pam") (string-contains published "authenticated")) "Actual phase/outcome observation missing")
(check (not (string-contains published secret)) "Secret leaked into Weft")
(check (fails? (lambda () (pam-observation (prompt "x" "y" "echo_off")))) "Prompt accepted as observation")
(check (fails? (lambda () (pam-observation `((version . 1) (service . "pam") (status . "unavailable")
  (observed_at_ms . 42) (state . null) (error . ,secret))))) "Arbitrary diagnostic accepted for durable publication")
(display "PAM UI tests passed\n")

(define attempts '())
(pam-publish-stream (open-bytevector-input-port (string->utf8
  (string-append (scm->json-string (prompt "private" "attempt" "echo_off")) "\n"
                 (scm->json-string observation) "\n")))
  #:command (lambda (expression) (set! attempts (cons expression attempts)) "((status . ok))"))
(check (= 2 (length attempts)) "Publisher must omit private messages and mark EOF unavailable")
(check (string-contains (car attempts) "Authentication worker unavailable") "Publisher retained live phase after EOF")
(check (string-contains (cadr attempts) "authenticated") "Publisher lost actual worker outcome")
(check (not (any (lambda (expression) (string-contains expression "Fixture response")) attempts)) "Prompt entered durable publication")
(display "PAM publisher tests passed\n")
(click "start")
(feed (started "4" "attempt-four"))
(feed (prompt "final" "attempt-four" "echo_off"))
(type-secret)
(feed '((type . "result") (session . "worker-one") (attempt . "attempt-four") (request_id . "4") (status . "authenticated")))
(check (string-contains (scm->json-string (pam-nodes model)) "account checks passed") "Success omitted account gate")
(check (not (key "submit")) "Completion retained response controls")
(check (not (string-contains (scm->json-string (pam-nodes model)) secret)) "Completion retained secret")
(click "start")
(feed (started "5" "attempt-five"))
(feed '((type . "prompt") (session . "worker-one") (attempt . "attempt-five") (prompt_id . "information")
        (style . "info") (text . "Fixture information") (response_required . #f) (deadline_ms . 18446744073709551615)))
(check (not (key "submit")) "Information prompt requested a response")
(feed (prompt "bounded" "attempt-five" "echo_off"))
((@@ (pam-ui) set-entry!) model (make-string 4096 #\x))
(click "key-65")
(click "submit")
(check (= 4096 (string-length (field (car sent) "value"))) "Response byte limit exceeded")
(display "PAM lifecycle tests passed\n")
(feed (prompt "pipe-failure" "attempt-five" "echo_off"))
(type-secret)
(check (fails? (lambda () (pam-disconnected! model (lambda _ (error "Mock closed pipe"))))) "Mock cancellation failure missing")
(check (string-null? ((@@ (pam-ui) entry) model)) "Cancellation pipe failure retained response")
(check (not (key "submit")) "Cancellation pipe failure retained prompt")
(define (child-pids pid)
  (catch #t
    (lambda ()
      (call-with-input-file (format #f "/proc/~a/task/~a/children" pid pid)
        (lambda (port)
          (let loop ((pids '()))
            (let ((value (read port)))
              (if (eof-object? value) pids (loop (cons value pids))))))))
    (lambda _ '())))
(define (signal-cleanup-test signal)
  (let ((pid (primitive-fork)))
    (if (zero? pid)
        (execlp "guile" "guile" "-L" "scheme" "scheme/pam-ui.scm" "--publish-workspace"
                "/tmp/hearth-pam-test-nonexistent-renderer.sock" "guile" "-c"
                "(display \"{\\\"type\\\":\\\"ready\\\",\\\"session\\\":\\\"fixture\\\",\\\"service\\\":\\\"fixture\\\"}\\n\")(force-output)(let loop () (unless (eof-object? (read-char)) (loop)))")
        (let ((children
                (let wait ((remaining 300))
                  (let ((children (child-pids pid)))
                    (cond ((= 2 (length children)) children)
                          ((zero? remaining) (kill pid SIGKILL) (waitpid pid) (error "PAM fixture children did not start"))
                          (else (usleep 10000) (wait (- remaining 1))))))))
          (usleep 100000)
          (kill pid signal)
          (let wait ((remaining 500))
            (let ((result (waitpid pid WNOHANG)))
              (cond ((not (zero? (car result))) (check (equal? 0 (status:exit-val (cdr result))) "Signal cleanup exited abnormally"))
                    ((zero? remaining) (kill pid SIGKILL) (waitpid pid) (error "PAM signal cleanup timed out"))
                    (else (usleep 10000) (wait (- remaining 1))))))
          (for-each (lambda (child) (check (not (file-exists? (format #f "/proc/~a" child))) "PAM child survived controller signal")) children)))))
(signal-cleanup-test SIGTERM)
(signal-cleanup-test SIGINT)
(display "PAM signal cleanup tests passed\n")
