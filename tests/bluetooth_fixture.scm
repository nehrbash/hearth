(use-modules (bluetooth-ui) (json))
(define envelope
 '((version . 1) (service . "bluetooth") (status . "available") (observed_at_ms . 1795153000000) (error . null)
   (state . ((owner . ":1.42")
    (adapters . #(((path . "/org/bluez/hci0") (address . "00:11:22:33:44:00") (name . "Woodland radio")
                  (alias . "Woodland radio") (powered . #t) (discovering . #f) (pairable . #t))))
    (devices . #(((path . "/org/bluez/hci0/dev_00_11_22_33_44_55") (adapter . "/org/bluez/hci0")
                 (address . "00:11:22:33:44:55") (name . "Canopy headphones") (alias . "Canopy headphones")
                 (icon . "audio-headset") (connected . #f) (paired . #f) (trusted . #f) (blocked . #f)
                 (rssi . -44) (battery_percentage . 76))
                ((path . "/org/bluez/hci0/dev_00_11_22_33_44_66") (adapter . "/org/bluez/hci0")
                 (address . "00:11:22:33:44:66") (name . "Fern keyboard") (alias . "Fern keyboard")
                 (icon . "input-keyboard") (connected . #t) (paired . #t) (trusted . #t) (blocked . #f)
                 (rssi . null) (battery_percentage . null))))))))
(define (send value) #t)
(define model (make-bluetooth-ui))
(bluetooth-message! model envelope send)
(define (write-fixture name)
 (when (equal? name (cadr (command-line)))
  (scm->json `((nodes . ,(bluetooth-nodes model)) (data . ,(bluetooth-data model)))) (newline)))
(write-fixture "bluetooth")
(bluetooth-nodes model)
(bluetooth-activate! model "device-0-1" send)
(define (challenge kind)
 (let ((now (gettimeofday)))
 `((type . "challenge") (challenge_id . ,(if (equal? kind "confirmation") 1 2)) (request_id . "1") (owner . ":1.42") (device . "/org/bluez/hci0/dev_00_11_22_33_44_55")
   (kind . ,kind) (passkey . 123456) (pin . null) (entered . null) (uuid . null)
   (deadline_ms . ,(+ (* 1000 (car now)) (quotient (cdr now) 1000) 30000)))))
(bluetooth-message! model (challenge "confirmation") send)
(write-fixture "bluetooth-pairing")
(bluetooth-message! model (challenge "passkey") send)
(write-fixture "bluetooth-keypad")
