(use-modules (bluetooth-ui) (ui) (json) (srfi srfi-1))
(define (check value message) (unless value (error message)))
(define (fails? thunk) (catch #t (lambda () (thunk) #f) (lambda _ #t)))
(define sent '())
(define (send value) (set! sent (cons value sent)))
(define adapter '((path . "/org/bluez/hci0") (address . "AA:00") (name . null) (alias . "Radio")
                  (powered . #t) (discovering . #f) (pairable . #t)))
(define device '((path . "/org/bluez/hci0/dev_AA") (adapter . "/org/bluez/hci0")
                 (address . "AA:BB") (name . null) (alias . "Headphones") (icon . null)
                 (connected . #f) (paired . #f) (trusted . #f) (blocked . #f) (rssi . null) (battery_percentage . null)))
(define available `((version . 1) (service . "bluetooth") (status . "available") (observed_at_ms . 1)
                    (state . ((owner . ":1.42") (adapters . ,(vector adapter)) (devices . ,(vector device)))) (error . null)))
(define unavailable '((version . 1) (service . "bluetooth") (status . "unavailable") (observed_at_ms . 2)
                      (state . null) (error . "BlueZ unavailable")))
(define (wire value) (json-string->scm (scm->json-string value)))
(define model (make-bluetooth-ui))
(define (feed value) (bluetooth-message! model (wire value) send))
(define (nodes) (bluetooth-nodes model))
(define (click key) (nodes) (bluetooth-activate! model key send))
(define challenge-id 0)
(define (challenge kind)
  (set! challenge-id (+ challenge-id 1))
  `((type . "challenge") (request_id . ,(let ((pending ((@@ (bluetooth-ui) pending) model))) (if pending (assoc-ref pending 'id) "old"))) (challenge_id . ,challenge-id) (owner . ":1.42") (device . "/org/bluez/hci0/dev_AA")
    (kind . ,kind) (passkey . 123456) (pin . "1234") (entered . null) (uuid . null)
    (deadline_ms . ,(+ ((@@ (bluetooth-ui) now-ms)) 30000))))
(feed unavailable)
(check (> (vector-length (nodes)) 0) "Unavailable service crashes UI")
(check (ui-field (bluetooth-data model) "sensitive") "Bluetooth scene must block durable mirroring")
(feed available) (nodes)
(define (input epoch seq)
  `((type . "input") (channel . "bluetooth") (epoch . ,epoch) (seq . ,seq) (key . "device-0-1") (event . "activate")))
(bluetooth-input! model (input 1 1) "bluetooth" 2 1 1 send)
(bluetooth-input! model (input 2 0) "bluetooth" 2 1 1 send)
(bluetooth-input! model (input 2 1) "bluetooth" 2 1 2 send)
(check (null? sent) "Stale epoch/sequence input caused action")
(bluetooth-input! model (input 2 1) "bluetooth" 2 1 1 send)
(check (equal? "pair" (ui-field (ui-field (ui-field (car sent) "request") "action") "action")) "Valid activation did not request pairing")
(define action-count (length sent))
(click "device-0-1")
(check (= action-count (length sent)) "Double click sent duplicate action")
(feed (challenge "pin"))
(click "char-0") (click "keyboard") (click "char-0") (click "keyboard") (click "char-0")
(check (equal? "aA " (bluetooth-entry model)) "PIN keyboard must support case and space")
(check (not (string-contains (scm->json-string (bluetooth-data model)) "aA ")) "PIN leaked into semantic data")
(check (not (string-contains (scm->json-string (nodes)) "aA ")) "Entered PIN must be masked in scene")
(click "backspace") (click "submit")
(check (equal? "aA" (ui-field (ui-field (car sent) "reply") "value")) "Exact PIN not sent")
(check (not (bluetooth-challenge model)) "Submitted PIN retained prompt")
(check (equal? "" (bluetooth-entry model)) "Submitted PIN retained entry")
(feed '((type . "result") (request_id . "1") (status . "executed") (error . null)))
(click "device-0-1") (feed (challenge "passkey"))
(click "char-0") (click "char-0") (click "char-1") (click "char-2") (click "char-3") (click "char-4") (click "char-5")
(check (= 6 (string-length (bluetooth-entry model))) "Passkey exceeds six digits")
(click "submit")
(check (= 1234 (ui-field (ui-field (car sent) "reply") "value")) "Leading-zero passkey parsed incorrectly")
(feed '((type . "result") (request_id . "2") (status . "executed") (error . null)))
(click "device-0-1") (feed (challenge "confirmation"))
(check (string-contains (scm->json-string (nodes)) "123456") "Confirmation passkey must be visibly inspectable")
(click "reject")
(check (equal? "reject" (ui-field (ui-field (car sent) "reply") "kind")) "Reject did not reject")
(feed '((type . "result") (request_id . "3") (status . "rejected") (error . null)))
(click "device-0-1") (feed (challenge "pin")) (click "char-0")
(bluetooth-disconnected! model send)
(check (equal? "cancel" (ui-field (car sent) "type")) "Renderer disconnect must cancel pairing")
(check (not (bluetooth-challenge model)) "Renderer disconnect retains challenge")
(check (equal? "" (bluetooth-entry model)) "Renderer disconnect retains secret")
(click "device-0-1") (feed (challenge "pin"))
(bluetooth-expire! model send (+ ((@@ (bluetooth-ui) now-ms)) 31000))
(check (not (bluetooth-challenge model)) "Expired prompt retained")
(check (equal? "cancel" (ui-field (car sent) "type")) "Expired pairing not cancelled")
(click "device-0-1") (feed (challenge "pin")) (feed unavailable)
(check (not (bluetooth-challenge model)) "Owner disappearance must clear prompt")
(check (equal? "cancel" (ui-field (car sent) "type")) "Owner disappearance must cancel pairing")
(feed available)
(feed (challenge "pin"))
(check (not (bluetooth-challenge model)) "Unsolicited prompt accepted")
(define (change object key value) (acons key value (alist-delete key object)))
(define many
  (change available 'state
    (change (assq-ref available 'state) 'devices
      (list->vector (map (lambda (n) (change device 'path (format #f "/org/bluez/hci0/dev_~a" n))) (iota 7))))))
(feed many)
(check (string-contains (scm->json-string (nodes)) "4 more") "Overflow count missing")
(click "next") (click "next")
(check (string-contains (scm->json-string (nodes)) "7–7 of 7") "Last device page hidden")

(define pair (pipe))
(define reader ((@@ (bluetooth-ui) pipe-reader) (car pair)))
(setvbuf (cdr pair) 'none)
(display "{\"type\":" (cdr pair))
(check (not (reader)) "Partial worker JSON must remain buffered")
(display "\"result\"}\n" (cdr pair))
(check (equal? "result" (ui-field (reader) "type")) "Fragmented worker JSON lost")
((@@ (bluetooth-ui) pipe-write!) (cdr pair) '((type . "cancel")))
(check (equal? "cancel" (ui-field (reader) "type")) "Bounded worker writer failed")
(close-port (car pair)) (close-port (cdr pair))
(set! model (make-bluetooth-ui)) (feed available) (click "device-0-1")
(define stale-challenge (challenge "display_passkey"))
(feed stale-challenge) (click "submit")
(define sent-before-duplicate (length sent))
(feed stale-challenge)
(check (= sent-before-duplicate (length sent)) "Duplicate display after reply cancelled an accepted pairing")
(check (not (bluetooth-challenge model)) "Duplicate display reopened accepted prompt")
(bluetooth-disconnected! model send)
(feed stale-challenge)
(check (not (bluetooth-challenge model)) "Late cancelled challenge reopened prompt")
(click "device-0-1")
(feed stale-challenge)
(check (not (bluetooth-challenge model)) "Old request challenge attached to a new pair attempt")
(display "Bluetooth UI tests passed\n")
