(use-modules (json) (ice-9 match) (srfi srfi-1))
(define (check value message) (unless value (error message)))
(define (fake-worker service lifetime)
  (setvbuf (current-output-port) 'none)
  (scm->json
    `((version . 1) (service . ,service) (status . "available") (observed_at_ms . 1) (error . null)
      (state . ,(if (equal? service "bluetooth")
                    '((owner . ":1.42") (adapters . #()) (devices . #()))
                    '((session . "private-audio") (core_cookie . 42) (devices . #()) (nodes . #())
                      (defaults . ((sink . null) (source . null) (configured_sink . null) (configured_source . null))))))))
  (newline)
  (if (equal? lifetime "eof") (usleep 500000)
      (let loop () (unless (eof-object? (read-char)) (loop)))))
(define (child-pids pid)
  (catch #t
    (lambda ()
      (call-with-input-file (format #f "/proc/~a/task/~a/children" pid pid)
        (lambda (port)
          (let loop ((result '()))
            (let ((value (read port)))
              (if (eof-object? value) result (loop (cons value result))))))))
    (lambda _ '())))
(define (stop pid)
  (catch #t (lambda () (kill pid SIGKILL)) (lambda _ #f)))
(define (lifecycle signal bluez-lifetime)
  (let* ((pid (primitive-fork)) (children '()) (reaped? #f))
    (if (zero? pid)
        (execlp "guile" "guile" "-L" "scheme" "scheme/audio-ui.scm"
                "/tmp/hearth-audio-private-no-renderer.sock"
                "--bluetooth-worker" "guile" "-L" "scheme" "tests/bluetooth_audio_process.scm" "--fake-worker" "bluetooth" bluez-lifetime
                "--audio-worker" "guile" "-L" "scheme" "tests/bluetooth_audio_process.scm" "--fake-worker" "pipewire" "wait")
        (dynamic-wind
          (lambda () #t)
          (lambda ()
            (set! children
              (let wait ((remaining 500))
                (let ((found (child-pids pid)))
                  (cond ((= 2 (length found)) found)
                        ((zero? remaining) (error "Dual audio/BlueZ workers did not start"))
                        (else (usleep 10000) (wait (- remaining 1)))))))
            (when (equal? bluez-lifetime "eof")
              (let wait ((remaining 500))
                (cond ((= 1 (length (child-pids pid))) #t)
                      ((zero? remaining) (error "Exited BlueZ worker was not reaped"))
                      (else (usleep 10000) (wait (- remaining 1)))))
              (check (zero? (car (waitpid pid WNOHANG))) "Controller stopped when the BlueZ worker exited"))
            (usleep 100000) (kill pid signal)
            (let wait ((remaining 600))
              (let ((result (waitpid pid WNOHANG)))
                (cond ((not (zero? (car result)))
                       (set! reaped? #t)
                       (check (equal? 0 (status:exit-val (cdr result))) "Controller signal cleanup exited abnormally"))
                      ((zero? remaining) (error "Dual-worker controller failed bounded shutdown"))
                      (else (usleep 10000) (wait (- remaining 1))))))
            (for-each (lambda (child)
                        (check (not (file-exists? (format #f "/proc/~a" child))) "Audio/BlueZ child survived controller termination")) children))
          (lambda ()
            (unless reaped?
              (for-each stop (append children (child-pids pid)))
              (stop pid)
              (catch #t (lambda () (waitpid pid)) (lambda _ #f))))))))
(match (cdr (command-line))
  (("--fake-worker" service lifetime) (fake-worker service lifetime))
  (() (lifecycle SIGTERM "wait") (lifecycle SIGINT "wait") (lifecycle SIGTERM "eof")
      (display "Bluetooth-to-audio process lifecycle tests passed\n"))
  (_ (error "Unexpected private lifecycle test arguments")))
