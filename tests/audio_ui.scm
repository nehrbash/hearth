(use-modules (audio-ui) (ui) (json) (srfi srfi-1))
(define (check value message) (unless value (error message)))
(define (change object key value) (acons key value (alist-delete key object)))
(define (wire value) (json-string->scm (scm->json-string value)))
(define node
  '((id . 10) (serial . 100) (device_id . 1) (kind . "sink") (name . "output")
    (description . "Speakers") (application_name . null) (state . "running") (ready . #t)
    (channels . #(3 4)) (channel_volumes_linear . #(0.125 0.125)) (mute . #t)
    (capabilities . ((volume . #t) (mute . #t) (default . #t)))))
(define state
  `((session . "audio-session") (core_cookie . 42)
    (devices . #(((id . 1) (serial . 90) (name . "card") (description . null) (api . "alsa"))))
    (nodes . ,(vector node))
    (defaults . ((sink . "other") (source . null) (configured_sink . null) (configured_source . null)))))
(define envelope `((version . 1) (service . "pipewire") (status . "available") (observed_at_ms . 1) (state . ,state) (error . null)))
(define model (make-audio-ui))
(define sent '())
(define (send request) (set! sent (cons request sent)))
(define (feed value) (audio-message! model (wire value)))
(define (nodes) (audio-nodes model))
(define (resolved suffix)
  (let ((keys (map (lambda (node) (ui-field node "key")) (vector->list (nodes)))))
    (or (find (lambda (key) (and (string-prefix? "view-" key) (string-suffix? (string-append "-" suffix) key))) keys) suffix)))
(define (click key) (audio-activate! model (resolved key) send))
(feed envelope)
(check (< (abs (- 0.5 (audio-volume node))) 0.0001) "Raw0.125 must display50% perceptual")
(check (< (abs (- 0.25 (audio-volume (change node 'channel_volumes_linear #(0 0.125))))) 0.0001) "Perceptual volume must average channels, not use peak")
(check (string-contains (scm->json-string (nodes)) "50%") "Perceptual percentage missing")
(define key (resolved "10-up"))
(define (input epoch seq)
  `((type . "input") (channel . "audio") (epoch . ,epoch) (seq . ,seq) (event . "activate") (key . ,key)))
(audio-input! model (input 1 1) 2 1 1 send)
(audio-input! model (input 2 0) 2 1 1 send)
(audio-input! model (input 2 1) 2 1 2 send)
(check (null? sent) "Stale frame input changed audio")
(audio-input! model (input 2 1) 2 1 1 send)
(define request (ui-field (car sent) "request"))
(check (equal? "audio-session" (ui-field request "session")) "Action lacks session identity")
(check (= 10 (ui-field request "id")) "Action lacks node ID")
(check (= 100 (ui-field request "serial")) "Action lacks node serial")
(check (< (abs (- 0.6 (ui-field (ui-field request "action") "value"))) 0.0001) "Volume command must remain perceptual")
(check (eq? #t (ui-field (ui-field request "action") "unmute")) "Volume adjustment must request atomic unmute")
(click "10-up") (check (= 1 (length sent)) "Double click sent duplicate request")
(feed '((type . "result") (request_id . "1") (status . "unknown") (error . null)))
(check (= 1 (length sent)) "Unknown outcome retried automatically")
(check (string-contains (scm->json-string (nodes)) "Outcome unknown") "Unknown result not explicit")
(define old-key (resolved "10-up"))
(feed (change envelope 'state (change state 'nodes (vector (change node 'serial 101)))))
(check (not (equal? old-key (resolved "10-up"))) "Reused node retained pressed mutation key")
(define before (length sent)) (audio-activate! model old-key send)
(check (= before (length sent)) "Retired pressed mutation executed")
(click "10-mute")
(check (eq? #f (ui-field (ui-field (ui-field (car sent) "request") "action") "value")) "Mute button did not request independent unmute")
(feed '((type . "result") (request_id . "2") (status . "applied") (error . null)))
(click "10-default")
(check (equal? "default" (ui-field (ui-field (ui-field (car sent) "request") "action") "action")) "Default selection missing")
(audio-disconnected! model)
(define count-before (length sent)) (click "10-up")
(check (= count-before (length sent)) "Disconnected old envelope exposed controls")
(feed envelope)
(check (= count-before (length sent)) "Reconnect replayed mutation")
(define unknown (change (change (change node 'kind "source") 'serial 'null) 'channel_volumes_linear 'null))
(feed (change envelope 'state (change state 'nodes (vector (change unknown 'mute 'null)))))
(click "inputs")
(check (string-contains (scm->json-string (nodes)) "Volume unknown") "Unknown volume fabricated")
(check (string-contains (scm->json-string (nodes)) "controls not ready") "Unknown identity enables controls")
(check (not (any (lambda (item) (string-suffix? "10-up" (ui-field item "key"))) (vector->list (nodes)))) "Unknown serial still has volume button")
(feed (change envelope 'state (change state 'nodes (vector (change (change node 'channels #()) 'channel_volumes_linear #(0.125 0.125))))))
(click "outputs") (check (string-contains (scm->json-string (nodes)) "50%") "Unknown channelmap loses valid volume")
(feed (change envelope 'state (change state 'nodes
  (list->vector (map (lambda (id) (change node 'id id)) (iota 4 1))))))
(check (string-contains (scm->json-string (nodes)) "1 more") "Overflow count missing")
(click "next") (check (string-contains (scm->json-string (nodes)) "4–4 of 4") "Last page inaccessible")
(feed '((version . 1) (service . "pipewire") (status . "unavailable") (observed_at_ms . 2) (state . null) (error . "Server stopped")))
(check (equal? "unavailable" (ui-field (audio-data model) "status")) "Unavailable state hidden")
(check (> (vector-length (nodes)) 0) "Unavailable audio cannot render")
(display "Audio UI tests passed\n")
