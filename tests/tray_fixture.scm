(use-modules (tray-ui) (ui) (json) (srfi srfi-1))
(define icon
 `((width . 48) (height . 48) (rgba . ,(list->vector
  (append-map (lambda (i)
   (let ((x (modulo i 48)) (y (quotient i 48)))
    (if (< (+ (* (- x 24) (- x 24)) (* (- y 24) (- y 24))) 400)
      '(110 165 95 255) '(0 0 0 0)))) (iota 2304))))))
(define (menu-node id parent label enabled separator toggle state submenu)
 `((id . ,id) (parent . ,parent) (label . ,label) (enabled . ,enabled) (visible . #t)
   (separator . ,separator) (toggle_type . ,toggle) (toggle_state . ,state)
   (children_display . ,submenu) (icon_name . null) (icon . ,(if (= id 1) icon 'null))))
(define menu
 `((path . "/Menu") (revision . 7) (epoch . 1)
   (nodes . ,(vector
    (menu-node 0 'null "" #t #f 'null 0 "submenu")
    (menu-node 1 0 "Show library" #t #f 'null 0 'null)
    (menu-node 2 0 "Keep playing" #t #f "checkmark" 1 'null)
    (menu-node 3 0 "Download unavailable" #f #f 'null 0 'null)
    (menu-node 4 0 "" #t #t 'null 0 'null)
    (menu-node 5 0 "Balanced" #t #f "radio" 1 'null)
    (menu-node 6 0 "Output devices" #t #f 'null 0 "submenu")
    (menu-node 7 6 "Woodland speakers" #t #f 'null 0 'null)))))
(define (item index)
 `((service . ,(format #f "org.example.Tray~a" index)) (owner . ,(format #f ":1.~a" (+ index 10)))
   (path . "/StatusNotifierItem") (id . ,(number->string index))
   (title . ,(list-ref '("Woodland music" "Network connection" "Messages" "Background task") index))
   (category . "ApplicationStatus") (status . ,(if (= index 2) "NeedsAttention" "Active"))
   (icon_name . null) (icon . ,icon) (attention_icon_name . null) (attention_icon . ,icon)
   (overlay_icon_name . null) (overlay_icon . null)
   (tooltip . ((title . "Ready") (description . "Application controls are available")))
   (item_is_menu . #f) (menu . ,menu) (error . null) (menu_error . null) (icon_error . null)))
(define envelope
 `((version . 1) (service . "tray") (status . "available") (observed_at_ms . 1234) (error . null)
   (state . ((session . "fixture") (watcher_owner . ":1.2") (owns_watcher . #f)
             (items . ,(list->vector (map item (iota 4))))))))
(define model (make-tray-ui))
(define (feed value) (tray-message! model (json-string->scm (scm->json-string value))))
(feed envelope)
(define name (cadr (command-line)))
(when (equal? name "tray-menu")
 (let ((key (find (lambda (key) (string-suffix? "-0-menu" key))
                 (map (lambda (node) (ui-field node "key")) (vector->list (tray-nodes model))))))
  (tray-activate! model key (lambda _ #t)))
 (feed '((type . "result") (request_id . "1") (status . "applied") (error . null)))
 (feed envelope))
(when (equal? name "tray-unavailable")
 (feed '((version . 1) (service . "tray") (status . "unavailable") (observed_at_ms . 1235)
         (state . null) (error . "Status notifier watcher unavailable"))))
(scm->json `((nodes . ,(tray-nodes model)) (data . ,(tray-data model))))
(newline)
