(use-modules (bluetooth-audio) (ui) (json) (srfi srfi-1))
(define (check value message) (unless value (error message)))
(define (change object key value) (acons key value (alist-delete key object)))
(define (wire value) (json-string->scm (scm->json-string value)))
(define (field value key) (ui-field value key))
(define address "AA:BB:CC:DD:EE:FF")
(define adapter
  '((path . "/org/bluez/hci0") (address . "00:11:22:33:44:55") (name . null) (alias . "Test radio")
    (powered . #t) (discovering . #f) (pairable . #t)))
(define device
  `((path . "/org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF") (adapter . "/org/bluez/hci0")
    (address . ,address) (name . "Test headphones") (alias . "Test headphones") (icon . "audio-headset")
    (connected . #f) (paired . #t) (trusted . #t) (blocked . #f) (rssi . null) (battery_percentage . null)))
(define sink
  `((id . 10) (serial . 100) (device_id . 1) (kind . "sink") (name . "private-output")
    (description . "Test headphones") (application_name . null) (state . "idle") (ready . #t)
    (bluetooth_address . ,address) (channels . #(3 4)) (channel_volumes_linear . #(0.125 0.125)) (mute . #f)
    (capabilities . ((volume . #t) (mute . #t) (default . #t)))))
(define (bluez devices owner)
  `((version . 1) (service . "bluetooth") (status . "available") (observed_at_ms . 1) (error . null)
    (state . ((owner . ,owner) (adapters . ,(vector adapter)) (devices . ,devices)))))
(define (audio nodes session)
  `((version . 1) (service . "pipewire") (status . "available") (observed_at_ms . 1) (error . null)
    (state . ((session . ,session) (core_cookie . 42) (devices . #()) (nodes . ,nodes)
              (defaults . ((sink . null) (source . null) (configured_sink . null) (configured_source . null)))))))
(define (unavailable service)
  `((version . 1) (service . ,service) (status . "unavailable") (observed_at_ms . 2) (state . null) (error . "Stopped")))
(define model #f)
(define bluez-sent '())
(define audio-sent '())
(define (send-bluez request) (set! bluez-sent (append bluez-sent (list request))))
(define (send-audio request) (set! audio-sent (append audio-sent (list request))))
(define (feed service message time)
  (bluetooth-audio-update! model service (wire message) send-bluez send-audio time))
(define (reset)
  (set! model (make-bluetooth-audio)) (set! bluez-sent '()) (set! audio-sent '())
  (feed "bluetooth" (bluez (vector device) ":1.42") 100)
  (feed "pipewire" (audio #() "s1") 100))
(define (select!) (bluetooth-audio-select! model (wire device) send-bluez send-audio 101))
(define (result request status)
  `((type . "result") (request_id . ,(field request "request_id")) (status . ,status) (error . null)))
(define (connected!)
  (feed "bluetooth" (result (last bluez-sent) "executed") 102)
  (feed "bluetooth" (bluez (vector (change device 'connected #t)) ":1.42") 103))
(define (ready!) (feed "pipewire" (audio (vector sink) "s1") 104))
(reset)
(check (= 1 (length (bluetooth-audio-devices model))) "Paired offline audio candidate missing")
(select!)
(check (= 1 (length bluez-sent)) "Selection must send exactly one Connect")
(define connect-request (field (car bluez-sent) "request"))
(check (equal? ":1.42" (field connect-request "owner")) "Connect lacks BlueZ owner guard")
(check (equal? "connect" (field (field connect-request "action") "action")) "Selection did not request Connect")
(check (null? audio-sent) "Default sent before connection result")
(select!) (check (= 1 (length bluez-sent)) "Repeated selection started duplicate Connect")
(connected!)
(check (null? audio-sent) "Default guessed before matching sink exists")
(feed "pipewire" (audio (vector (change sink 'bluetooth_address "11:22:33:44:55:66")) "s1") 104)
(check (null? audio-sent) "Wrong Bluetooth sink selected")
(ready!)
(check (= 1 (length audio-sent)) "Matching sink did not produce one default request")
(define default-request (field (car audio-sent) "request"))
(check (equal? "s1" (field default-request "session")) "Default lacks PipeWire session")
(check (= 10 (field default-request "id")) "Default has wrong node ID")
(check (= 100 (field default-request "serial")) "Default lacks exact node serial")
(check (equal? address (field default-request "expected_bluetooth_address")) "Default lacks Bluetooth address guard")
(check (equal? "default" (field (field default-request "action") "action")) "Connect changed a property other than configured default")
(ready!) (check (= 1 (length audio-sent)) "Repeated state retried default")
(feed "pipewire" (result (car audio-sent) "applied") 105)
(check (not (bluetooth-audio-pending? model)) "Applied default left operation pending")

(for-each
 (lambda (bad-node)
   (reset) (select!) (connected!)
   (feed "pipewire" (audio (vector bad-node) "s1") 104)
   (check (null? audio-sent) "Unready or unidentified sink enabled default"))
 (list (change sink 'ready #f) (change sink 'serial 'null)
       (change sink 'kind "source") (change sink 'bluetooth_address 'null)
       (change sink 'capabilities '((volume . #t) (mute . #t) (default . #f)))))
(reset) (select!) (connected!)
(feed "pipewire" (audio (vector sink (change (change sink 'id 11) 'serial 101)) "s1") 104)
(check (null? audio-sent) "Ambiguous Bluetooth address selected arbitrary sink")

(for-each
 (lambda (changed)
   (reset) (select!)
   (feed "bluetooth" changed 102)
   (feed "bluetooth" (result (car bluez-sent) "executed") 103)
   (ready!)
   (check (null? audio-sent) "Stale BlueZ identity selected audio")
   (check (not (bluetooth-audio-pending? model)) "Stale BlueZ identity retained operation"))
 (list (bluez (vector device) ":1.43") (bluez #() ":1.42")
       (bluez (vector (change device 'address "11:22:33:44:55:66")) ":1.42")
       (unavailable "bluetooth")))
(reset) (select!) (connected!)
(feed "pipewire" (audio (vector sink) "s2") 104)
(check (null? audio-sent) "New PipeWire session accepted stale operation")
(check (not (bluetooth-audio-pending? model)) "PipeWire restart retained operation")

(for-each
 (lambda (status)
   (reset) (select!)
   (feed "bluetooth" (result (car bluez-sent) status) 102)
   (ready!) (bluetooth-audio-tick! model 50000)
   (check (null? audio-sent) "Failed/unknown connection led to default")
   (check (= 1 (length bluez-sent)) "Failed/unknown connection retried")
   (check (not (bluetooth-audio-pending? model)) "Failed connection retained operation"))
 '("rejected" "unknown" "failed"))
(for-each
 (lambda (status)
   (reset) (select!) (connected!) (ready!)
   (feed "pipewire" (result (car audio-sent) status) 105)
   (ready!) (bluetooth-audio-tick! model 50000)
   (check (= 1 (length audio-sent)) "Failed/unknown default retried")
   (check (not (bluetooth-audio-pending? model)) "Failed default retained operation"))
 '("rejected" "unknown"))
(for-each
 (lambda (finish)
   (reset) (select!) (finish)
   (feed "bluetooth" (result (car bluez-sent) "executed") 50002)
   (feed "pipewire" (audio (vector sink) "s1") 50003)
   (check (null? audio-sent) "Late observation resumed terminated operation")
   (check (not (bluetooth-audio-pending? model)) "Terminated operation became pending"))
 (list (lambda () (bluetooth-audio-cancel! model))
       (lambda () (bluetooth-audio-tick! model 30102))
       (lambda () (feed "pipewire" (unavailable "pipewire") 102))))
(reset) (select!) (connected!) (ready!)
(define old-default (car audio-sent))
(feed "pipewire" (audio (vector (change sink 'serial 999)) "s1") 105)
(feed "pipewire" (result old-default "applied") 106)
(check (not (bluetooth-audio-pending? model)) "Recycled sink identity retained pending default")
(check (= 1 (length audio-sent)) "Recycled sink caused automatic mutation replay")

(reset) (select!)
(define retired-connect (car bluez-sent))
(bluetooth-audio-cancel! model)
(select!)
(check (not (equal? (field retired-connect "request_id") (field (last bluez-sent) "request_id"))) "New attempt reused request ID")
(feed "bluetooth" (result retired-connect "executed") 102)
(ready!)
(check (null? audio-sent) "Old connect result authorized new operation")
(display "Bluetooth-to-audio orchestration tests passed\n")
