(use-modules (services) (json) (rnrs bytevectors)
             ((rnrs io ports) #:select (open-bytevector-input-port))
             (srfi srfi-1) (srfi srfi-13))

(define (check value message) (unless value (error message)))
(define (fails? thunk) (catch #t (lambda () (thunk) #f) (lambda _ #t)))
(define state
  '(("instance" . "fixture-current")
    ("monitors" . #((("name" . "DP-1") ("focused" . #t)
                     ("active_workspace" . 12) ("special_workspace" . -98))))
    ("workspaces" . #((("id" . 12) ("name" . "writing") ("monitor" . "DP-1") ("windows" . 2))
                       (("id" . -98) ("name" . "special:mini") ("monitor" . "DP-1") ("windows" . 1))))))
(define envelope
  `(("version" . 1) ("service" . "hyprland") ("status" . "available")
    ("observed_at_ms" . 1795149908000) ("state" . ,state) ("error" . null)))
(define unavailable
  '(("version" . 1) ("service" . "hyprland") ("status" . "unavailable")
    ("observed_at_ms" . 1795149909000) ("state" . null) ("error" . "Compositor disconnected\nRetrying discovery")))
(define (replace object key value)
  (map (lambda (entry) (if (equal? (car entry) key) (cons key value) entry)) object))
(define (encoded value) (scm->json-string value))
(define (decode value) (hearth-service-decode (encoded value)))
(define (input lines)
  (open-bytevector-input-port (string->utf8 (string-join lines "\n"))))
(define publications '())
(define attempts 0)
(define reject-first? #f)
(define (publish expression)
  (set! attempts (+ attempts 1))
  (if (and reject-first? (= attempts 1)) (error "Mock broker unavailable")
      (let* ((form (call-with-input-string expression read))
             (saved (cadr form)) (zone (caddr form))
             (service (assq-ref (cadr (caddr saved)) 'service))
             (name (string->symbol (string-append "hearth-" service))))
        (check (eq? 'begin (car form)) "Expected fixed begin")
        (check (= 4 (length form)) "Unexpected executable forms")
        (check (and (eq? 'saved-set! (car saved))
                    (equal? `(quote ,name) (cadr saved))
                    (eq? 'quote (caaddr saved))) "Saved data must be quoted")
        (check (and (eq? 'zone-set! (car zone))
                    (equal? `(quote ,name) (cadr zone))
                    (equal? '(quote table) (caddr zone))
                    (eq? 'quote (car (cadddr zone)))) "Zone rows must be quoted")
        (let ((rows (cadr (cadddr zone))))
          (check (every (lambda (row) (= 2 (length row))) rows) "Zone table must fit two columns")
          (check (equal? '("Name" "State") (car rows)) "Missing readable table header")
          (check (equal? (cond ((equal? service "hyprland") "Hyprland") ((equal? service "upower") "UPower") (else "MPRIS")) (caadr rows)) "Availability should be the first data row")
          (check (equal? "Observed UTC ms" (caaddr rows)) "Observation time should be visible early"))
        (set! publications (cons form publications))
        "((status . ok) (value . \"#t\") (truncated . #f))")))
(define (saved form) (cadr (caddr (cadr form))))

(check (equal? (assoc-ref (decode envelope) "status") "available") "Valid state changed")
(check (equal? (assoc-ref (decode unavailable) "error") (assoc-ref unavailable "error")) "Unavailable state changed")
(for-each
  (lambda (bad) (check (fails? (lambda () (decode bad))) "Malformed envelope was accepted"))
  (list (replace envelope "version" 2)
        (replace envelope "service" "other")
        (replace envelope "observed_at_ms" -1)
        (replace envelope "observed_at_ms" 18446744073709551616)
        (replace envelope "error" "Unexpected")
        (replace unavailable "state" state)
        (replace unavailable "error" "")
        (replace unavailable "error" (make-string 4097 #\x))
        (cons '("version" . 1) envelope)
        (replace envelope "state" (replace state "instance" "../wrong")))
  )
(check (fails? (lambda () (hearth-service-decode (string-append (encoded envelope) " {}")))) "Trailing JSON accepted")
(check (fails? (lambda () (hearth-service-decode (make-string 1048577 #\x)))) "Oversized message accepted")

(define hostile "\"); (system \"must-not-execute\"); (quote \"こんにちは")
(define hostile-state
  (replace state "workspaces"
    (vector `(("id" . 12) ("name" . ,hostile) ("monitor" . "DP-1") ("windows" . 2)))))
(hearth-service-publish! (replace envelope "state" hostile-state) #:command publish)
(check (equal? hostile (assq-ref (car (assq-ref (assq-ref (saved (car publications)) 'state) 'workspaces)) 'name))
       "Hostile string must remain inert exact data")
(check (not (hearth-service-stream (input (list "not-json")) #:once? #t #:command publish)) "Malformed once input succeeded")
(check (fails? (lambda () (hearth-service-publish! envelope #:command (lambda _ "((status . error))")))) "Broker rejection accepted")

(set! publications '()) (set! attempts 0) (set! reject-first? #t)
(check (hearth-service-stream (input (list (encoded envelope) (encoded envelope)))
                              #:command publish #:now (lambda () 1795149910000))
       "Stream should retry on the next heartbeat and publish stopped at EOF")
(check (= attempts 3) "Expected initial failure, heartbeat retry, EOF publication")
(check (= 1795149910000 (assq-ref (saved (car publications)) 'observed_at_ms)) "EOF should timestamp its unavailable observation")
(check (= (length publications) 2) "Expected heartbeat and stopped publications")
(check (equal? "unavailable" (assq-ref (saved (car publications)) 'status)) "EOF must mark stopped")
(check (eq? #f (assq-ref (saved (car publications)) 'state)) "EOF must not preserve apparently current state")
(check (equal? "available" (assq-ref (saved (cadr publications)) 'status)) "Heartbeat did not recover")

(set! publications '()) (set! attempts 0) (set! reject-first? #f)
(check (hearth-service-stream (input (list (encoded envelope))) #:once? #t #:command publish) "Once publication failed")
(check (= attempts 1) "Once must not publish a fake EOF failure")
(check (equal? 1795149908000 (assq-ref (saved (car publications)) 'observed_at_ms)) "Once must preserve observed time")

(set! publications '()) (set! attempts 0)
(check (hearth-service-stream (input (list (make-string 1048577 #\x) (encoded unavailable)))
                              #:command publish #:now (lambda () 1795149910000))
       "Oversized line should be discarded before the next valid record")
(check (= attempts 2) "Oversized line must never publish")
(check (not (hearth-service-stream (input (list (encoded envelope))) #:once? #t
                                   #:command (lambda _ (error "Mock publication failure"))))
       "Once publication failure must fail")
(define large-state
  (replace state "workspaces"
    (list->vector (map (lambda (id)
                        `(("id" . ,id) ("name" . ,(make-string 1024 #\x))
                          ("monitor" . "DP-1") ("windows" . 0)))
                      (iota 512 1)))))
(define capped? #f)
(catch #t
  (lambda () (hearth-service-publish! (replace envelope "state" large-state)
                                    #:command (lambda _ (error "Must reject before command invocation"))))
  (lambda (key . arguments)
    (set! capped? (string-contains ((@@ (services) error-description) arguments) "120 KiB"))))
(check capped? "Large valid state needs an explicit argv publication limit")
(define invalid-utf8 (make-bytevector 2))
(bytevector-u8-set! invalid-utf8 0 255) (bytevector-u8-set! invalid-utf8 1 10)
(check (not (hearth-service-stream (open-bytevector-input-port invalid-utf8) #:once? #t #:command publish))
       "Invalid UTF-8 accepted")


(define absent '(("on_battery" . #f) ("display" . (("presence" . "absent")))))
(define battery
  '(("presence" . "present") ("kind" . "battery") ("raw_kind" . 2)
    ("state" . "charging") ("raw_state" . 1)
    ("charge" . (("kind" . "percentage") ("value" . 47.5)))
    ("time_to_empty_seconds" . null) ("time_to_full_seconds" . 3600)))
(define (power-envelope device)
  (replace (replace envelope "service" "upower") "state" device))
(define (present device)
  `(("on_battery" . #f) ("display" . ,device)))
(define (rows form) (cadr (cadddr (caddr form))))
(define (cell table key) (cadr (assoc key table)))

(set! publications '()) (set! attempts 0)
(hearth-service-publish! (power-envelope absent) #:command publish)
(let ((table (rows (car publications))))
  (check (equal? '("Battery / UPS" "Absent") (list-ref table 3)) "Absence must be visible before other details")
  (check (not (assoc "Charge" table)) "Absent battery must not show 0 percent")
  (check (equal? "No" (cell table "On battery")) "Separate on-battery field missing"))
(hearth-service-publish! (power-envelope (present battery)) #:command publish)
(let ((table (rows (car publications))))
  (check (equal? "Charging" (cell table "Battery")) "Charging state missing")
  (check (equal? "No" (cell table "On battery")) "OnBattery must not be inferred from charging")
  (check (equal? "47.5%" (cell table "Charge")) "Percentage changed")
  (check (equal? "Unknown" (cell table "Time to empty")) "Unknown time rendered as zero")
  (check (equal? "1 h 0 min" (cell table "Time to full")) "Known time missing"))
(for-each
  (lambda (level)
    (hearth-service-publish! (power-envelope (present (replace battery "charge" `(("kind" . "coarse") ("level" . ,level))))) #:command publish)
    (let ((charge (cell (rows (car publications)) "Charge")))
      (check (string-contains charge "(coarse)") "Coarse levels must be labelled")
      (check (not (string-contains charge "%")) "Coarse level invented a percentage")))
  '("low" "critical" "normal" "high" "full"))
(define unknown-device
  (replace (replace (replace (replace (replace battery "kind" "unknown") "raw_kind" 99)
                             "state" "unknown") "raw_state" 99)
           "charge" '(("kind" . "unknown") ("raw_level" . 99))))
(hearth-service-publish! (power-envelope (present unknown-device)) #:command publish)
(check (equal? "Unknown" (cell (rows (car publications)) "Charge")) "Unknown level must remain unknown")
(check (equal? 99 (assq-ref (assq-ref (assq-ref (saved (car publications)) 'state) 'display) 'raw_state))
       "Unknown raw state must be retained")
(for-each
  (lambda (bad) (check (fails? (lambda () (decode (power-envelope bad)))) "Malformed UPower state accepted"))
  (list (replace absent "on_battery" "false")
        (replace absent "display" '(("presence" . "absent") ("percentage" . 0)))
        (present (replace battery "raw_kind" 3))
        (present (replace battery "raw_state" 2))
        (present (replace battery "time_to_full_seconds" 0))
        (present (replace battery "time_to_empty_seconds" -1))
        (present (replace battery "charge" '(("kind" . "percentage") ("value" . 101))))
        (present (replace battery "charge" '(("kind" . "coarse") ("level" . "empty"))))
        (present (replace battery "charge" '(("kind" . "unknown") ("raw_level" . 1))))))

(set! publications '()) (set! attempts 0)
(check (hearth-service-stream (input (list (encoded envelope) (encoded (power-envelope absent)) (encoded (power-envelope absent))))
                              #:command publish #:now (lambda () 1795149920000))
       "Mixed stream failed")
(check (= 5 attempts) "Mixed EOF must publish once per seen service, not per heartbeat")
(let ((stopped (filter (lambda (form) (equal? "unavailable" (assq-ref (saved form) 'status))) publications)))
  (check (= 2 (length stopped)) "Both services need an EOF observation")
  (check (equal? '("hyprland" "upower") (sort (map (lambda (form) (assq-ref (saved form) 'service)) stopped) string<?))
         "EOF stopped the wrong services"))
(define eof-services '())
(define (eof-publisher expression)
  (let* ((form (call-with-input-string expression read)) (data (saved form)))
    (when (equal? "unavailable" (assq-ref data 'status))
      (set! eof-services (cons (assq-ref data 'service) eof-services))
      (when (equal? "upower" (assq-ref data 'service))
        (error "Mock UPower EOF failure"))))
  (publish expression))
(check (not (hearth-service-stream (input (list (encoded envelope) (encoded (power-envelope absent))))
                                  #:command eof-publisher))
       "Partial EOF failure must return failure")
(check (= 2 (length eof-services)) "One EOF publication failure must not skip other services")


(define player
  '(("name" . "org.mpris.MediaPlayer2.fixture") ("owner" . ":1.42")
    ("identity" . "Fixture Player") ("playback_status" . "playing")
    ("metadata" . (("track_id" . "/track/one") ("title" . "A song") ("artist" . #("First" "Second"))
                    ("album" . null) ("length_us" . 185000000) ("art_url" . null) ("url" . null)))
    ("position_us" . 65000000) ("volume" . 0.7) ("rate" . 1.0)
    ("shuffle" . null) ("loop_status" . "none")
    ("capabilities" . (("control" . #t) ("play" . #t) ("pause" . #t) ("next" . #f)
                        ("previous" . #f) ("seek" . #t)))))
(define (media-envelope players)
  (replace (replace envelope "service" "mpris") "state" `(("players" . ,players))))
(check (equal? (assoc-ref (decode (media-envelope (vector player))) "service") "mpris") "MPRIS roundtrip changed service")
(hearth-service-publish! (media-envelope (vector player)) #:command publish)
(let ((table (rows (car publications))))
  (check (equal? "Playing" (cell table "Fixture Player")) "Player playback state missing")
  (check (equal? "A song" (cell table "Title")) "Title missing")
  (check (equal? "First, Second" (cell table "Artist")) "Artist list missing")
  (check (equal? "1:05 / 3:05" (cell table "Position")) "Position or duration incorrect")
  (check (equal? "play, pause, seek" (cell table "Controls")) "Unsupported controls shown"))
(hearth-service-publish! (media-envelope #()) #:command publish)
(check (equal? "None" (cell (rows (car publications)) "Players")) "No players must be available, not an error")
(define unknown-media
  (replace (replace player "metadata"
                    '(("track_id" . null) ("title" . null) ("artist" . #())
                      ("album" . null) ("length_us" . null) ("art_url" . null) ("url" . null)))
           "capabilities" (replace (assoc-ref player "capabilities") "control" #f)))
(hearth-service-publish! (media-envelope (vector unknown-media)) #:command publish)
(let ((table (rows (car publications))))
  (check (equal? "Unknown" (cell table "Title")) "Missing title invented")
  (check (equal? "Unknown" (cell table "Artist")) "Missing artist invented")
  (check (equal? "1:05 / Unknown" (cell table "Position")) "Unknown length became zero")
  (check (equal? "Unavailable" (cell table "Controls")) "CanControl false must disable controls"))
(define hostile-player (replace player "metadata" (replace (assoc-ref player "metadata") "title" hostile)))
(hearth-service-publish! (media-envelope (vector hostile-player)) #:command publish)
(check (equal? hostile (assq-ref (assq-ref (car (assq-ref (assq-ref (saved (car publications)) 'state) 'players)) 'metadata) 'title))
       "Media title escaped quoted data")
(for-each
  (lambda (bad) (check (fails? (lambda () (decode (media-envelope (vector bad))))) "Malformed MPRIS player accepted"))
  (list (replace player "name" "org.mpris.MediaPlayer2.")
        (replace player "name" "org.mpris.MediaPlayer2.bad/name")
        (replace player "name" "other.service") (replace player "owner" "well.known") (replace player "owner" ":bad")
        (replace player "playback_status" "buffering") (replace player "position_us" -1)
        (replace player "position_us" 9223372036854775808) (replace player "volume" -0.1)
        (replace player "rate" 0) (replace player "shuffle" "false") (replace player "loop_status" "invalid")
        (replace player "identity" (make-string 4097 #\x))
        (replace player "metadata" (replace (assoc-ref player "metadata") "artist" (make-vector 33 "a")))
        (replace player "metadata" (replace (assoc-ref player "metadata") "artist" #("a" 42)))
        (replace player "metadata" (replace (assoc-ref player "metadata") "length_us" -1))
        (replace player "metadata" (replace (assoc-ref player "metadata") "track_id" "/bad-path"))
        (replace player "capabilities" (replace (assoc-ref player "capabilities") "seek" "yes"))))
(check (fails? (lambda () (decode (media-envelope (vector player player))))) "Duplicate player names accepted")
(check (fails? (lambda () (decode (media-envelope (make-vector 33 player))))) "Excess players accepted")
(define media-unavailable (replace unavailable "service" "mpris"))
(hearth-service-publish! media-unavailable #:command publish)
(check (equal? "Compositor disconnected Retrying discovery" (cell (rows (car publications)) "Diagnostic")) "Unavailable media diagnostic missing")
(define huge-player
  (replace player "metadata" (replace (assoc-ref player "metadata") "artist" (make-vector 32 (make-string 4096 #\x)))))
(set! capped? #f)
(catch #t
  (lambda () (hearth-service-publish! (media-envelope (vector huge-player))
                                    #:command (lambda _ (error "Must reject oversized media before executing"))))
  (lambda (key . arguments)
    (set! capped? (string-contains ((@@ (services) error-description) arguments) "120 KiB"))))
(check capped? "Oversize media lacks explicit publication limit")
(set! publications '()) (set! attempts 0)
(check (hearth-service-stream (input (list (encoded envelope) (encoded (power-envelope absent))
                                         (encoded (media-envelope (vector player)))))
                              #:command publish #:now (lambda () 1795149920000)) "Three-service stream failed")
(check (= 6 attempts) "EOF must publish once for each of three services")
(display "Service exporter tests passed\n")
