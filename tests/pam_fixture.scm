(use-modules (pam-ui) (ui) (json) (srfi srfi-1) (srfi srfi-13))
(define model (make-pam-ui))
(define (send _) #t)
(define (feed message) (pam-message! model message send))
(define (click suffix)
  (let ((key (find (lambda (key) (string-suffix? suffix key))
                   (map (lambda (node) (ui-field node "key"))
                        (vector->list (pam-nodes model))))))
    (when key (pam-activate! model key send))))
(feed '((type . "ready") (session . "fixture") (service . "private-fixture")))
(define name (cadr (command-line)))
(unless (equal? name "pam")
  (click "-start")
  (feed '((type . "started") (session . "fixture") (request_id . "1")
          (attempt . "attempt-one") (deadline_ms . 18446744073709551615)))
  (feed '((type . "prompt") (session . "fixture") (attempt . "attempt-one")
          (prompt_id . "prompt-one") (style . "echo_off")
          (text . "Enter the private fixture response:") (response_required . #t)
          (deadline_ms . 18446744073709551615)))
  (click "-page")
  (for-each (lambda (_) (click "-key-97")) (iota 8)))
(when (equal? name "pam-failed")
  (feed '((type . "result") (session . "fixture") (attempt . "attempt-one")
          (request_id . "1") (status . "account_denied"))))
(scm->json `((nodes . ,(pam-nodes model)) (data . ,(pam-data model))))
(newline)
