(use-modules (audio-ui) (json) (srfi srfi-1))
(define (node id kind name description volumes mute)
 `((id . ,id) (serial . ,(+ 100 id)) (device_id . null) (kind . ,kind)
   (name . ,name) (description . ,description) (application_name . null)
   (state . "idle") (ready . #t) (channels . #(3 4))
   (channel_volumes_linear . ,volumes) (mute . ,mute)
   (capabilities . ((volume . #t) (mute . #t) (default . ,(if (member kind '("sink" "source")) #t #f))))))
(define envelope
 `((version . 1) (service . "pipewire") (status . "available")
   (observed_at_ms . 1795153000000) (error . null)
   (state . ((session . "fixture-session") (core_cookie . 42) (devices . #())
    (defaults . ((sink . "speakers") (source . "microphone")
                 (configured_sink . "headphones") (configured_source . null)))
    (nodes . ,(vector
      (node 1 "sink" "speakers" "Woodland speakers" #(0.125 0.125) #f)
      (node 2 "sink" "headphones" "Canopy headphones" #(0.512 0.216) #t)
      (node 3 "sink" "display" "Display audio" #(0.064 0.064) #f)
      (node 4 "sink" "studio" "Studio monitor" #(0.343 0.343) #f)
      (node 5 "source" "microphone" "Fern microphone" #(0.216 0.216) #t)
      (node 6 "playback" "player" "Music player" #(0.343 0.343) #f)))))))
(define model (make-audio-ui))
(define (send value) #t)
(audio-message! model (json-string->scm (scm->json-string envelope)))
(define name (cadr (command-line)))
(when (equal? name "audio-inputs")
 (audio-nodes model) (audio-activate! model "inputs" send))
(when (equal? name "audio-applications")
 (audio-nodes model) (audio-activate! model "applications" send))
(when (equal? name "audio-unavailable")
 (audio-message! model '((version . 1) (service . "pipewire") (status . "unavailable")
                        (observed_at_ms . 1795153000001) (state . null)
                        (error . "Audio server unavailable"))))
(scm->json `((nodes . ,(audio-nodes model)) (data . ,(audio-data model))))
(newline)
