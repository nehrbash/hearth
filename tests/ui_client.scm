(use-modules (ui) (widget) (ice-9 threads) (rnrs bytevectors) (srfi srfi-1))
(define (check value message) (unless value (error message)))
(define (fails? thunk) (catch #t (lambda () (thunk) #f) (lambda _ #t)))
(define (nonblocking port) (fcntl port F_SETFL (logior O_NONBLOCK (fcntl port F_GETFL))) port)
(define directory (mkdtemp (string-copy "/tmp/hearth-ui-tests-XXXXXX")))
(define path (string-append directory "/renderer.sock"))
(define listener (socket AF_UNIX SOCK_STREAM 0))
(bind listener AF_UNIX path) (listen listener 4)
(define epoch 0)
(define seq 0)
(define (hello port reader session)
  (let ((request (ui-read-json reader))) (check (equal? "hello" (ui-field request "type")) "Expected hello"))
  (ui-write-json! port `((type . "hello") (major . 2) (session_id . ,session)
                        (capabilities . #("channels" "patch" "inspect" "input" "presented"))))
  (let ((baseline (ui-read-json reader)))
    (check (equal? "baseline" (ui-field baseline "type")) "Expected full reconnect baseline")
    (check (> (ui-field baseline "epoch") epoch) "Reconnect epoch must increase")
    (check (= 10 (vector-length (ui-field baseline "nodes"))) "Reconnect lost unchanged nodes")
    (check (equal? (map (lambda (node) (ui-field node "key")) (vector->list (ui-field baseline "nodes")))
                   (map (lambda (node) (ui-field node "key")) (vector->list (widget-nodes))))
           "Upserts reordered retained siblings")
    (set! epoch (ui-field baseline "epoch")) (set! seq (ui-field baseline "seq"))
    baseline))
(define (ack port)
  (ui-write-json! port `((type . "ack") (channel . "widget") (epoch . ,epoch) (seq . ,seq)
                        (status . "applied") (reason . null))))
(define (activate port key)
  (ui-write-json! port `((type . "input") (channel . "widget") (epoch . ,epoch) (seq . ,seq)
                        (key . ,key) (event . "activate") (x . 40) (y . 140))))
(define (patch port reader expected)
  (let ((value (ui-read-json reader)))
    (check (equal? "patch" (ui-field value "type")) "Expected keyed patch")
    (check (= (+ seq 1) (ui-field value "seq")) "Patch sequence must increase")
    (check (= expected (ui-field (ui-field value "data") "counter")) "Scheme handler result differs")
    (check (= 3 (vector-length (ui-field value "upsert"))) "Patch should preserve unchanged node identities")
    (set! seq (ui-field value "seq")) (ack port) value))
(define server
  (call-with-new-thread
    (lambda ()
      (let* ((port (nonblocking (car (accept listener)))) (reader (ui-reader port)))
        (hello port reader "renderer-a") (ack port)
        (activate port "increment") (patch port reader 1)
        (activate port "increment") (patch port reader 11)
        (activate port "toggle")
        (let ((value (patch port reader 11)))
          (check (eq? #t (ui-field (ui-field value "data") "enabled")) "Toggle behavior belongs to Scheme"))
        (activate port "increment") (patch port reader 21)
        (let* ((last (patch port reader 31)) (request (ui-read-json reader)))
          (check (equal? "inspect" (ui-field request "type")) "Expected inspection")
          (ui-write-json! port `((type . "inspect") (channel . "widget") (request_id . ,(ui-field request "request_id"))
                                (epoch . ,epoch) (seq . ,seq) (nodes . ,(ui-field last "upsert"))
                                (data . ,(ui-field last "data")))))
        (close-port port))
      (for-each
        (lambda (index)
          (let* ((port (nonblocking (car (accept listener)))) (reader (ui-reader port))
                 (baseline (hello port reader (format #f "renderer-~a" index))))
            (check (= 31 (ui-field (ui-field baseline "data") "counter")) "Reconnect forgot Scheme state")
            (check (eq? #t (ui-field (ui-field baseline "data") "enabled")) "Reconnect forgot toggle")
            (ack port) (close-port port)))
        (iota 70)))))
(define client (make-ui-client path "widget" (widget-nodes) (widget-data)))
(widget-attach! client)
(define (receive-ack)
  (let ((message (ui-receive client))) (check (equal? "ack" (ui-field message "type")) "Expected acknowledgement")))
(ui-connect! client) (receive-ack)
(widget-handle! (ui-receive client)) (receive-ack)
(check (= 1 counter) "Initial Scheme increment missing")
(widget-control! "(set! on-activate (lambda (key) (if (equal? key \"increment\") (set! counter (+ counter 10)) (set! enabled? (not enabled?))) (publish-widget!)))")
(widget-handle! (ui-receive client)) (receive-ack)
(check (= 11 counter) "Compiled handler was not redefined")
(widget-handle! (ui-receive client)) (receive-ack)
(check enabled? "Toggle failed")
(widget-control! "(let ((previous on-activate)) (set! on-activate (lambda (key) (previous key) (previous key))))")
(widget-handle! (ui-receive client)) (receive-ack) (receive-ack)
(check (= 31 counter) "Live advice did not wrap the handler")
(ui-inspect! client "after-advice")
(let ((reply (ui-receive client)))
  (check (equal? "after-advice" (ui-field reply "request_id")) "Inspection identity missing")
  (check (= 31 (ui-field (ui-field reply "data") "counter")) "Inspection state differs"))
(for-each (lambda (index) (ui-connect! client) (receive-ack)
            (check (equal? (format #f "renderer-~a" index) (ui-session-id client)) "Renderer lifetime handshake lost")) (iota 70))
(ui-close! client) (join-thread server) (close-port listener) (delete-file path)
(check (fails? (lambda () (widget-control! "1 2"))) "Control must read exactly one expression")

(define pair (socketpair AF_UNIX SOCK_STREAM 0))
(nonblocking (car pair)) (nonblocking (cdr pair))
(check (fails? (lambda () (ui-write-json! (car pair) `((large . ,(make-string 1048577 #\x)))))) "Oversized outbound message accepted")
(send (car pair) (string->utf8 "{") 0)
(check (fails? (lambda () (ui-read-json (ui-reader (cdr pair)) 0.02))) "Partial reply escaped deadline")
(close-port (car pair)) (close-port (cdr pair))

(let* ((sockets (socketpair AF_UNIX SOCK_STREAM 0)) (reader (ui-reader (cdr sockets))))
  (send (car sockets) (string->utf8 "{\"type\":") 0)
  (check (not (ui-read-json reader 0)) "Nonblocking poll must retain an incomplete frame")
  (send (car sockets) (string->utf8 "\"ack\"}\n") 0)
  (check (equal? "ack" (ui-field (ui-read-json reader 0) "type")) "Fragmented frame was lost by nonblocking poll")
  (close-port (car sockets)) (close-port (cdr sockets)))

(define control-path (string-append directory "/control.sock"))
(define create-control (@@ (widget) control-socket))
(define control (create-control control-path))
(check (= #o600 (stat:perms (lstat control-path))) "Control socket must be private")
(check (fails? (lambda () (create-control control-path))) "Existing control socket was stolen")
(let ((port (socket AF_UNIX SOCK_STREAM 0)))
  (connect port AF_UNIX control-path)
  (ui-write-json! port '((code . "(set! counter 99)")))
  ((@@ (widget) serve-control!) control)
  (check (equal? "ok" (ui-field (ui-read-json (ui-reader port)) "status")) "Private control socket failed")
  (check (= 99 counter) "Private control did not change the dedicated UI process")
  (close-port port))
(close-port control) (delete-file control-path)
(chmod directory #o755)
(check (fails? (lambda () (create-control control-path))) "Shared control directory accepted")
(chmod directory #o700)
(let ((server (socket AF_UNIX SOCK_STREAM 0)))
  (bind server AF_UNIX path) (listen server 2)
  (let ((thread
          (call-with-new-thread
            (lambda ()
              (let* ((port (car (accept server))) (reader (ui-reader port)))
                (hello port reader "reject-before") (ack port)
                (let ((invalid (ui-read-json reader)))
                  (ui-write-json! port `((type . "ack") (channel . "widget") (epoch . ,epoch)
                                        (seq . ,(ui-field invalid "seq")) (status . "rejected") (reason . "Unknown node kind"))))
                (close-port port))
              (let* ((port (car (accept server))) (reader (ui-reader port))
                     (baseline (hello port reader "reject-after")))
                (check (= 31 (ui-field (ui-field baseline "data") "counter")) "Rejected data became a reconnect baseline")
                (check (every (lambda (node) (not (equal? "invalid" (ui-field node "kind"))))
                              (vector->list (ui-field baseline "nodes"))) "Rejected node was replayed")
                (ack port) (close-port port))))))
    (ui-connect! client) (receive-ack)
    (ui-patch! client #(((key . "counter-value") (kind . "invalid"))) #() #:data '((counter . 999)))
    (check (equal? "rejected" (ui-field (ui-receive client) "status")) "Rejected acknowledgement missing")
    (ui-connect! client) (receive-ack) (ui-close! client)
    (join-thread thread))
  (close-port server) (delete-file path))

(let ((server (socket AF_UNIX SOCK_STREAM 0)))
  (bind server AF_UNIX path) (listen server 1)
  (let ((thread (call-with-new-thread
                 (lambda ()
                   (let* ((port (car (accept server))) (reader (ui-reader port)))
                     (ui-read-json reader)
                     (ui-write-json! port '((type . "hello") (major . 3) (session_id . "bad") (capabilities . #())))
                     (close-port port))))))
    (check (fails? (lambda () (ui-connect! client))) "Unsupported renderer major accepted")
    (check (not (ui-port client)) "Failed handshake left a live client")
    (join-thread thread))
  (close-port server) (delete-file path))
(rmdir directory)
(display "UI client tests passed: handlers redefined/advised and 70 renderer reconnects\n")
