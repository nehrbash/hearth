(use-modules (weft-watch) (ice-9 match) (ice-9 ftw) (rnrs bytevectors))
(define (check value message) (unless value (error message)))
(define requests '())
(define (mock endpoint expression)
  (set! requests (cons (cons endpoint expression) requests))
  '((generation . "test") (notices)))
(watch-register! "eval" 'hearth-test #:command mock)
(let ((text (object->string (cdar requests))))
  (check (string-contains text "watch!") "Registration must use Weft watches")
  (check (string-contains text "event-emit!") "Zone changes must emit notices")
  (check (string-contains text "workspace-evaluate") "Observe mutations after evaluation"))
(watch-notices "eval" 'hearth-test 42 #:command mock)
(check (equal? (cdar requests) '(list (cons 'generation (assq-ref (workspace-state) 'generation))
                                    (cons 'notices (notice-inbox 'hearth-test 42)))) "Notice cursor lost")
(watch-remove! "eval" 'hearth-test #:command mock)
(check (string-contains (object->string (cdr (cadr requests))) "unwatch!") "Watch cleanup missing")
(check (string-contains (object->string (cdar requests)) "module-remove!") "Transient helper cleanup missing")
(let* ((directory (mkdtemp "/tmp/hearth-watch-XXXXXX"))
       (path (string-append directory "/state"))
       (port (watch-open (list directory))))
  (dynamic-wind
    (lambda () #t)
    (lambda ()
      (check (null? (car (select (list port) '() '() 0 10000))) "Idle watch must block")
      (call-with-output-file path (lambda (output) (display "first" output)))
      (check (pair? (car (select (list port) '() '() 1))) "Kernel notification missing")
      (watch-drain! port)
      (check (equal? "first" (watch-fingerprint path)) "State read mismatch")
      (check (null? (car (select (list port) '() '() 0 10000))) "Read must not cause notifications")
      (call-with-output-file (string-append path ".new") (lambda (output) (display "second" output)))
      (rename-file (string-append path ".new") path)
      (check (pair? (car (select (list port) '() '() 1))) "Atomic replacement notification missing")
      (watch-drain! port)
      (check (equal? "second" (watch-fingerprint path)) "Atomic replacement not read"))
    (lambda () (close-port port) (delete-file path) (rmdir directory))))
(display "Weft watch push tests passed\n")
