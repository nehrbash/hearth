(use-modules (notifications-ui) (ui) (json) (srfi srfi-1) (rnrs bytevectors))
(define (check value message) (unless value (error message)))
(define (fails? thunk) (catch #t (lambda () (thunk) #f) (lambda _ #t)))
(define (change object key value) (acons key value (alist-delete key object)))
(define (wire value) (json-string->scm (scm->json-string value)))
(define record
  '((id . 1) (revision . 1) (app_name . "Mail") (summary . "A message") (body . "Readable notification body")
    (actions . #(((key . "open") (label . "Open")) ((key . "reply") (label . "Reply"))
                  ((key . "archive") (label . "Archive"))))
    (urgency . 1) (resident . #f) (transient . #f) (app_icon . "mail") (image_path . null)
    (image . ((width . 2) (height . 1) (rgba . #(255 0 0 255 0 255 0 255))))
    (desktop_entry . null) (category . null) (popup . #t) (actionable . #t) (closed_reason . null) (created_at_ms . 1234)))
(define hidden (change (change record 'id 2) 'popup #f))
(define historical (change (change (change (change record 'id 3) 'actionable #f) 'popup #f) 'closed_reason 1))
(define transient (change (change (change record 'id 4) 'transient #t) 'body "SECRET_TRANSIENT_BODY"))
(define snapshot `((epoch . "server-epoch") (revision . 5) (dnd . #f) (fullscreen . #f)
                  (fullscreen_manual . #f) (fullscreen_automatic . #f) (fullscreen_source . "available") (fullscreen_error . null)
                   (active . ,(vector record hidden transient)) (history . ,(vector historical))))
(define model (make-notifications-ui))
(define sent '())
(define (send request) (set! sent (cons request sent)))
(define (feed value) (notifications-message! model (wire value)))
(define (nodes) (notifications-nodes model))
(define (resolved key)
  (let ((keys (map (lambda (node) (ui-field node "key")) (vector->list (nodes)))))
    (or (find (lambda (candidate) (and (string-prefix? "view-" candidate) (string-suffix? (string-append "-" key) candidate))) keys) key)))
(define (click key) (notifications-activate! model (resolved key) send))
(feed `((type . "state") (snapshot . ,snapshot)))
(check (ui-field (notifications-data model) "sensitive") "Transient scene content must not be mirrored")
(define encoded (scm->json-string (nodes)))
(check (string-contains encoded "Popups (2)") "Popup count conflated with active count")
(check (string-contains encoded "Active (3)") "Active count incorrect")
(check (string-contains encoded "History (1)") "History count incorrect")
(check (string-contains encoded "Active; popup hidden") "Hidden popup must remain distinguishable from history")
(check (any (lambda (node) (equal? "image" (ui-field node "kind"))) (vector->list (nodes))) "RGBA notification image missing")
(define (input epoch seq)
  `((type . "input") (channel . "notifications") (epoch . ,epoch) (seq . ,seq) (event . "activate") (key . ,(resolved "1-action-0"))))
(notifications-input! model (input 1 1) 2 1 1 send)
(notifications-input! model (input 2 0) 2 1 1 send)
(notifications-input! model (input 2 1) 2 1 2 send)
(check (null? sent) "Stale renderer input mutated server")
(notifications-input! model (input 2 1) 2 1 1 send)
(check (equal? "server-epoch" (ui-field (car sent) "epoch")) "Action lacks server epoch")
(check (= 5 (ui-field (car sent) "revision")) "Action lacks exact server revision")
(check (equal? "open" (ui-field (ui-field (car sent) "command") "key")) "Wrong action key")
(click "1-action-0")
(check (= 1 (length sent)) "Double click sent duplicate mutation")
(feed '((request_id . 1) (status . "rejected") (error . "stale")))
(check (= 1 (length sent)) "Rejected mutation retried automatically")
(click "1-more") (click "1-action-0")
(check (equal? "archive" (ui-field (ui-field (car sent) "command") "key")) "Overflow notification action inaccessible")
(feed '((request_id . 2) (status . "ok")))
(click "history") (nodes)
(define before (length sent)) (click "3-action-0")
(check (= before (length sent)) "History action invoked expired callback")
(click "3-group")
(check (equal? "Mail" (ui-field (ui-field (car sent) "command") "app_name")) "Clear group lost exact app name")
(feed '((request_id . 3) (status . "ok")))
(click "dnd")
(check (eq? #t (ui-field (ui-field (car sent) "command") "value")) "DND toggle incorrect")
(notifications-disconnected! model)
(define count-before (length sent)) (click "clear-all")
(check (= count-before (length sent)) "Disconnected UI sent mutation")
(feed `((type . "state") (snapshot . ,(change snapshot 'epoch "restarted"))))
(check (= count-before (length sent)) "Reconnect replayed mutation")
(click "clear-all")
(check (equal? "restarted" (ui-field (car sent) "epoch")) "Reconnect uses old server epoch")

(define observation (notifications-observation (wire snapshot) 5678))
(define observation-json (scm->json-string observation))
(check (not (string-contains observation-json "SECRET_TRANSIENT_BODY")) "Transient content entered durable observation")
(check (not (string-contains observation-json "rgba\":")) "Image byte array entered durable observation")
(check (= 1 (ui-field (ui-field observation "state") "withheld_transient_count")) "Withheld transient count missing")
(define publications '())
(notifications-publish! observation #:command (lambda (expression) (set! publications (cons expression publications)) "((status . ok))"))
(check (not (string-contains (object->string publications) "SECRET_TRANSIENT_BODY")) "Transient content entered publication expression")
(check (string-contains (object->string publications) "hearth-notifications") "Missing notification saved key")
(define large (change (change snapshot 'history (vector (change historical 'id 101))) 'active
               (list->vector (map (lambda (id) (change (change (change record 'id id) 'body (make-string 16384 #\x)) 'image 'null)) (iota 100 1)))))
(define large-observation (notifications-observation (wire large) 1))
(check (= 69 (ui-field (ui-field large-observation "state") "dropped_count")) "Overflow count incorrect")
(notifications-publish! large-observation
  #:command (lambda (expression)
              (check (< (bytevector-length (string->utf8 (object->string expression))) 122880) "Bounded preview exceeds publication budget") "((status . ok))"))
(check (fails? (lambda () (notifications-observation (wire (change snapshot 'revision -1)) 0))) "Invalid revision accepted")
(check (fails? (lambda () (notifications-observation (wire (change snapshot 'active (vector (change record 'transient "false")))) 0))) "Malformed transient flag accepted")
(define sockets (socketpair AF_UNIX SOCK_STREAM 0))
(define read-frame (notification-reader (car sockets)))
((@ (guile) send) (cdr sockets) (string->utf8 "{\"type\":"))
(check (not (read-frame)) "Fragmented frame parsed prematurely")
((@ (guile) send) (cdr sockets) (string->utf8 "\"state\"}\n"))
(check (equal? "state" (ui-field (read-frame) "type")) "Fragmented frame lost")
(close-port (car sockets)) (close-port (cdr sockets))
(set! model (make-notifications-ui))
(feed `((type . "state") (snapshot . ,snapshot)))
(define old-key (resolved "1-action-0"))
(define old-global (resolved "clear-all"))
(feed `((type . "state") (snapshot . ,(change snapshot 'revision 6))))
(check (not (equal? old-key (resolved "1-action-0"))) "Replacement retained action capture key")
(check (not (equal? old-global (resolved "clear-all"))) "Backend revision retained global mutation capture key")
(define prior (length sent)) (notifications-activate! model old-key send)
(check (= prior (length sent)) "Retired pressed command key executed against fresh state")
(define before-restart (resolved "clear-all"))
(feed `((type . "state") (snapshot . ,(change snapshot 'epoch "new-epoch"))))
(check (not (equal? before-restart (resolved "clear-all"))) "Server restart retained global capture key")
(display "Notifications UI tests passed\n")
(set! model (make-notifications-ui))
(set! sent '())
(define automatic (change (change snapshot 'fullscreen #t) 'fullscreen_automatic #t))
(feed `((type . "state") (snapshot . ,automatic)))
(check (string-contains (scm->json-string (nodes)) "Manual pause off") "Automatic suppression incorrectly changed manual toggle")
(check (string-contains (scm->json-string (nodes)) "Automatic: On") "Automatic fullscreen state missing")
(click "fullscreen")
(check (eq? #t (ui-field (ui-field (car sent) "command") "value")) "Manual toggle tried to disable automatic suppression")
(define manual-auto (change (change automatic 'revision 6) 'fullscreen_manual #t))
(feed `((request_id . 1) (status . "ok") (snapshot . ,manual-auto)))
(click "fullscreen")
(check (eq? #f (ui-field (ui-field (car sent) "command") "value")) "Manual suppression cannot be disabled independently")
(feed `((request_id . 2) (status . "ok") (snapshot . ,(change automatic 'revision 7))))
(check (string-contains (scm->json-string (nodes)) "Fullscreen suppression: On") "Removing manual pause disabled automatic suppression")
(define old-fullscreen (resolved "fullscreen"))
(define source-failure (change (change (change automatic 'revision 8) 'fullscreen_source "unavailable") 'fullscreen_error "SECRET_BACKEND_DIAGNOSTIC"))
(feed `((type . "state") (snapshot . ,source-failure)))
(define sent-before (length sent))
(notifications-activate! model old-fullscreen send)
(check (= sent-before (length sent)) "Fullscreen source change retained actionable old key before redraw")
(check (string-contains (scm->json-string (nodes)) "safe fallback") "Unknown source presented as actual fullscreen")
(check (not (string-contains (scm->json-string (nodes)) "SECRET_BACKEND_DIAGNOSTIC")) "Raw source error leaked to UI")
(define failure-observation (notifications-observation (wire source-failure) 123))
(check (not (string-contains (scm->json-string failure-observation) "SECRET_BACKEND_DIAGNOSTIC")) "Raw source diagnostic entered durable export")
(notifications-publish! failure-observation #:command (lambda (expression)
  (check (string-contains expression "safe suppression enabled") "Source failure missing readable diagnostic") "((status . ok))"))
(feed `((type . "state") (snapshot . ,(change snapshot 'revision 9))))
(check (string-contains (scm->json-string (nodes)) "Fullscreen suppression: Off") "Source recovery failed to clear automatic suppression")
(check (string-contains (scm->json-string (nodes)) "Hyprland connected") "Recovered source still unavailable")
(for-each (lambda (bad)
  (check (fails? (lambda () (notifications-observation (wire bad) 0))) "Inconsistent fullscreen snapshot accepted"))
  (list (change snapshot 'fullscreen #t)
        (change automatic 'fullscreen_source "disabled")
        (change snapshot 'fullscreen_source "unavailable")
        (change snapshot 'fullscreen_error "unexpected")
        (change source-failure 'fullscreen_error (make-string 513 #\x))
        (change (change source-failure 'fullscreen_automatic #f) 'fullscreen #f)))
(display "Notifications fullscreen tests passed\n")
