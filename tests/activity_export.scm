(use-modules (activity) (ice-9 match) (json) (srfi srfi-1) (srfi srfi-13))

(define (check value message)
  (unless value (error message)))

(define module (resolve-module '(activity)))
(define query (module-ref module 'query))
(define (reply value)
  (object->string `((status . ok) (value . ,(object->string value)) (truncated . #f))))
(define (ok value) `((ok . #t) (value . ,value)))
(define (diagnostic provider operation target)
  `((provider . ,provider) (operation . ,operation) (target . ,target)
    (kind . system-error) (message . "In procedure readlink:\nPermission denied\n")))
(define session
  '((id . "codex:known") (provider . codex) (status . active)
    (pid . 123) (tty . #f) (delivery . "codex-send")))
(define raw
  `((generation . "trusted")
    (sessions . ,(ok `((sessions . (,session))
                      (warnings . (,(diagnostic 'process 'inspect "123")
                                   ,(diagnostic 'process 'inspect "456")
                                   ,(diagnostic 'codex 'scan "registry")
                                   ,(diagnostic 'process 'scan "/proc"))))))
    (emacs-sessions . ,(ok '()))
    (layout . ,(ok "{\"buffers\":[]}"))
    (watches . ,(ok '()))
    (notices . ,(ok '()))))

(define owner-fails? #f)
(define owner-generation? #t)
(define mock-calls 0)
(define (mock-command . arguments)
  (set! mock-calls (+ mock-calls 1))
  (match arguments
    (("eval" expression)
     (check (string-contains expression "status pid tty") "Session query must request pid")
     (reply raw))
    (("owner" "view")
     (if owner-fails?
         (error "Permission denied" 'broker '((private . "must-not-render")))
         (if owner-generation? "{\"generation\":\"broker-generation\",\"effects\":[]}" "{\"effects\":[]}")))
    (_ (error "Unexpected mock command" arguments))))

(let ()
    (let* ((result (hearth-activity #:command mock-command))
           (warnings (vector->list (assq-ref result 'warnings))))
      (check (equal? "broker-generation" (assq-ref result 'effects_generation)) "Use broker generation from the same effects reply")
      (check (= 3 (length warnings)) "Keep relevant PID and provider discovery failures")
      (check (any (lambda (text) (string-contains text "Process 123")) warnings) "Relevant PID warning missing")
      (check (not (any (lambda (text) (string-contains text "456")) warnings)) "Unrelated process warning leaked")
      (check (any (lambda (text) (string-contains text "Codex registry")) warnings) "Provider scan failure missing")
      (check (any (lambda (text) (string-contains text "Process /proc")) warnings) "Process discovery failure missing")
      (check (every (lambda (text) (and (not (string-contains text "(("))
                                       (not (string-contains text "\n")))) warnings)
             "Diagnostics must be readable single lines")
      (check (eq? 'null (assq-ref (vector-ref (assq-ref result 'sessions) 0) 'host))
             "Unknown host must remain null"))
    (set! owner-fails? #t)
    (let* ((result (hearth-activity #:command mock-command))
           (warnings (vector->list (assq-ref result 'warnings)))
           (owner (find (lambda (text) (string-prefix? "Owner effects unavailable:" text)) warnings)))
      (check owner "Owner inspection failure missing")
      (check (string-contains owner "Permission denied") "Useful exception message missing")
      (check (not (string-contains owner "must-not-render")) "Nested exception data leaked")
      (check (eq? 'null (assq-ref result 'effects_generation)) "Failed owner source must stay unknown")))

(check (= 4 mock-calls) "Every export command must use the injected runner")

(set! owner-fails? #f) (set! owner-generation? #f)
(let* ((result (hearth-activity #:command mock-command))
       (warnings (vector->list (assq-ref result 'warnings))))
  (check (eq? 'null (assq-ref result 'effects_generation)) "Old owner views must disable controls")
  (check (= 0 (vector-length (assq-ref result 'effects))) "Unguarded owner effects must not be exposed")
  (check (any (lambda (warning) (string-contains warning "lacks broker generation")) warnings)
         "Old deployment needs an explicit compatibility diagnostic"))

(define capture
  (eval `(letrec ,(cadr query) capture) (current-module)))
(let* ((entry (capture (lambda () (error "Inspection denied" 'host '((private . "omitted"))))))
       (summary ((module-ref module 'error-summary) (assq-ref entry 'error))))
  (check (not (assq-ref entry 'ok)) "Capture should report failure")
  (check (string-contains summary "Inspection denied") "Source exception lost its message")
  (check (not (string-contains summary "private")) "Source exception leaked an alist"))
(display "Activity exporter tests passed\n")
