(use-modules (notifications-ui) (json) (srfi srfi-1))
(define (change object key value) (acons key value (alist-delete key object)))
(define record
 '((id . 1) (revision . 1) (app_name . "Mail") (summary . "An evening in the woods")
   (body . "The trail map is ready. Meet at the old oak before sunset.")
   (actions . #(((key . "open") (label . "Open")) ((key . "reply") (label . "Reply"))
                 ((key . "archive") (label . "Archive"))))
   (urgency . 1) (resident . #f) (transient . #f) (app_icon . "mail") (image_path . null)
   (image . ((width . 2) (height . 2) (rgba . #(92 126 75 255 182 151 98 255 57 84 53 255 220 190 130 255))))
   (desktop_entry . null) (category . null) (popup . #t) (actionable . #t) (closed_reason . null) (created_at_ms . 1234)))
(set! record (change record 'image
 `((width . 64) (height . 64)
   (rgba . ,(list->vector (append-map (lambda (i)
     (let ((x (modulo i 64)) (y (quotient i 64)))
       (cond ((< y 24) '(182 151 98 255))
             ((< (abs (- x 32)) (- y 16)) '(57 100 53 255))
             (else '(92 126 75 255))))) (iota 4096)))))))
(define records
 (list->vector (map (lambda (id)
   (change (change (change record 'id id) 'popup (= id 1)) 'summary
     (list-ref '("An evening in the woods" "Build finished" "Calendar reminder" "A fourth message") (- id 1)))) '(1 2 3 4))))
(define history
 (vector (change (change (change (change record 'id 5) 'actionable #f) 'popup #f) 'closed_reason 2)))
(define snapshot `((epoch . "fixture") (revision . 5) (dnd . #f) (fullscreen . #f)
                  (fullscreen_manual . #f) (fullscreen_automatic . #f) (fullscreen_source . "available") (fullscreen_error . null)
                  (active . ,records) (history . ,history)))
(define model (make-notifications-ui))
(define (feed value)
 (notifications-message! model (json-string->scm (scm->json-string `((type . "state") (snapshot . ,value))))))
(feed snapshot)
(define name (cadr (command-line)))
(when (equal? name "notifications-history")
 (notifications-nodes model)
 (notifications-activate! model "history" (lambda _ #t)))
(when (equal? name "notifications-dnd")
 (feed (change (change snapshot 'dnd #t) 'active
   (list->vector (map (lambda (item) (change item 'popup #f)) (vector->list records)))))
 (notifications-nodes model)
 (notifications-activate! model "popups" (lambda _ #t)))
(when (equal? name "notifications-fullscreen")
 (feed (change (change (change snapshot 'fullscreen #t) 'fullscreen_automatic #t) 'active
   (list->vector (map (lambda (item) (change item 'popup #f)) (vector->list records)))))
 (notifications-nodes model)
 (notifications-activate! model "popups" (lambda _ #t)))
(scm->json `((nodes . ,(notifications-nodes model)) (data . ,(notifications-data model))))
(newline)
