(use-modules (ui) (json) (ice-9 threads) (rnrs bytevectors) (srfi srfi-1))

(define (require value message) (unless value (error message)))
(define (now-us) (quotient (* (get-internal-real-time) 1000000) internal-time-units-per-second))
(define (epoch-now) (let ((time (gettimeofday))) (+ (* (car time) 1000000) (cdr time))))
(define args (cdr (command-line)))
(require (>= (length args) 2) "Usage: channel_latency.scm SOCKET CHANNEL [SAMPLES>=200] [SOAK-SECONDS>=60]")
(define socket-path (car args))
(define channel (cadr args))
(define samples (if (> (length args) 2) (string->number (list-ref args 2)) 200))
(define soak-seconds (if (> (length args) 3) (string->number (list-ref args 3)) 60))
(require (and (integer? samples) (>= samples 200)) "Need at least 200 latency samples per size")
(require (and (integer? soak-seconds) (>= soak-seconds 60)) "Need at least 60 soak seconds")
(require (< (string-length channel) 100) "Benchmark channel name is too long")

(define (node serial)
  `((key . "latency-node") (kind . "rect") (bounds . #(20 20 80 40))
    (color . ,(vector (if (even? serial) 0.25 0.75) 0.4 0.6 1))
    (transitions . ((color . 0) (offset . 0)))))
(define (send! peer message) (ui-write-json! (vector-ref peer 0) message))
(define (receive peer) (ui-read-json (vector-ref peer 1) 2))
(define (reject-check message)
  (when (and message (equal? (ui-field message "type") "ack")
             (equal? (ui-field message "status") "rejected"))
    (error "Renderer rejected benchmark message" message)))
(define (await peer type seq)
  (let ((deadline (+ (now-us) 5000000)))
    (let loop ()
      (require (< (now-us) deadline) "Renderer receipt timed out")
      (let ((message (receive peer)))
        (reject-check message)
        (if (and message (equal? (ui-field message "type") type)
                 (equal? (ui-field message "seq") seq)) message (loop))))))
(define (connect-peer name visible?)
  (let* ((port (socket AF_UNIX SOCK_STREAM 0))
         (epoch (epoch-now)))
    (connect port AF_UNIX socket-path)
    (let ((peer (vector port (ui-reader port) name epoch 1)))
      (send! peer '((type . "hello") (major . 2) (capabilities . #("patch" "presented" "inspect"))))
      (let ((hello (receive peer)))
        (require (and hello (= (ui-field hello "major") 2)) "Missing v2 hello"))
      (send! peer `((type . "baseline") (channel . ,name) (epoch . ,epoch) (seq . 1)
                    (nodes . ,(if visible? (vector (node 1)) #())) (data . ((serial . 0)))))
      (await peer "ack" 1)
      (when visible? (await peer "presented" 1))
      peer)))
(define (patch peer seq visible? data)
  `((type . "patch") (channel . ,(vector-ref peer 2)) (epoch . ,(vector-ref peer 3))
    (seq . ,seq) (upsert . ,(if visible? (vector (node seq)) #()))
    (remove . #()) (data . ,data)))
(define (statistics values)
  (let* ((ordered (sort values <)) (count (length ordered))
         (quantile (lambda (fraction) (list-ref ordered (min (- count 1) (- (inexact->exact (ceiling (* fraction count))) 1))))))
    `((samples . ,count) (p50 . ,(quantile 0.50)) (p99 . ,(quantile 0.99))
      (min . ,(car ordered)) (max . ,(last ordered)))))
(define (report value) (display (scm->json-string value)) (newline) (force-output))
(define ui (connect-peer channel #t))

(for-each
 (lambda (target)
   (let* ((next-seq (+ 1 (vector-ref ui 4)))
          (overhead (bytevector-length (string->utf8 (scm->json-string (patch ui next-seq #t '((padding . "")))))))
          (payload-target (if (= target 1048576) (- target 2048) target))
          (padding (make-string (max 0 (- payload-target overhead)) #\x))
          (estimated (patch ui (+ 1 (vector-ref ui 4)) #t `((padding . ,padding))))
          (bytes (bytevector-length (string->utf8 (scm->json-string estimated))))
          (latencies '()) (ack-latencies '()) (validation '()) (renderer-latencies '()))
     (do ((sample 0 (+ sample 1))) ((= sample samples))
       (let* ((started (now-us)) (seq (+ 1 (vector-ref ui 4)))
              (message (patch ui seq #t `((padding . ,padding)))))
         (vector-set! ui 4 seq)
         (send! ui message)
         (await ui "ack" seq)
         (set! ack-latencies (cons (/ (- (now-us) started) 1000.0) ack-latencies))
         (let ((receipt (await ui "presented" seq)))
           (set! latencies (cons (/ (- (now-us) started) 1000.0) latencies))
           (set! validation (cons (/ (ui-field receipt "validation_us") 1000.0) validation))
           (set! renderer-latencies (cons (ui-field receipt "change_to_presented_ms") renderer-latencies)))))
     (report `((test . "latency") (target_bytes . ,target) (actual_json_bytes . ,bytes)
               (receipt . "GPU submit; not physical scanout")
               (scheme_change_to_submit_ms . ,(statistics latencies))
               (scheme_change_to_applied_ms . ,(statistics ack-latencies))
               (decode_validate_ms . ,(statistics validation))
               (renderer_receive_to_submit_ms . ,(statistics renderer-latencies))))))
 '(4096 65536 1048576))

(define peers (list ui (connect-peer (string-append channel "-service-a") #f)
                      (connect-peer (string-append channel "-service-b") #f)))
(define lock (make-mutex))
(define done? #f)
(define failure #f)
(define acknowledgments (make-hash-table))
(define receipts (make-hash-table))
(define inspections (make-hash-table))
(define received-count 0)
(define readers
  (map
   (lambda (peer)
     (call-with-new-thread
      (lambda ()
        (catch #t
          (lambda ()
            (let loop ()
              (unless (with-mutex lock done?)
                (let ((message (receive peer)))
                  (when message
                    (reject-check message)
                    (with-mutex lock
                      (set! received-count (+ received-count 1))
                      (let ((name (ui-field message "channel")) (seq (ui-field message "seq")))
                        (cond
                         ((equal? (ui-field message "type") "ack") (hash-set! acknowledgments name seq))
                         ((equal? (ui-field message "type") "presented") (hash-set! receipts name seq))
                         ((equal? (ui-field message "type") "inspect") (hash-set! inspections name message)))))))
                (loop))))
          (lambda (key . arguments)
            (with-mutex lock (unless done? (set! failure (cons key arguments))))))))) peers))
(define ticks (* soak-seconds 60))
(define started (now-us))
(define missed-deadlines 0)
(do ((tick 1 (+ tick 1))) ((> tick ticks))
  (let* ((deadline (+ started (quotient (* (- tick 1) 1000000) 60))) (left (- deadline (now-us))))
    (if (> left 0) (usleep left) (when (< left -16667) (set! missed-deadlines (+ missed-deadlines 1)))))
  (with-mutex lock (when failure (error "Soak reader failed" failure)))
  (for-each
   (lambda (peer)
     (let ((seq (+ 1 (vector-ref peer 4))))
       (vector-set! peer 4 seq)
       (send! peer (patch peer seq (eq? peer ui) `((serial . ,tick) (padding . ,(make-string 1024 #\x))))))) peers))
(define elapsed-ms (/ (- (now-us) started) 1000.0))
(for-each (lambda (peer) (send! peer `((type . "inspect") (channel . ,(vector-ref peer 2)) (request_id . "soak-final")))) peers)
(define final-ok?
  (let ((deadline (+ (now-us) 5000000)))
    (let loop ()
      (let ((ready
             (with-mutex lock
               (when failure (error "Soak reader failed" failure))
               (and
                (every (lambda (peer)
                         (let* ((name (vector-ref peer 2)) (expected (vector-ref peer 4))
                                (response (hash-ref inspections name #f)))
                           (and response (= expected (ui-field response "seq"))
                                (= ticks (ui-field (ui-field response "data") "serial"))
                                (= expected (hash-ref acknowledgments name -1))))) peers)
                (= (vector-ref ui 4) (hash-ref receipts channel -1))))))
        (cond (ready #t) ((>= (now-us) deadline) #f) (else (usleep 1000) (loop)))))))
(with-mutex lock (set! done? #t))
(for-each (lambda (peer) (shutdown (vector-ref peer 0) 2)) peers)
(for-each join-thread readers)
(for-each (lambda (peer) (close-port (vector-ref peer 0))) peers)
(report `((test . "soak") (channels . 3) (target_hz_per_channel . 60) (seconds . ,soak-seconds)
          (updates_per_channel . ,ticks) (elapsed_ms . ,elapsed-ms) (missed_sender_deadlines . ,missed-deadlines)
          (received_messages . ,received-count) (final_states_and_ui_receipt_match . ,final-ok?)))
(require final-ok? "Soak dropped a final channel state or final UI submission receipt")
